<section class="panel workflow-timeline" aria-labelledby="workflow-timeline-title"><div class="panel-heading"><h2 id="workflow-timeline-title">Activity timeline</h2><a class="button quiet" href="<%= workflowRecordUrl(resource,record.id,returnTo) %>">Refresh status</a></div><p class="form-help">Notes, follow-up changes and email replies. “Sent” means the email service accepted the reply; inbox delivery is not confirmed.</p>
<ol><% timeline.forEach(event=>{ %><li class="timeline-event event-<%= event.kind %>"><div class="timeline-event-heading"><strong><%= event.title %></strong><% if(event.delivery){ %><span class="badge badge-<%= event.delivery==='pending'?'queued':event.delivery %>"><%= ({pending:'Queued',sending:'Sending',sent:'Sent',failed:'Failed',cancelled:'Cancelled'})[event.delivery]||event.delivery %></span><% } %></div><small><%= event.actor %> · <time datetime="<%= String(event.date).replace(' ','T') %>Z"><%= event.date %> UTC</time></small><% if(event.changes?.length){ %><ul><% event.changes.forEach(change=>{ %><li><%= change %></li><% }); %></ul><% } %><% if(event.body){ %><p class="pre-line"><%= event.body %></p><% } %><% if(event.sentAt){ %><small>Accepted by email service <%= event.sentAt %> UTC</small><% } %><% if(event.delivery==='failed'){ %><p class="workflow-delivery-failed">Delivery failed. Open Reply by email to review the delivery details.</p><% } %></li><% }); %></ol></section>
