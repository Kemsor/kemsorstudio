<%- include('head') %>
<p class="eyebrow">OPERATIONAL RECORDS</p><h1>Activity log.</h1>
<p>Search recorded actions across the workspace. Dates and times are UTC. Passwords, private messages and full content bodies are not copied into this log.</p>
<form method="get" action="/admin/audit" class="filters audit-filters">
<label>Search<input type="search" name="q" maxlength="100" value="<%= filters.q %>" placeholder="Staff, action, record ID or recorded changes"></label>
<label>Staff member<select name="actor" aria-label="Staff member"><option value="">All staff and other actors</option><option value="system" <%= filters.actor==='system'?'selected':'' %>>No recorded staff member</option><% staff.forEach(person=>{ %><option value="<%= person.id %>" <%= filters.actor===String(person.id)?'selected':'' %>><%= person.name %><%= person.active?'':' (disabled)' %></option><% }) %></select></label>
<label>Action<select name="action" aria-label="Action"><option value="">All actions</option><% actions.forEach(action=>{ %><option value="<%= action %>" <%= filters.action===action?'selected':'' %>><%= action.replaceAll('_',' ') %></option><% }) %></select></label>
<label>Module<select name="module" aria-label="Module"><option value="">All modules</option><% modules.forEach(module=>{ %><option value="<%= module %>" <%= filters.module===module?'selected':'' %>><%= module.replaceAll('_',' ') %></option><% }) %></select></label>
<label>From<input type="date" name="from" value="<%= filters.from %>"></label><label>To<input type="date" name="to" value="<%= filters.to %>"></label>
<label>Rows<select name="per_page" aria-label="Rows"><% [25,50,100].forEach(value=>{ %><option value="<%= value %>" <%= table.limit===value?'selected':'' %>><%= value %></option><% }) %></select></label>
<button class="admin-standard-action">Apply filters</button><a class="button quiet" href="/admin/audit">Clear filters</a>
</form>
<p role="status"><%= table.total %> matching <%= table.total===1?'event':'events' %>.</p>
<% if(Object.values(filters).some(Boolean)){ %><nav class="admin-active-filters" aria-label="Active activity filters"><% Object.entries(filters).filter(([,value])=>value).forEach(([key,value])=>{ const labels={q:'Search',actor:'Staff member',action:'Action',module:'Module',from:'From',to:'To'}; const display=key==='actor'?(staff.find(person=>String(person.id)===value)?.name||(value==='system'?'No recorded staff member':value)):value; %><a href="<%= table.link({[key]:'',p:1}) %>" aria-label="Remove <%= labels[key] %> filter: <%= display %>"><%= labels[key] %>: <%= display %> ×</a><% }) %></nav><% } %>
<div class="table-wrap audit-table" role="region" aria-label="Recorded activity" tabindex="0"><table><thead><tr><th scope="col">When (UTC)</th><th scope="col">Staff / actor</th><th scope="col">Action</th><th scope="col">Record</th><th scope="col">Recorded changes</th></tr></thead><tbody>
<% events.forEach(event=>{ %><tr><td><time><%= event.created_at %></time><small>Event #<%= event.id %></small></td><td><%= event.actor %></td><td><%= event.actionLabel %><small><%= event.action %></small></td><td><% if(event.href){ %><a class="text-link" href="<%= event.href %>"><%= event.recordTitle %></a><% }else{ %><%= event.recordTitle %><% } %><small><%= event.target_type %> / <%= event.target_id %></small><% if(event.historyUrl){ %><a class="text-link" href="<%= event.historyUrl %>">Saved revisions</a><% } %></td><td>
<% if(event.changes.length){ %><details class="audit-change-details"><summary><%= event.changes.length %> recorded <%= event.changes.length===1?'change':'changes' %></summary><ul><% event.changes.forEach(change=>{ %><li><strong><%= change.field %></strong><% if(change.hasValues){ %><span><%= change.before %> → <%= change.after %></span><% }else{ %><span>Updated; text is not copied into the log.</span><% } %></li><% }) %></ul></details><% }else if(event.hasChangeDetails){ %><span class="audit-no-details">No field changes.</span><% }else{ %><span class="audit-no-details">Field changes were not recorded for this event.</span><% } %>
</td></tr><% }) %>
<% if(!events.length){ %><tr><td colspan="5"><h2>No matching activity.</h2><p>Try a different search or date range, or <a class="text-link" href="/admin/audit">clear the filters</a>.</p></td></tr><% } %>
</tbody></table></div>
<%- include('table-pagination',{table}) %>
<p>“No recorded staff member” includes member activity, automated work and events whose staff account is no longer available. Record links open current records; deleted records and their saved revisions may no longer be available.</p>
<%- include('foot') %>
