<%- include('head') %><p class="eyebrow">OPERATIONAL RECORDS</p><h1>Activity log.</h1><p>Latest 200 actions. Content and private enquiry messages are not copied into this log.</p><div class="table-wrap"><table><thead><tr><th>When</th><th>User</th><th>Action</th><th>Record</th></tr></thead><tbody><% events.forEach(event=>{ %><tr><td><%= event.created_at %></td><td><%= event.name || (event.target_type==='talent'?'Talent member':'Former user') %></td><td><%= event.action %></td><td><%= event.target_type %> / <%= event.target_id %></td></tr><% }) %></tbody></table></div><%- include('foot') %>