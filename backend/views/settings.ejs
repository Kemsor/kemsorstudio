<%- include('head') %><p class="eyebrow">CONFIGURATION</p><h1>Site settings.</h1><p class="form-help">Open a section to update its settings, then save your changes below.</p><form class="panel settings-editor" action="/admin/settings" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><details class="settings-group" open><summary><span>Contact details</span><small>Email, phone numbers, website and studio address</small></summary><div class="settings-group-content"><p class="form-help">Published in the footer, Contact page and newsroom contacts. Use the fields below to distinguish calls from WhatsApp.</p><div class="field-grid"><label>Email<input type="email" name="contact_email" value="<%= settings.contact_email || '' %>" maxlength="254" autocomplete="off"></label><label>Mobile (calls only)<input type="tel" name="contact_phone" value="<%= settings.contact_phone || '' %>" maxlength="40"></label><label>Landline<input type="tel" name="contact_landline" value="<%= settings.contact_landline ?? '' %>" maxlength="40"></label><label>Mobile (WhatsApp only)<input type="tel" name="contact_whatsapp" value="<%= settings.contact_whatsapp ?? '' %>" maxlength="40"><small>Opens WhatsApp instead of placing a call.</small></label><label>Official website<input type="url" name="contact_website" value="<%= settings.contact_website ?? '' %>" maxlength="500" placeholder="https://www.kemsorstudios.com"></label><label class="wide">Studio address<textarea name="contact_address" rows="3" maxlength="1000"><%= settings.contact_address || '' %></textarea></label><label class="wide">Contact note<input name="contact_note" value="<%= settings.contact_note || '' %>" maxlength="300"><small>Optional additional information for visitors.</small></label></div></div></details>
<details class="settings-group"><summary><span>Location map</span><small>Map location and caption</small></summary><div class="settings-group-content"><div class="field-grid"><label>Map location<input name="map_location" value="<%= settings.map_location || '' %>" maxlength="300" placeholder="Street address or latitude, longitude"><small>Enter a location, not iframe code. Leave blank to hide the map.</small></label><label>Map caption<input name="map_caption" value="<%= settings.map_caption || '' %>" maxlength="300"></label></div></div></details>
<details class="settings-group"><summary><span>Footer content</span><small>Headings, supporting text and contact button</small></summary><div class="settings-group-content"><div class="field-grid"><% [['footer_kicker','Small heading',100],['footer_title','Main heading',100],['footer_accent','Highlighted heading line',100],['footer_cta_label','Contact button label',60],['footer_copyright','Copyright name',150],['footer_social_label','Social icons label',60]].forEach(([key,label,max])=>{ %><label><%= label %><input name="<%= key %>" value="<%= settings[key] ?? '' %>" maxlength="<%= max %>"></label><% }); %><label class="wide">Supporting text<textarea name="footer_description" rows="3" maxlength="1000"><%= settings.footer_description || '' %></textarea><small>Line breaks are supported.</small></label></div></div></details>
<details class="settings-group"><summary><span>Official social profiles</span><small>Facebook, Instagram, YouTube and LinkedIn</small></summary><div class="settings-group-content"><div class="field-grid"><% ['facebook','instagram','youtube','linkedin'].forEach(key=>{ %><label><%= key %><input type="url" name="<%= key %>" value="<%= settings[key] || '' %>" maxlength="500" placeholder="https://..."></label><% }) %></div></div></details><details class="settings-group"><summary><span>Approved script submission terms</span><small>Approved terms, version and upload availability</small></summary><div class="settings-group-content"><p>Leave uploads disabled until Kemsor/legal counsel approves the terms.</p><label>Approved terms<textarea name="script_terms" rows="8" maxlength="12000"><%= settings.script_terms || '' %></textarea></label><label>Terms version<input name="script_terms_version" maxlength="100" value="<%= settings.script_terms_version || '' %>"></label><label><input type="checkbox" name="script_submissions_enabled" <%= settings.script_submissions_enabled?'checked':'' %>>Enable uploads using these approved terms</label></div></details><details class="settings-group"><summary><span>Structured enquiries</span><small>Privacy notice, enquiry availability and attachments</small></summary><div class="settings-group-content"><label>Approved privacy notice<textarea name="privacy_notice" rows="5" maxlength="4000"><%= settings.privacy_notice || '' %></textarea></label><label>Notice version<input name="consent_version" value="<%= settings.consent_version || '' %>" maxlength="100" placeholder="e.g. 2026-10-approved-v1"></label><label class="check"><input type="checkbox" name="enquiries_enabled" <%= settings.enquiries_enabled?'checked':'' %>>Enable public enquiries using the approved notice</label><label class="check"><input type="checkbox" name="attachments_enabled" <%= settings.attachments_enabled?'checked':'' %>>Enable optional enquiry attachments (PDF or images, up to 5 MB)</label><p class="muted">Attachments are private and only available to enquiry staff. Agree scanning and retention controls before production launch. Enquiries are recorded in the CMS. Confirmation emails use the email service configured for this environment.</p></div></details><div class="settings-save-bar"><span>Save changes across all sections.</span><button class="admin-save">Save settings</button></div></form><p><a class="button quiet" href="/admin/email">Check confirmation email delivery</a></p><%- include('foot') %>