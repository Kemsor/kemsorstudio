<%- include('head') %><p class="eyebrow">CONFIGURATION</p><h1>Site settings.</h1><form class="panel" action="/admin/settings" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Official social profiles</h2><div class="field-grid"><% ['facebook','instagram','youtube'].forEach(key=>{ %><label><%= key %><input type="url" name="<%= key %>" value="<%= settings[key] || '' %>" maxlength="500" placeholder="https://..."></label><% }) %></div><h2>Structured enquiries</h2><label>Approved privacy notice<textarea name="privacy_notice" rows="5" maxlength="4000"><%= settings.privacy_notice || '' %></textarea></label><label>Notice version<input name="consent_version" value="<%= settings.consent_version || '' %>" maxlength="100" placeholder="e.g. 2026-10-approved-v1"></label><label class="check"><input type="checkbox" name="enquiries_enabled" <%= settings.enquiries_enabled?'checked':'' %>>Enable public enquiries using the approved notice</label><label class="check"><input type="checkbox" name="attachments_enabled" <%= settings.attachments_enabled?'checked':'' %>>Enable optional enquiry attachments (PDF or images, up to 5 MB)</label><p class="muted">Attachments are private and only available to enquiry staff. Agree scanning and retention controls before production launch. Enquiries are recorded in the CMS; no email delivery service is configured.</p><button>Save settings</button></form><%- include('foot') %>