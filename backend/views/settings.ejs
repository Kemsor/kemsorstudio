<%- include('head') %><p class="eyebrow">CONFIGURATION</p><h1>Site settings.</h1><form class="panel" action="/admin/settings" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><section class="settings-section"><h2>Contact details</h2><p class="form-help">Shown beside the general enquiry form. Replace the sample details here when ready.</p><div class="field-grid"><label>Email<input type="email" name="contact_email" value="<%= settings.contact_email || '' %>" maxlength="254" autocomplete="off"></label><label>Phone<input type="tel" name="contact_phone" value="<%= settings.contact_phone || '' %>" maxlength="40"></label><label class="wide">Studio address<textarea name="contact_address" rows="3" maxlength="1000"><%= settings.contact_address || '' %></textarea></label><label class="wide">Contact note<input name="contact_note" value="<%= settings.contact_note || '' %>" maxlength="300"><small>Optional. Clear the sample label after entering official details.</small></label></div></section>
<section class="settings-section"><h2>Location map</h2><div class="field-grid"><label>Map location<input name="map_location" value="<%= settings.map_location || '' %>" maxlength="300" placeholder="Street address or latitude, longitude"><small>Enter a location, not iframe code. Leave blank to hide the map.</small></label><label>Map caption<input name="map_caption" value="<%= settings.map_caption || '' %>" maxlength="300"></label></div></section>
<section class="settings-section"><h2>Footer content</h2><div class="field-grid"><% [['footer_kicker','Small heading',100],['footer_title','Main heading',100],['footer_accent','Highlighted heading line',100],['footer_cta_label','Contact button label',60],['footer_copyright','Copyright name',150],['footer_social_label','Social icons label',60]].forEach(([key,label,max])=>{ %><label><%= label %><input name="<%= key %>" value="<%= settings[key] ?? '' %>" maxlength="<%= max %>"></label><% }); %><label class="wide">Supporting text<textarea name="footer_description" rows="3" maxlength="1000"><%= settings.footer_description || '' %></textarea><small>Line breaks are supported.</small></label></div></section>
<section class="settings-section"><h2>Official social profiles</h2><div class="field-grid"><% ['facebook','instagram','youtube','linkedin'].forEach(key=>{ %><label><%= key %><input type="url" name="<%= key %>" value="<%= settings[key] || '' %>" maxlength="500" placeholder="https://..."></label><% }) %></div></section><section class="settings-section"><h2>Structured enquiries</h2><label>Approved privacy notice<textarea name="privacy_notice" rows="5" maxlength="4000"><%= settings.privacy_notice || '' %></textarea></label><label>Notice version<input name="consent_version" value="<%= settings.consent_version || '' %>" maxlength="100" placeholder="e.g. 2026-10-approved-v1"></label><label class="check"><input type="checkbox" name="enquiries_enabled" <%= settings.enquiries_enabled?'checked':'' %>>Enable public enquiries using the approved notice</label><label class="check"><input type="checkbox" name="attachments_enabled" <%= settings.attachments_enabled?'checked':'' %>>Enable optional enquiry attachments (PDF or images, up to 5 MB)</label><p class="muted">Attachments are private and only available to enquiry staff. Agree scanning and retention controls before production launch. Enquiries are recorded in the CMS. Confirmation emails use the email service configured for this environment.</p></section><button>Save settings</button></form><p><a class="button quiet" href="/admin/email">Check confirmation email delivery</a></p><%- include('foot') %>