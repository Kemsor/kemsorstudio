<%- include('head') %><p class="eyebrow"><%= types[entry.type] %></p><h1><%= entry.type==='production' ? (entry.id?'Edit production':'Add production') : entry.type==='media_partner' ? (entry.id?'Edit media partner':'Add media partner') : (entry.id?'Edit content.':'A new studio update.') %></h1><% if(entry.type==='media_partner'){ %><p>Enter the partner name as the title and upload its logo below. Publish to show it in the news page slider; archive to remove it. Clear the category “sample” when replacing an example with a real partner.</p><% } %><form action="/admin/content/save" method="post" class="panel editor"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= entry.id || '' %>"><input type="hidden" name="type" value="<%= entry.type %>"><%- include('publishing-toolbar') %><% if(entry.type==='home'){ %><label>Homepage placement<select name="home_slot"><option value="section">Additional homepage section</option><option value="hero" <%= entry.metadata?.home_slot==='hero'||entry.slug==='home-hero'?'selected':'' %>>Hero heading and description</option></select><small>The latest published hero-copy entry supplies the default heading and description. Individual hero-slide text takes priority. Additional sections appear below the homepage content.</small></label><% } %><div class="field-grid"><label><%= entry.type==='production'?'Public production title':'Title' %><input name="title" value="<%= entry.title || '' %>" required maxlength="200"></label><label>Slug (automatic)<input data-auto-slug data-existing-slug="<%= entry.slug || '' %>" value="<%= entry.slug || '' %>" readonly placeholder="Generated from the title"><small><%= entry.id ? 'Kept unchanged to preserve existing links.' : 'Generated on save. Duplicate titles receive a number automatically.' %></small></label><label class="wide"><%= entry.type==='production'?'Logline / short summary':'Summary' %><textarea name="summary" rows="3" maxlength="2000"><%= entry.summary || '' %></textarea></label><label class="wide"><%= entry.type==='production'?'Synopsis':'Content' %><textarea data-rich-editor data-editor-label="Content" data-rich-document="<%= entry.metadata?.rich_text?JSON.stringify(entry.metadata.rich_text):'' %>" name="body" rows="12" maxlength="60000"><%= entry.body || '' %></textarea><small><%= entry.type==='production'?'Use the toolbar to format the approved production synopsis.':'Use the toolbar for headings, emphasis, lists and links. Page content adds a published section below the existing page layout; it does not replace fixed headings or images.' %></small></label><% if(entry.type==='production'){ %>
<section class="wide"><h2>Electronic press kit (EPK)</h2><label>EPK access<select name="epk_mode"><% [['public','Public'],['link_only','Private share links only'],['disabled','Disabled']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= (entry.metadata.epk_mode||'public')===value?'selected':'' %>><%= label %></option><% }) %></select></label><label>Structured kit<select name="epk_structured"><option value="no" <%= !entry.metadata.epk_structured?'selected':'' %>>Disabled</option><option value="yes" <%= entry.metadata.epk_structured?'selected':'' %>>Enabled</option></select><small>Includes synopsis, credits, selected published biographies, statements and production history. Visitors can view, print or download HTML.</small></label><label>Press-kit introduction<textarea name="epk_intro" maxlength="3000" rows="4"><%= entry.metadata.epk_intro||'' %></textarea></label><% if(entry.id){ %><p><a href="/admin/production-epks/<%= entry.id %>">Preview kit and manage private download links</a></p><% } %><label>Press kit PDF<input name="epk_url" data-document-upload maxlength="100" value="<%= entry.metadata.epk_url||'' %>" placeholder="Upload an approved PDF below"><small>PDF only, up to 10 MB. Upload a replacement, then save. Clear this field and save to remove the download button. Upload only approved press material.</small></label><% if(entry.metadata.epk_url){ %><a href="<%= entry.metadata.epk_url %>" target="_blank" rel="noopener">Preview current press kit PDF</a><% } %></section>
<%- include('production-gallery',{entry,media}) %>
<%- include('production-extensions',{entry,media}) %>
<label>Internal working title<input name="working_title" maxlength="200" value="<%= entry.metadata.working_title || '' %>"><small>For studio staff only. Not included in the public website feed.</small></label>
<label>Production status<select name="production_stage" required><% ['upcoming','in_development','in_pre_production','in_production','in_post_production','coming_soon','released'].forEach(value=>{ %><option value="<%= value %>" <%= entry.metadata.production_stage===value?'selected':'' %>><%= value.replaceAll('_',' ') %></option><% }) %></select><small>Separate from the draft, published or archived visibility below.</small></label>
<label>Format<input name="format" maxlength="100" list="production-formats" value="<%= entry.metadata.format || '' %>" placeholder="Feature film, series, documentary…"><datalist id="production-formats"><% ['Feature film','Series / OTT','Documentary','Short film','Other'].forEach(value=>{ %><option value="<%= value %>"><% }) %></datalist></label>
<label>Genres<input name="genres" maxlength="1000" value="<%= (entry.metadata.genres || []).join(', ') %>" placeholder="Drama, thriller"><small>Separate multiple genres with commas.</small></label>
<label>Languages<input name="language" maxlength="200" value="<%= entry.metadata.language || '' %>" placeholder="Hindi, English"><small>Separate multiple languages with commas.</small></label>
<label>Production year<input name="year" maxlength="4" pattern="[1-9][0-9]{3}" value="<%= entry.metadata.year || '' %>" placeholder="2026"></label>
<label>Release date<input type="date" name="release_date" value="<%= entry.metadata.release_date || '' %>"><small>Leave blank until a release date is approved.</small></label>
<% } %><% if(entry.type==='press_asset'){ %><label>Approved resource URL<input name="asset_url" data-document-upload maxlength="1000" required value="<%= entry.metadata.asset_url || '' %>" placeholder="https://… or /media/…"></label><label>Usage permission<input name="usage" maxlength="300" required value="<%= entry.metadata.usage || '' %>" placeholder="Editorial use only"></label><% } %><label>Category / label<input name="category" value="<%= entry.metadata.category || '' %>" maxlength="200"></label><label>Role / job title<input name="role" value="<%= entry.metadata.role || '' %>" maxlength="200"></label><label>Location<input name="location" value="<%= entry.metadata.location || '' %>" maxlength="200"></label><% if(['page','legal'].includes(entry.type)){ %><label>Page<select name="page"><option value="">Choose for page content</option><% contentPages.forEach(item=>{ %><option value="<%= item.key %>" <%= entry.metadata.page===item.key?'selected':'' %>><%= item.label %></option><% }); %></select></label><% } %><label>Image<select name="image_id"><option value="">No image</option><% media.forEach(image=>{ %><option data-media-alt="<%= image.alt %>" data-media-name="<%= image.original_name %>" value="<%= image.id %>" <%= entry.image_id===image.id?'selected':'' %>><%= image.original_name %> · <%= image.alt %></option><% }) %></select></label><% if(['page','production'].includes(entry.type)){ %><%- include('video-fields',{entry}) %><% } %><label>Publishing status<select name="status"><% ['draft','published','archived'].forEach(item=>{ %><option <%= entry.status===item?'selected':'' %>><%= item %></option><% }) %></select></label><% if(entry.type==='page'){ %><label>SEO title<input name="seo_title" value="<%= entry.metadata.seo_title || '' %>" maxlength="200"></label><label>SEO description<textarea name="seo_description" maxlength="300" rows="3"><%= entry.metadata.seo_description || '' %></textarea><small>For page/legal sections; published page metadata overrides the default.</small></label><% } %></div><div class="form-actions"><button class="admin-save quiet" name="publish_action" value="draft">Save draft</button><button name="publish_action" value="published">Publish content</button><% if(entry.id){ %><button class="admin-save quiet">Save selected status</button><% } %></div></form><p><a href="/admin/content?type=<%= entry.type %>">Back to content</a></p><%- include('foot') %>