<%- include('head') %><p class="eyebrow"><%= types[entry.type] %></p><h1><%= entry.id?'Edit content.':'A new studio update.' %></h1><form action="/admin/content/save" method="post" class="panel editor"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= entry.id || '' %>"><input type="hidden" name="type" value="<%= entry.type %>"><div class="field-grid"><label>Title<input name="title" value="<%= entry.title || '' %>" required maxlength="200"></label><label>Slug<input name="slug" value="<%= entry.slug || '' %>" required maxlength="190" pattern="[a-z0-9]+(-[a-z0-9]+)*"><small>Lowercase letters, numbers and hyphens. Homepage keys: home-hero, home-intro.</small></label><label class="wide">Summary<textarea name="summary" rows="3" maxlength="2000"><%= entry.summary || '' %></textarea></label><label class="wide">Content<textarea name="body" rows="12" maxlength="60000"><%= entry.body || '' %></textarea><small>Plain text. Separate paragraphs with a blank line; HTML is displayed as text.</small></label><label>Category / label<input name="category" value="<%= entry.metadata.category || '' %>" maxlength="200"></label><label>Role / job title<input name="role" value="<%= entry.metadata.role || '' %>" maxlength="200"></label><label>Location<input name="location" value="<%= entry.metadata.location || '' %>" maxlength="200"></label><label>Page<select name="page"><option value="">Choose for page/legal content</option><% ['home','about','services','projects','news','blog','careers','contact','legal'].forEach(item=>{ %><option <%= entry.metadata.page===item?'selected':'' %>><%= item %></option><% }) %></select></label><label>Image<select name="image_id"><option value="">No image</option><% media.forEach(image=>{ %><option value="<%= image.id %>" <%= entry.image_id===image.id?'selected':'' %>><%= image.original_name %> — <%= image.alt %></option><% }) %></select><small>Upload images in the image library first.</small></label><label>Publishing status<select name="status"><% ['draft','published','archived'].forEach(item=>{ %><option <%= entry.status===item?'selected':'' %>><%= item %></option><% }) %></select></label><label>SEO title<input name="seo_title" value="<%= entry.metadata.seo_title || '' %>" maxlength="200"></label><label>SEO description<textarea name="seo_description" maxlength="300" rows="3"><%= entry.metadata.seo_description || '' %></textarea><small>For page/legal sections; published page metadata overrides the default.</small></label></div><button>Save content →</button></form><p><a href="/admin/content?type=<%= entry.type %>">← Back to content</a></p><%- include('foot') %>