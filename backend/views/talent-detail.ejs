<%- include('head') %><p><a class="button quiet" href="/admin/talent?role=<%= account.role %>">Back to <%= account.role==='artist'?'artists & crew':'directors & producers' %></a></p><p class="eyebrow">Member details</p><% const a=account; %><section class="panel registration-card"><h2><%= a.name %> · <%= a.role==='artist'?'Artist':'Casting Director / Producer' %></h2><p>Registered <%= a.created_at %> UTC</p><p><%= a.email %> · <%= a.city %> · <%= a.profession || a.organisation %></p><p><%= a.bio %></p><p>Skills: <%= a.skills %> / Languages: <%= a.languages %></p><p>Credits: <%= a.credits %></p><p>Visibility: <%= a.visible ? 'Public after approval':'Private' %> · Status: <%= a.status %></p><% if(a.showreel){ %><a href="<%= a.showreel %>" target="_blank" rel="noopener noreferrer">Portfolio / showreel </a><% } %><% if(a.image_id){ %><img src="/media/<%= a.image_id %>" alt="Profile portrait" width="120" height="120"><% } %><form action="/admin/talent/<%= a.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="check"><input type="checkbox" name="contact_checked" <%= a.contact_checked?'checked':'' %>> Contact details checked by KEMSOR</label><label>Status<select name="status"><% ['pending','approved','suspended'].forEach(s=>{ %><option <%= a.status===s?'selected':'' %>><%= s %></option><% }); %></select></label><button>Save review</button></form></section><%- include('foot') %>