<section class="wide blog-categories" data-blog-categories><input type="hidden" name="categories_present" value="1"><div class="blog-category-heading"><h2><%= categoryType==='blog'?'Blog':'News' %> categories</h2><a class="button quiet" href="/admin/<%= categoryType %>-categories/manage" target="_blank" rel="noopener">Manage categories</a><button type="button" class="quiet" data-create-blog-category>Create category</button></div>
<% const savedCategories=typeof blogCategories!=='undefined'?blogCategories:[];const selectedCategories=savedCategories.filter(category=>category.selected); %>
<details class="blog-category-picker" data-blog-category-picker><summary><span data-blog-category-summary><%= selectedCategories.length?selectedCategories.map(category=>category.name).join(', '):'Select categories' %></span></summary><fieldset data-blog-category-list><legend class="visually-hidden">Saved blog categories</legend><% savedCategories.forEach(category=>{ %><label class="blog-category-option"><input type="checkbox" name="category_ids" value="<%= category.id %>" data-category-name="<%= category.name %>" <%= category.selected?'checked':'' %>><span><%= category.name %></span></label><% }) %><p data-blog-category-empty <%= savedCategories.length?'hidden':'' %>>No categories saved yet. Create your first category using the button above.</p></fieldset></details>
<p class="blog-category-help">Choose one or more saved categories. New categories are created in the popup.</p><p role="status" data-blog-category-status></p></section>
