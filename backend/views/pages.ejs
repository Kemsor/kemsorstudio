<%- include('head') %>
<div class="admin-pages-heading"><p class="eyebrow">Website management</p><h1>Website pages</h1><p>Choose the page or content area you want to manage. Use Existing page content to edit supplied copy, images, video sections and navigation. The publishing modules below manage listings and additional sections.</p></div>
<p><a class="button" href="/admin/site-content">Edit existing website content</a></p><div class="admin-page-grid">
<% const sections=[['Homepage','home','Homepage headings and promotional content','/admin/content?type=home'],['Leadership','team','Founder portrait, biography, screen work and honours','/admin/site-content/edit?key=leadership'],['About the studio','page','Published page sections','/admin/content?type=page&page=about'],['How We Work','page','Published page sections','/admin/content?type=page&page=how-we-work'],['India Production Services','page','Published page sections','/admin/content?type=page&page=india-production-services'],['Feature Films','page','Published page sections, trailers and video excerpts','/admin/content?type=page&page=feature-films'],['Short Films','page','Published page sections','/admin/content?type=page&page=short-films'],['Series & OTT','page','Published page sections, teasers and trailers','/admin/content?type=page&page=series-ott'],['Documentaries','page','Published page sections, trailers and excerpts','/admin/content?type=page&page=documentaries'],['Services','page','Published service page sections','/admin/content?type=page&page=services'],['Productions','production','Production announcements, posters and optional trailers','/admin/content?type=production'],['Press resources','press_asset','Approved company profiles and media download links','/admin/content?type=press_asset'],['Newsroom','news','Studio news and announcements','/admin/content?type=news'],['Blog','blog','Blog posts and banners','/admin/content?type=blog'],['Careers','career','Career opportunities','/admin/content?type=career'],['Team profiles','team','Leadership and studio team','/admin/content?type=team'],['Legal documents','legal','Policies, dates, versions and footer links','/admin/manage/legal'],['Media partners','media_partner','News page partner logos','/admin/content?type=media_partner']]; sections.filter(item=>user.role==='admin'||!item[3].startsWith('/admin/manage/')).forEach(([label,icon,description,href])=>{ %>
<a class="panel admin-page-card" href="<%= href %>"><span class="admin-page-icon"><%- include('icon',{name:icon}) %></span><h2><%= label %></h2><p><%= description %></p><span>Manage content</span></a><% }); %>
<% const alreadyListed=['home','about','leadership','how-we-work','india-production-services','feature-films','short-films','series-ott','documentaries','services','productions','press-media','blog','careers'];contentPages.filter(page=>!alreadyListed.includes(page.key)).forEach(page=>{ %><a class="panel admin-page-card" href="/admin/content?type=page&amp;page=<%= page.key %>"><h2><%= page.label %></h2><p>Additional published page sections and page metadata</p><span>Manage additional sections</span></a><% }); %>
<% if(user.role==='admin'){ %><a class="panel admin-page-card" href="/admin/manage/hero"><h2>Homepage hero slides</h2><p>Preserved video slides, posters, ordering, text and publishing</p><span>Manage slides</span></a><a class="panel admin-page-card" href="/admin/settings"><span class="admin-page-icon"><%- include('icon',{name:'settings'}) %></span><h2>Contact & site settings</h2><p>Enquiry availability, privacy notice and social links</p><span>Manage settings</span></a><% } %>
</div><%- include('foot') %>
