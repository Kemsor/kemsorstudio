<%- include('head') %>
<div class="admin-pages-heading">
  <h1>Manage pages</h1>
  <p>Choose a website page, then select the section you want to edit.</p>
</div>
<p><a href="/admin/site-content">All website areas</a><% if(user.role==='admin'){ %> · <a href="/admin/site-content/edit?key=navigation">Header &amp; footer navigation</a><% } %></p>
<% if(typeof groups!=='undefined'){ groups.forEach(group=>{ %>
  <section class="panel">
    <% if(group.label){ %><h2><%= group.label %></h2><% } %>
    <ul>
      <% group.pages.forEach(page=>{ %><li><a href="<%= page.href %>"><%= page.label %></a></li><% }); %>
    </ul>
  </section>
<% }); } %>
<%- include('foot') %>
