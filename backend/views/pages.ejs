<%- include('head') %>
<div class="admin-pages-heading"><p class="eyebrow">Website management</p><h1>Website pages</h1><p>Choose the page or content area you want to manage.</p></div>
<div class="admin-page-grid">
<% const sections=[['Homepage','home','Homepage headings and promotional content','/admin/content?type=home'],['About the studio','page','Published page sections','/admin/content?type=page&page=about'],['Services','page','Published service page sections','/admin/content?type=page&page=services'],['Productions','page','Published production page sections','/admin/content?type=page&page=projects'],['News','news','Studio news and announcements','/admin/content?type=news'],['Blog','blog','Blog posts and banners','/admin/content?type=blog'],['Careers','career','Career opportunities','/admin/content?type=career'],['Team profiles','team','Leadership and studio team','/admin/content?type=team'],['Legal centre','legal','Published legal notices','/admin/content?type=legal'],['Media partners','media_partner','News page partner logos','/admin/content?type=media_partner']]; sections.forEach(([label,icon,description,href])=>{ %>
<a class="panel admin-page-card" href="<%= href %>"><span class="admin-page-icon"><%- include('icon',{name:icon}) %></span><h2><%= label %></h2><p><%= description %></p><span>Manage content</span></a><% }); %>
<% if(user.role==='admin'){ %><a class="panel admin-page-card" href="/admin/settings"><span class="admin-page-icon"><%- include('icon',{name:'settings'}) %></span><h2>Contact & site settings</h2><p>Enquiry availability, privacy notice and social links</p><span>Manage settings</span></a><% } %>
</div><%- include('foot') %>
