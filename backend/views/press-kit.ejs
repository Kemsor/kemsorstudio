<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= entry.title %> — Press kit | Kemsor Studios</title><style>body{margin:0;background:#f2e8d7;color:#251c12;font:16px/1.8 Arial,sans-serif}header{background:#171109;color:#f2e8d7;padding:40px}main{max-width:960px;margin:0 auto;padding:40px 24px;background:white}h1,h2,h3{font-family:Georgia,serif;line-height:1.3}h1{font-size:clamp(30px,6vw,52px)}section{margin:36px 0;break-inside:avoid}p{white-space:pre-wrap;overflow-wrap:anywhere}a{color:inherit}nav{display:flex;flex-wrap:wrap;gap:20px}li{margin:12px 0}footer{padding:24px;text-align:center}@media print{body,header{background:white;color:black}nav,.print-help{display:none}main{padding:0}header{padding:0}a{color:black}h2{break-after:avoid}}</style></head><body><header><p>KEMSOR STUDIOS · ELECTRONIC PRESS KIT</p><h1><%= entry.title %></h1><% if(base&&!download){ %><nav><a href="<%= base %>press-kit.html" download>Download structured kit (HTML)</a><% if(metadata.epk_url){ %><a href="<%= base %>press-kit.pdf" download>Download approved PDF</a><% } %></nav><p class="print-help">Use your browser’s Print command to print or save this kit as a PDF.</p><% } %></header><main><% if(metadata.epk_intro){ %><section><h2>Introduction</h2><p><%= metadata.epk_intro %></p></section><% } %><section><h2>About the production</h2><p><%= [metadata.format,metadata.language,metadata.year].filter(Boolean).join(' · ') %></p><p><%= entry.summary %></p><h3>Synopsis</h3><p><%= entry.body %></p></section><% [['Cast',metadata.cast_credits],['Crew',metadata.crew_credits],['Contributors',metadata.contributor_credits]].forEach(([label,credits])=>{if(credits?.length){ %><section><h2><%= label %></h2><ul><% credits.forEach(credit=>{ %><li><strong><%= credit.name %></strong><%= credit.role?' — '+credit.role:'' %></li><% }) %></ul></section><% } }) %><% (metadata.epk_statements||[]).forEach(statement=>{ %><section><h2><%= statement.title %></h2><% if(statement.author){ %><h3><%= statement.author %></h3><% } %><p><%= statement.body %></p></section><% }) %><% if(people.length){ %><section><h2>Biographies</h2><% people.forEach(person=>{ %><article><h3><%= person.name %></h3><p><%= person.profession %></p><p><%= person.biography %></p></article><% }) %></section><% } %><% if(metadata.rights_summary){ %><section><h2>Rights information</h2><p><%= metadata.rights_summary %></p></section><% } %><% if(metadata.awards?.length){ %><section><h2>Awards and festival selections</h2><ul><% metadata.awards.forEach(item=>{ %><li><%= item.event %> · <%= item.year %> · <%= item.outcome.replaceAll('_',' ') %> · <%= item.category %><% if(item.source_url){ %> · <a href="<%= item.source_url %>" rel="noreferrer noopener">Source</a><% } %></li><% }) %></ul></section><% } %><% if(metadata.screenings?.length){ %><section><h2>Premieres and screenings</h2><ul><% metadata.screenings.forEach(item=>{ %><li><%= item.event %> · <%= item.date %> · <%= [item.venue,item.city,item.country].filter(Boolean).join(', ') %></li><% }) %></ul></section><% } %></main><footer>Kemsor Studios · Approved press materials</footer></body></html>
