<div class="button-row site-editor-actions"><button class="admin-save" name="action" value="draft">Save draft</button><button name="action" value="publish">Publish changes</button><button class="quiet" name="action" value="reset">Reset to supplied defaults</button></div>
<% if(history.length){ %><hr><label>Restore earlier draft<select name="restore_revision"><% history.forEach(item=>{ %><option value="<%= item.revision %>">Revision <%= item.revision %> · <%= item.action %> · <%= item.created_at %></option><% }); %></select></label><button class="quiet" name="action" value="restore">Restore as draft</button><% } %>
