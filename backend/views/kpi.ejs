<%- include('head') %>
<link rel="stylesheet" href="/kpi.css?v=1"><script src="/kpi.js?v=1" defer></script>
<div class="kpi-workspace <%= summaryOnly?'kpi-summary-view':'' %>">
<div class="heading-row"><div><p class="eyebrow">KEMSOR · MANAGEMENT REPORTING</p><h1><%= summaryOnly?'Executive summary':'KPI & outcome dashboard' %></h1><p><%= card.period.cadence %> · <%= card.period.start %> – <%= card.period.end %> · <%= report?.approved_at?'Approved snapshot #'+report.id:report?'Unapproved snapshot #'+report.id:'Live working scorecard' %></p></div><div class="kpi-toolbar no-print"><a class="button quiet" href="/admin/reports">All reports</a><% if(user.role==='admin'){ %><a class="button quiet" href="/admin/kpi/settings">Targets & definitions</a><% } %><a class="button quiet" href="/admin/kpi/export.csv?<%= report?'report='+report.id:new URLSearchParams({cadence:card.period.cadence,date:card.period.start}) %>">Download CSV</a><button type="button" data-kpi-print>Print / save PDF</button></div></div>
<form method="get" action="/admin/kpi" class="filters no-print"><label>Report type<select name="cadence"><% ['weekly','monthly','quarterly'].forEach(c=>{ %><option value="<%= c %>" <%= c===card.period.cadence?'selected':'' %>><%= c[0].toUpperCase()+c.slice(1) %></option><% }) %></select></label><label>Date within period<input type="date" name="date" value="<%= card.period.start %>" required></label><button>View period</button><a class="button quiet" href="<%= urlFor({cadence:card.period.cadence,start:card.period.previous}) %>">Previous period</a><a class="button quiet" href="<%= report?'/admin/kpi/reports/'+report.id:urlFor(card.period) %><%= report?'?':'&' %>view=<%= summaryOnly?'full':'summary' %>"><%= summaryOnly?'Full scorecard':'Executive summary' %></a></form>
<% if(report){ %><p class="notice">Saved <%= card.generatedAt %> UTC by <%= report.automatic_key?'Scheduled draft':report.author||'Former staff member' %>. <%= report.approved_at?'Approved '+report.approved_at+' UTC by '+(report.approver||'Former administrator')+'.':'Not approved.' %> Figures, methodology, commentary and actions in this snapshot are frozen. <a href="<%= urlFor(card.period) %>">Open live period</a> to make changes and create a new revision.</p><% } %>
<% if(card.period.inProgress){ %><p class="notice kpi-caution">This snapshot was generated for an unfinished or future period. Totals are provisional; comparisons with a complete previous period are not like-for-like. Create a fresh snapshot after period close.</p><% } %>
<% if(card.outcomeWarning){ %><p class="notice kpi-caution"><strong>Outcome alert:</strong> <%= card.outcomeWarning %></p><% } %>
<p class="form-help">Generated <%= card.generatedAt %> UTC. Automatic drafts: <%= card.configuration.automaticDrafts?'enabled':'off' %>. Previous <%= card.period.cadence==='weekly'?'week':'period' %>: <%= card.previousPeriod.start %> – <%= card.previousPeriod.end %>. Calendar periods and CMS timestamps use UTC. External-source timezones are recorded below.</p>
<section class="kpi-highlights" aria-label="Business outcome highlights"><% ['leads','qualified','converted','conversion_rate'].forEach(key=>{const m=card.metrics.find(m=>m.key===key); %><article class="panel"><span><%= m.label %></span><strong><%= display(m.actual,m.unit) %></strong><small>Target: <%= m.target===null?'Not set':display(m.target,m.unit) %></small><span class="kpi-status <%= m.rag %>"><%= m.rag %></span></article><% }) %></section>
<section class="panel kpi-executive"><h2>Management executive summary</h2><% if(summaryOnly){ %><p class="form-help">Condensed brief. Full commentary, evidence and initiatives are retained in the full report.</p><% } %><p class="kpi-prose"><%= summaryOnly?clip(card.input.executive||'Executive summary not recorded.',800):card.input.executive||'No executive summary recorded. Add the period’s business outcomes, exceptions and priorities in the reporting inputs below.' %></p><% if(card.missing.length){ %><p class="kpi-caution">Unavailable measures: <%= card.missing.join(', ') %>. Missing measurements are not zero.</p><% } %><p class="form-help">Qualified and converted figures are staff-recorded CMS milestones, not verified revenue. Traffic growth alone does not establish business success.</p></section>
<section class="panel kpi-detail"><h2>Target vs actual scorecard</h2><div class="report-table-scroll"><table><thead><tr><th scope="col">Measure</th><th scope="col">Target</th><th scope="col">Actual</th><th scope="col">Previous <%= card.period.cadence==='weekly'?'week':'period' %></th><th scope="col">Change</th><th scope="col">Change %</th><th scope="col">Status</th></tr></thead><tbody><% card.metrics.forEach(m=>{ %><tr><th scope="row"><%= m.label %><small class="kpi-source"><%= m.source %><%= m.direction==='lower'?' · lower is better':'' %></small></th><td><%= m.target===null?'Not set':display(m.target,m.unit) %></td><td><strong><%= display(m.actual,m.unit) %></strong></td><td><%= display(m.previous,m.unit) %></td><td><%= m.change===null?'—':(m.change>0?'+':'')+display(m.change,m.unit==='percent'?'number':'count')+(m.unit==='percent'?' pp':'') %></td><td><%= m.percentChange===null?'—':(m.percentChange>0?'+':'')+display(m.percentChange,'percent') %></td><td><span class="kpi-status <%= m.rag %>"><%= m.rag %></span></td></tr><% }) %></tbody></table></div><p class="form-help">Green: target met. Amber: within <%= card.configuration.amberPercent %>% of a higher-is-better target, or at most target ÷ <%= card.configuration.amberPercent/100 %> for a lower-is-better measure. Red: outside that range. Unrated: actual or target unavailable. Percentage change is undefined when the previous value is zero; pp means percentage points.</p></section>
<div class="kpi-review-grid kpi-detail"><% sectionKeys.filter(key=>key!=='executive').forEach(key=>{ %><section class="panel"><h2><%= sectionLabels[key] %></h2><p class="kpi-prose"><%= card.input[key]||'Not recorded.' %></p></section><% }) %></div>
<section class="panel" id="actions"><h2>Corrective initiatives & ownership</h2><p>Actions assigned to this period, followed by up to 200 unresolved actions carried from earlier periods. Recommendations requiring new work remain subject to separate authorization.</p><%- include('kpi-actions',{actions:[...card.actions,...card.carried],readonly:Boolean(report),compact:summaryOnly}) %>
<% if(!report&&!summaryOnly){ %><details class="no-print"><summary>Add corrective initiative</summary><form action="/admin/kpi/actions" method="post" class="kpi-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="cadence" value="<%= card.period.cadence %>"><input type="hidden" name="date" value="<%= card.period.start %>"><label>Initiative<input name="title" maxlength="200" required></label><label>Measure<select name="metric_key"><option value="overall">Overall business outcome</option><% metricDefinitions.forEach(m=>{ %><option value="<%= m.key %>"><%= m.label %></option><% }) %></select></label><label>Responsible owner<select name="owner_id" required><option value="">Choose owner</option><% users.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></label><label>Due date<input name="due_date" type="date" required></label><label class="kpi-wide">Expected measurable outcome<textarea name="expected_outcome" maxlength="3000" required></textarea></label><button>Add initiative</button></form></details><% } %></section>
<section class="panel kpi-detail"><h2>Technical & backup exception evidence</h2><% if(!card.operations.length){ %><p>No operation runs recorded for this period. This does not establish successful backup, availability or security coverage.</p><% }else{ %><div class="report-table-scroll"><table><thead><tr><th>Job</th><th>Status</th><th>Runs</th><th>Last finished UTC</th></tr></thead><tbody><% card.operations.forEach(o=>{ %><tr><td><%= o.job %></td><td><%= o.status %></td><td><%= o.total %></td><td><%= o.last_finished||'Not finished' %></td></tr><% }) %></tbody></table></div><% } %><p class="form-help">These logs cover recorded application jobs. Security audits, patches, uptime, restore success and Core Web Vitals need their own evidence in the technical review.</p></section>
<section class="panel kpi-detail"><h2>Enquiry source breakdown</h2><p>Recorded source on eligible period-created enquiries. Staff-entered sources are not analytics attribution.</p><ul><% card.sourceBreakdown.forEach(s=>{ %><li><%= s.label %>: <strong><%= s.total %></strong></li><% }) %></ul><% if(!card.sourceBreakdown.length){ %><p>No eligible enquiries.</p><% } %></section>
<section class="panel kpi-detail"><h2>Sources & calculation methodology</h2><p>Settings version <%= card.configurationVersion %>; input version <%= card.inputVersion %>. Inputs recorded by <%= card.inputRecorder||'Not recorded' %>, updated <%= card.inputUpdatedAt||'Not recorded' %> UTC. Business categories: <%= card.configuration.categories.map(key=>categories[key]||key).join(', ') %>.</p><p>CMS measures use enquiries created in this UTC period and recorded milestones reached by its end. Later closure does not erase a recorded milestone. Spam is excluded using its current flag. Deletions, missing historical milestones and source edits can change a live historical scorecard; saved snapshots preserve the reporting evidence.</p><% [['GA4',card.input.analytics],['Search Console',card.input.search]].forEach(([name,source])=>{ %><h3><%= name %></h3><p><%= source?.reference||'No source supplied.' %></p><p><%= source?.filters||'Property, timezone and filters not recorded.' %> · Extracted: <%= source?.extracted_on||'Not recorded' %></p><% }) %><p>Analytics/Search Console figures are manually attributed inputs, not a live API connection. Each month and quarter needs its own exact-period export; weekly users/rates are not summed. Session and search comparisons can differ from UTC CMS cohorts because of source timezone, consent and attribution.</p><details><summary>All metric definitions</summary><dl><% card.metrics.forEach(m=>{ %><dt><strong><%= m.label %></strong></dt><dd><%= m.definition %></dd><% }) %></dl></details></section>
<% if(!report&&user.role==='admin'&&!summaryOnly){ %><section class="panel kpi-detail no-print" id="inputs"><h2>Period inputs & management commentary</h2><p>Blank means unavailable; enter 0 only when the source actually reports zero. Do not put passwords, API secrets or personal enquiry details in these fields.</p><form method="post" action="/admin/kpi/inputs" class="kpi-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="cadence" value="<%= card.period.cadence %>"><input type="hidden" name="date" value="<%= card.period.start %>"><input type="hidden" name="version" value="<%= card.inputVersion %>">
<h3 class="kpi-wide">Google Analytics 4</h3><% [['sessions','Sessions'],['engaged_sessions','Engaged sessions'],['organic_sessions','Organic search sessions'],['tracked_enquiries','Successful enquiry key events']].forEach(([key,label])=>{ %><label><%= label %><input type="number" min="0" step="1" name="<%= key %>" value="<%= card.input.analytics?.[key]??'' %>"></label><% }) %><label class="kpi-wide">GA4 export / report reference<input name="ga4_reference" maxlength="1000" value="<%= card.input.analytics?.reference||'' %>"></label><label class="kpi-wide">GA4 property, timezone, event names and filters<textarea name="ga4_filters" maxlength="2000"><%= card.input.analytics?.filters||'' %></textarea></label><label>GA4 extraction date<input type="date" name="ga4_extracted_on" value="<%= card.input.analytics?.extracted_on||'' %>"></label>
<h3 class="kpi-wide">Google Search Console</h3><% [['search_clicks','Search clicks'],['search_impressions','Search impressions']].forEach(([key,label])=>{ %><label><%= label %><input type="number" min="0" step="1" name="<%= key %>" value="<%= card.input.search?.[key]??'' %>"></label><% }) %><label class="kpi-wide">Search Console export / report reference<input name="gsc_reference" maxlength="1000" value="<%= card.input.search?.reference||'' %>"></label><label class="kpi-wide">Search Console property, timezone and search/device/country filters<textarea name="gsc_filters" maxlength="2000"><%= card.input.search?.filters||'' %></textarea></label><label>Search Console extraction date<input type="date" name="gsc_extracted_on" value="<%= card.input.search?.extracted_on||'' %>"></label>
<h3 class="kpi-wide">Management commentary</h3><% sectionKeys.forEach(key=>{ %><label class="kpi-wide"><%= sectionLabels[key] %><textarea name="<%= key %>" maxlength="<%= key==='executive'?1600:6000 %>" rows="4"><%= card.input[key]||'' %></textarea></label><% }) %><button>Save period inputs</button></form></section><% } %>
<section class="panel no-print kpi-detail"><h2><%= report?'Snapshot approval':'Save reporting evidence' %></h2><% if(!report){ %><p>Create a frozen revision of the current figures, source references, settings, commentary and action status. Saving does not email recipients or approve the report.</p><form method="post" action="/admin/kpi/snapshots"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="cadence" value="<%= card.period.cadence %>"><input type="hidden" name="date" value="<%= card.period.start %>"><input type="hidden" name="configuration_version" value="<%= card.configurationVersion %>"><input type="hidden" name="input_version" value="<%= card.inputVersion %>"><button>Save report snapshot</button></form><% }else if(!report.approved_at&&user.role==='admin'){ %><p>Approval records an administrator’s review; it does not replace KEMSOR’s contractual acceptance. Only completed periods with required commentary can be approved. Unavailable measures remain disclosed.</p><form action="/admin/kpi/reports/<%= report.id %>/approve" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="check"><input type="checkbox" name="confirm" value="approve" required>I reviewed the figures, source evidence and disclosed limitations.</label><button>Approve snapshot</button></form><% }else{ %><p><%= report.approved_at?'This approved evidence is frozen. Use a new snapshot for corrections.':'An administrator can approve this snapshot after period close and review.' %></p><% } %></section>
<section class="panel no-print kpi-detail"><h2>Saved reports</h2><div class="report-table-scroll"><table><thead><tr><th>Report</th><th>Period start</th><th>Created UTC</th><th>Approval</th></tr></thead><tbody><% reports.forEach(r=>{ %><tr><td><a href="/admin/kpi/reports/<%= r.id %>">#<%= r.id %> · <%= r.cadence %></a></td><td><%= r.period_start %></td><td><%= r.created_at %></td><td><%= r.approved_at?'Approved by '+(r.approver||'Former administrator'):'Not approved' %></td></tr><% }) %></tbody></table></div><% if(!reports.length){ %><p>No snapshots saved yet.</p><% } %><p>Showing the latest 40 revisions. Older snapshots remain available at their report URLs.</p></section>
</div>
<%- include('foot') %>
