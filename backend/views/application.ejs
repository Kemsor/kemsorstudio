<%- include('head') %>
<p><a class="button quiet" href="/admin/applications">Back to applications</a></p>
<div class="heading-row"><div><p class="eyebrow">APP-<%= String(application.id).padStart(6,'0') %></p><h1><%= application.name %></h1><p><%= application.career_title %></p></div><span class="badge"><%= application.status %></span></div>
<div class="recruitment-grid"><div>
<section class="panel"><h2>Applicant details</h2><dl class="applicant-details"><% [['Email',application.email],['Phone',application.phone],['Location',application.city],['Experience',application.experience]].forEach(([label,value])=>{ %><div><dt><%= label %></dt><dd><%= value || 'Not provided' %></dd></div><% }); %></dl><h2>Application message</h2><p class="pre-line"><%= application.message || 'No message provided.' %></p><small>Received <%= application.created_at %> UTC · Consent <%= application.consent_version %></small></section>
<section class="panel"><div class="panel-heading"><h2>Résumé</h2><a class="button quiet" href="/admin/applications/<%= application.id %>/resume">Download PDF</a></div><p class="resume-filename"><%= application.resume_name %></p><details class="resume-preview"><summary>Preview résumé</summary><iframe title="Private résumé preview for <%= application.name %>" data-resume-src="/admin/applications/<%= application.id %>/resume/preview" loading="lazy"></iframe><p class="form-help">If your browser cannot display the PDF, use Download PDF above.</p></details></section>
<section class="panel"><h2>Internal notes</h2><p class="form-help">Visible only to authorised recruitment staff.</p><% if(!notes.length){ %><p class="empty">No notes yet. Add your first note using the review form.</p><% } %><% notes.forEach(note=>{ %><article class="recruitment-note"><p class="pre-line"><%= note.note %></p><small><%= note.staff_name || 'Former staff member' %> · <%= note.created_at %> UTC</small></article><% }); %></section>
</div><aside>
<form method="post" class="panel recruitment-review"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Review application</h2><label>Status<select name="status"><% states.forEach(s=>{ %><option value="<%= s %>" <%= application.status===s?'selected':'' %>><%= s %></option><% }); %></select></label><label>Internal note<textarea name="note" rows="5" maxlength="4000" placeholder="Interview feedback, follow-up or next steps"></textarea></label><button>Save review</button></form>
<section class="panel"><h2>Status history</h2><p class="form-help">Changes recorded from now on; previous changes may not be available.</p><ol class="recruitment-history"><% history.forEach(event=>{ %><li><strong><%= event.from_status %> to <%= event.to_status %></strong><small><%= event.staff_name || 'Former staff member' %> · <%= event.created_at %> UTC</small></li><% }); %><li><strong>Application submitted</strong><small><%= application.created_at %> UTC</small></li></ol></section>
<section class="panel"><h2>Applicant history</h2><p class="form-help">Applications using the same email address. This does not verify that they are the same person.</p><% related.forEach(item=>{ %><article class="related-application"><a href="/admin/applications/<%= item.id %>"><%= item.career_title %><%= item.id===application.id?' (current)':'' %></a><span class="badge"><%= item.status %></span><small>APP-<%= String(item.id).padStart(6,'0') %> · <%= item.created_at %> UTC</small></article><% }); %></section>
</aside></div><%- include('foot') %>
