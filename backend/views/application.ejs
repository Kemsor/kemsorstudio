<%- include('head') %>
<p><a class="button quiet" href="<%= back %>">Back to applications</a></p>
<div class="heading-row"><div><p class="eyebrow">APP-<%= String(application.id).padStart(6,'0') %></p><h1><%= application.name %></h1><p><%= application.career_title %></p></div><span class="badge"><%= application.status %></span></div>
<p><a class="button" href="/admin/replies/application/<%= application.id %><%= returnTo?'?return_to='+encodeURIComponent(returnTo):'' %>">Reply by email</a></p>
<%- include('workflow-record-summary',{record:application}) %><div class="recruitment-grid"><div>
<section class="panel"><h2>Applicant details</h2><dl class="applicant-details"><% [['Email',application.email],['Phone',application.phone],['Location',application.city],['Experience',application.experience],['Team',application.team],['Application type',application.application_type]].forEach(([label,value])=>{ %><div><dt><%= label %></dt><dd><%= value || 'Not provided' %></dd></div><% }); %></dl><% if(application.portfolio_url){ %><h2>Portfolio / showreel</h2><p><a href="<%= application.portfolio_url %>" target="_blank" rel="noopener noreferrer">Open portfolio</a></p><% } %><h2>Application message</h2><p class="pre-line"><%= application.message || 'No message provided.' %></p><small>Received <%= application.created_at %> UTC · Consent <%= application.consent_version %></small></section>
<section class="panel"><div class="panel-heading"><h2>Résumé</h2><a class="button quiet" href="/admin/applications/<%= application.id %>/resume">Download PDF</a></div><p class="resume-filename"><%= application.resume_name %></p><details class="resume-preview"><summary>Preview résumé</summary><iframe title="Private résumé preview for <%= application.name %>" data-resume-src="/admin/applications/<%= application.id %>/resume/preview" loading="lazy"></iframe><p class="form-help">If your browser cannot display the PDF, use Download PDF above.</p></details></section>
<%- include('workflow-timeline',{record:application,resource:'application'}) %>
</div><aside>
<form method="post" class="panel recruitment-review"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Review application</h2><label>Status<select name="status"><% states.forEach(s=>{ %><option value="<%= s %>" <%= application.status===s?'selected':'' %>><%= s %></option><% }); %></select></label><%- include('workflow-fields',{record:application}) %><label>Internal note<textarea name="note" rows="5" maxlength="4000" placeholder="Interview feedback, follow-up or next steps"></textarea></label><button class="admin-save">Save review</button></form>
<section class="panel"><h2>Applicant history</h2><p class="form-help">Applications using the same email address. This does not verify that they are the same person.</p><% related.forEach(item=>{ %><article class="related-application"><a href="<%= workflowRecordUrl('application',item.id,returnTo) %>"><%= item.career_title %><%= item.id===application.id?' (current)':'' %></a><span class="badge"><%= item.status %></span><small>APP-<%= String(item.id).padStart(6,'0') %> · <%= item.created_at %> UTC</small></article><% }); %></section>
</aside></div><% if(user.role==='admin'){ %><form class="panel" action="/admin/operations/application/<%= application.id %>/hold" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Retention hold</h2><p><%= application.retention_hold?'Protected from automated and manual deletion.':'No retention hold is active.' %></p><input type="hidden" name="retention_hold" value="<%= application.retention_hold?'false':'true' %>"><button><%= application.retention_hold?'Release hold':'Place on hold' %></button></form><% } %><% if(user.role==='admin'){ %><form class="panel danger" method="post" action="/admin/operations/application/<%= application.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Delete personal data</h2><p>Permanently removes this application, notes, history, confirmation receipt and résumé. A retention hold blocks deletion.</p><label class="check"><input type="checkbox" name="confirm" value="delete" required>I confirm permanent deletion.</label><button>Delete this application</button></form><% } %><%- include('foot') %>
