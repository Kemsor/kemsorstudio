<%- include('head') %><div class="heading-row"><div><p class="eyebrow">Private publishing preview</p><h1>Content preview</h1></div><a class="button quiet" href="/admin/content/<%= entry.id %>">Back to editor</a></div><p class="preview-notice">This preview shows saved content. Drafts and archived entries remain private.</p><article class="content-preview"><span class="badge badge-<%= entry.status %>"><%= entry.status %></span><p class="eyebrow"><%= types[entry.type] %></p><% if(entry.image_id){ %><img src="/media/<%= entry.image_id %>" alt="<%= image?.alt || '' %>"><% } %><h2><%= entry.title %></h2><% if(entry.metadata.role || entry.metadata.location){ %><p class="preview-metadata"><%= [entry.metadata.role,entry.metadata.location].filter(Boolean).join(' · ') %></p><% } %><p class="preview-summary"><%= entry.summary %></p><div class="preview-body"><% String(entry.body || '').split(/\n\s*\n/).filter(Boolean).forEach(paragraph=>{ %><p><%= paragraph %></p><% }); %></div></article><%- include('foot') %>
