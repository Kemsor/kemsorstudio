<%- include('head') %>
<% const typeLabels={enquiry:'Enquiries',application:'Applications',draft:'Publishing',talent:'Members',setup:'Settings'};
const itemType=item=>item.key.split(':')[0];
const filtered=notifications.filter(item=>(view==='history'? !item.active : (view==='all'||(view==='read'?item.read:!item.read)))&&(kind==='all'||itemType(item)===kind));
const readCount=notifications.filter(item=>item.read).length;
const href=(selectedView,selectedKind)=>`/admin/notifications?view=${selectedView}&kind=${selectedKind}`;
%>
<div class="notification-page">
<div class="heading-row notification-page-heading"><div><p class="eyebrow">Workspace updates</p><h1>Notifications</h1><p>Review new submissions, publishing updates and items needing attention.</p></div><div class="notification-page-actions"><a class="button quiet" href="<%= href(view,kind) %>"><%- include('icon',{name:'audit'}) %>Refresh</a><% if(unreadCount){ %><form method="post" action="/admin/notifications/read"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="key" value="all"><button>Mark all as read</button></form><% } %></div></div>
<details class="panel notification-preferences"><summary>Notification preferences</summary><p>Choose categories for your feed and unread badge. History keeps completed updates even when a category is switched off. Preferences apply only to your account.</p><form action="/admin/notifications/preferences" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><div><% preferences.forEach(item=>{ %><label class="check"><input type="checkbox" name="pref_<%= item.key %>" <%= item.enabled?'checked':'' %>><%= item.label %></label><% }); %></div><button>Save preferences</button></form></details>
<p class="notification-history-note">The latest 200 recorded updates are shown. History starts when an update is first recorded; earlier completed items may not be available.</p>
<div class="notification-summary"><a href="<%= href('unread','all') %>"><span class="notification-summary-icon"><%- include('icon',{name:'bell'}) %></span><div><span>Unread</span><strong><%= unreadCount %></strong></div></a><a href="<%= href('read','all') %>"><span class="notification-summary-icon"><%- include('icon',{name:'review'}) %></span><div><span>Read</span><strong><%= readCount %></strong></div></a><a href="<%= href('all','all') %>"><span class="notification-summary-icon"><%- include('icon',{name:'overview'}) %></span><div><span>All updates</span><strong><%= notifications.length %></strong></div></a></div>
<section class="panel notification-inbox"><div class="notification-inbox-toolbar"><nav class="notification-tabs" aria-label="Notification status"><% [['all','All'],['unread','Unread'],['read','Read'],['history','History']].forEach(([value,label])=>{ %><a href="<%= href(value,kind) %>" <%- view===value?'aria-current="page"':'' %>><%= label %></a><% }); %></nav><form method="get" class="notification-kind-filter"><input type="hidden" name="view" value="<%= view %>"><label>Category<select name="kind"><option value="all">All categories</option><% Object.entries(typeLabels).filter(([key])=>notifications.some(item=>itemType(item)===key)||key===kind).forEach(([key,label])=>{ %><option value="<%= key %>" <%= kind===key?'selected':'' %>><%= label %></option><% }); %></select></label><button class="quiet">Filter</button></form></div>
<p class="notification-list-count"><%= filtered.length %> <%= filtered.length===1?'notification':'notifications' %></p>
<% if(!filtered.length){ %><div class="notification-inbox-empty"><span><%- include('icon',{name:'bell'}) %></span><h2><%= view==='unread'?'You’re all caught up':'No notifications here' %></h2><p><%= view==='unread'?'New updates will appear here when there is something to review.':'Try another category or view all workspace updates.' %></p><a class="button quiet" href="/admin/notifications">View all updates</a></div><% } %>
<div class="notification-inbox-list"><% filtered.forEach(item=>{const category=itemType(item),icon={enquiry:'enquiries',application:'career',draft:'blog',talent:'team',setup:'settings'}[category]||'bell'; %><article class="notification-inbox-row <%= item.read?'is-read':'is-unread' %>"><span class="notification-row-icon icon-<%= category %>"><%- include('icon',{name:icon}) %></span><div class="notification-row-copy"><div class="notification-row-meta"><span><%= typeLabels[category] || 'Workspace' %></span><span class="notification-read-state"><%= !item.active?'Completed':item.read?'Read':'Unread' %></span></div><a href="<%= item.href %>" class="notification-title"><%= item.title %></a><p><%= item.text %></p><small><%= item.date?item.date+' UTC':'Workspace reminder' %></small></div><div class="notification-row-actions"><a class="button quiet" href="<%= item.href %>">View details</a><% if(!item.read){ %><form method="post" action="/admin/notifications/read"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="key" value="<%= item.key %>"><button class="quiet">Mark as read</button></form><% } %></div></article><% }); %></div></section>
</div><%- include('foot') %>
