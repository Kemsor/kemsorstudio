<%- include('head') %><p><a class="button quiet" href="<%= back %>">Back to enquiries</a></p><p class="eyebrow">KEM-<%= String(enquiry.id).padStart(6,'0') %> / <%= categories[enquiry.category] %></p><h1><%= enquiry.subject %></h1><p><a class="button" href="/admin/replies/enquiry/<%= enquiry.id %><%= returnTo?'?return_to='+encodeURIComponent(returnTo):'' %>">Reply by email</a></p><%- include('workflow-record-summary',{record:enquiry}) %><div class="dashboard-grid"><section class="panel"><h2><%= enquiry.name %></h2><p><%= enquiry.email %><br><%= enquiry.organisation %></p><h2>Message</h2><p class="pre-line"><%= enquiry.message %></p><small>Received <%= enquiry.created_at %><br>Consent recorded <%= enquiry.consent_at %> · Notice <%= enquiry.consent_version %></small><% if(enquiry.attachment_filename){ %><p><a class="text-link" href="/admin/enquiries/<%= enquiry.id %>/attachment">Download attachment: <%= enquiry.attachment_name %></a></p><% } %></section><form class="panel" action="/admin/enquiries/<%= enquiry.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Follow-up</h2><label>Status<select name="status"><% statuses.forEach(item=>{ %><option value="<%= item %>" <%= enquiry.status===item?'selected':'' %>><%= item.replace('_',' ') %></option><% }) %></select></label><%- include('workflow-fields',{record:enquiry}) %><label>Tags<input name="tags" maxlength="500" value="<%= enquiry.tags || '' %>" placeholder="Comma-separated labels"></label><label>Source<input name="source" maxlength="200" value="<%= enquiry.source || 'website' %>"></label><label>Internal follow-up note<textarea name="note" rows="4" maxlength="4000"></textarea></label><button class="admin-save">Save follow-up</button></form></div><%- include('workflow-timeline',{record:enquiry,resource:'enquiry'}) %><% if(user.role==='admin'){ %><form class="panel danger" action="/admin/enquiries/<%= enquiry.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Delete personal data</h2><p>Permanently removes this enquiry, its notes and attachment.</p><label class="check"><input type="checkbox" required>I confirm this enquiry should be permanently deleted.</label><button>Delete this enquiry</button></form><% } %><% if(user.role==='admin'){ %><form class="panel" action="/admin/operations/enquiry/<%= enquiry.id %>/hold" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Retention hold</h2><p><%= enquiry.retention_hold?'Protected from automated and manual deletion.':'No retention hold is active.' %></p><input type="hidden" name="retention_hold" value="<%= enquiry.retention_hold?'false':'true' %>"><button><%= enquiry.retention_hold?'Release hold':'Place on hold' %></button></form><% } %><%- include('foot') %>