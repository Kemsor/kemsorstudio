<%- include('head') %><p><a class="button quiet" href="/admin/enquiries">Back to enquiries</a></p><p class="eyebrow">KEM-<%= String(enquiry.id).padStart(6,'0') %> / <%= categories[enquiry.category] %></p><h1><%= enquiry.subject %></h1><div class="dashboard-grid"><section class="panel"><h2><%= enquiry.name %></h2><p><%= enquiry.email %><br><%= enquiry.organisation %></p><h2>Message</h2><p class="pre-line"><%= enquiry.message %></p><small>Received <%= enquiry.created_at %><br>Consent recorded <%= enquiry.consent_at %> · Notice <%= enquiry.consent_version %></small><% if(enquiry.attachment_filename){ %><p><a class="text-link" href="/admin/enquiries/<%= enquiry.id %>/attachment">Download attachment: <%= enquiry.attachment_name %></a></p><% } %></section><form class="panel" action="/admin/enquiries/<%= enquiry.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Follow-up</h2><label>Status<select name="status"><% statuses.forEach(item=>{ %><option value="<%= item %>" <%= enquiry.status===item?'selected':'' %>><%= item.replace('_',' ') %></option><% }) %></select></label><label>Assigned to<select name="assigned_to"><option value="">Unassigned</option><% users.forEach(item=>{ %><option value="<%= item.id %>" <%= enquiry.assigned_to===item.id?'selected':'' %>><%= item.name %></option><% }) %></select></label><label>Internal follow-up note<textarea name="note" rows="4" maxlength="4000"></textarea></label><button>Save follow-up</button></form></div><section class="panel"><h2>Operational notes</h2><% notes.forEach(note=>{ %><article class="note"><p class="pre-line"><%= note.note %></p><small><%= note.name || 'Former user' %> · <%= note.created_at %></small></article><% }) %><% if(!notes.length){ %><p>No notes yet.</p><% } %></section><% if(user.role==='admin'){ %><form class="panel danger" action="/admin/enquiries/<%= enquiry.id %>/delete" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Delete personal data</h2><p>Permanently removes this enquiry, its notes and attachment.</p><label class="check"><input type="checkbox" required>I confirm this enquiry should be permanently deleted.</label><button>Delete this enquiry</button></form><% } %><%- include('foot') %>