<%- include('head') %>
<p class="eyebrow">TALENT NETWORK</p><h1>Registrations & profile reviews.</h1><p>Contact checks are performed by the studio before approval. This is a reviewed profile, not an identity verification badge. Approved artists appear publicly only when they opt in.</p>
<form class="filters" method="get" action="/admin/talent"><label>Search registrations<input name="q" value="<%= search %>" placeholder="Name, email or city" maxlength="100"></label><label>Status<select name="status"><option value="">All statuses</option><% ['pending','approved','suspended'].forEach(s=>{ %><option value="<%= s %>" <%= state===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Role<select name="role"><option value="">All roles</option><option value="artist" <%= role==='artist'?'selected':'' %>>Artist / crew</option><option value="hirer" <%= role==='hirer'?'selected':'' %>>Casting director / producer</option></select></label><button>Filter</button><a href="/admin/talent">Clear</a></form>
<p><%= total %> matching registrations · Page <%= page %> of <%= Math.max(1,Math.ceil(total/25)) %></p>
<% if(!accounts.length){ %><p>No registrations yet.</p><% } %>
<% accounts.forEach(a=>{ %><section class="panel registration-card"><h2><%= a.name %> · <%= a.role==='artist'?'Artist':'Casting Director / Producer' %></h2><p>Registered <%= a.created_at %> UTC</p><p><%= a.email %> · <%= a.city %> · <%= a.profession || a.organisation %></p><p><%= a.bio %></p><p>Skills: <%= a.skills %> / Languages: <%= a.languages %></p><p>Credits: <%= a.credits %></p><p>Visibility: <%= a.visible ? 'Public after approval':'Private' %> · Status: <%= a.status %></p><% if(a.showreel){ %><a href="<%= a.showreel %>" target="_blank" rel="noopener noreferrer">Portfolio / showreel ↗</a><% } %><% if(a.image_id){ %><img src="/media/<%= a.image_id %>" alt="Profile portrait" width="120" height="120"><% } %><form action="/admin/talent/<%= a.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="check"><input type="checkbox" name="contact_checked" <%= a.contact_checked?'checked':'' %>> Contact details checked by KEMSOR</label><label>Status<select name="status"><% ['pending','approved','suspended'].forEach(s=>{ %><option <%= a.status===s?'selected':'' %>><%= s %></option><% }); %></select></label><button>Save review</button></form></section><% }); %>
<nav aria-label="Registration pages" class="registration-pages"><% if(page>1){ %><a href="?q=<%= encodeURIComponent(search) %>&status=<%= state %>&role=<%= role %>&page=<%= page-1 %>">← Previous</a><% } %><% if(page*25<total){ %><a href="?q=<%= encodeURIComponent(search) %>&status=<%= state %>&role=<%= role %>&page=<%= page+1 %>">Next →</a><% } %></nav>
<%- include('foot') %>
