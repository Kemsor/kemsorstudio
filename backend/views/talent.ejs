<%- include('head') %>
<p class="eyebrow">TALENT NETWORK</p><h1>Registrations & profile reviews.</h1><p>Contact checks are performed by the studio before approval. This is a reviewed profile, not an identity verification badge. Approved artists appear publicly only when they opt in.</p>
<form class="filters" method="get" action="/admin/talent"><input type="hidden" name="sort" value="<%= table.sort %>"><input type="hidden" name="dir" value="<%= table.dir %>"><input type="hidden" name="per_page" value="<%= table.limit %>"><label>Search registrations<input name="q" value="<%= search %>" placeholder="Name, email or city" maxlength="100"></label><label>Status<select name="status"><option value="">All statuses</option><% ['pending','approved','suspended'].forEach(s=>{ %><option value="<%= s %>" <%= state===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Role<select name="role"><option value="">All roles</option><option value="artist" <%= role==='artist'?'selected':'' %>>Artist / crew</option><option value="hirer" <%= role==='hirer'?'selected':'' %>>Casting director / producer</option></select></label><button>Filter</button><a href="/admin/talent">Clear</a></form>
<p><%= total %> matching registrations · Page <%= page %> of <%= table.pages %></p>
<% if(!accounts.length){ %><p>No registrations yet.</p><% } %>
<div class="workspace-links"><a href="/admin/talent?role=artist">Artists & crew</a><a href="/admin/talent?role=hirer">Directors & producers</a><a href="/admin/talent">All members</a></div>
<%- include('table-tools',{resource:'members',actions:[['pending','Return to pending review'],['suspended','Suspend accounts']]}) %><div class="table-wrap"><table><thead><tr><th class="table-selection-cell"><input type="checkbox" data-select-page aria-label="Select all rows on this page"></th><%- include('table-heading',{label:'Name',column:'name'}) %><%- include('table-heading',{label:'Email',column:'email'}) %><%- include('table-heading',{label:'Role',column:'role'}) %><%- include('table-heading',{label:'Location',column:'city'}) %><%- include('table-heading',{label:'Status',column:'status'}) %><%- include('table-heading',{label:'Registered',column:'registered'}) %><th>Action</th></tr></thead><tbody><% accounts.forEach(a=>{ %><tr><td class="table-selection-cell"><input type="checkbox" name="ids" value="<%= a.id %>" form="table-bulk-form" data-row-select aria-label="Select record <%= a.id %>"></td><td><%= a.name %></td><td><%= a.email %></td><td><%= a.role==='artist'?'Artist / crew':'Director / producer' %></td><td><%= a.city || '—' %></td><td><span class="badge badge-<%= a.status %>"><%= a.status %></span></td><td><%= a.created_at %> UTC</td><td><a class="button quiet" href="/admin/talent/<%= a.id %>">View</a></td></tr><% }); %></tbody></table></div>

<%- include('table-pagination') %><%- include('foot') %>
