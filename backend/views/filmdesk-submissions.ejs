<%- include('head') %><p class="eyebrow">FilmDesk / Studio review</p><h1><%= submission?submission.title:'FilmDesk submissions' %></h1><p>Only material the owner explicitly selected and submitted is shown here. Private workspace edits are excluded.</p>
<% if(submission){ %><p><a href="/admin/filmdesk">All submissions</a> · Reference FD-<%= submission.id %> · Workspace version <%= submission.project_revision %> · <%= submission.name %> · <%= submission.created_at %> UTC</p>
<% Object.entries(submission.snapshot.plan).forEach(([key,value])=>{ %><section class="panel"><h2><%= tools.find(([id])=>id===key)?.[1]||key %></h2><p class="pre-line"><%= value %></p></section><% }) %>
<% if(submission.script_filename){ %><p><a class="button quiet" href="/admin/filmdesk/<%= submission.id %>/document">Download shared document: <%= submission.script_name %></a></p><% } %>
<form class="panel" method="post" action="/admin/filmdesk/<%= submission.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Status<select name="status"><% ['received','reviewing','responded','closed'].forEach(status=>{ %><option value="<%= status %>" <%= submission.status===status?'selected':'' %>><%= status %></option><% }) %></select></label><label>Message visible to the project owner<textarea name="studio_note" rows="4" maxlength="3000"><%= submission.studio_note||'' %></textarea></label><button class="admin-save">Save review</button></form><details class="panel"><summary>Accepted submission terms · <%= submission.terms_version %></summary><p class="pre-line"><%= submission.terms_text %></p></details>
<% }else{ %><% if(!submissions.length){ %><div class="panel empty">No FilmDesk work has been submitted.</div><% } %><% submissions.forEach(item=>{ %><article class="panel"><h2><a href="/admin/filmdesk/<%= item.id %>"><%= item.title %></a></h2><p>FD-<%= item.id %> · <%= item.name %> · Version <%= item.project_revision %> · <%= item.status %> · <%= item.created_at %> UTC</p></article><% }) %><% } %><%- include('foot') %>
