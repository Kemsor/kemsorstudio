<% if(entry.type==='production'){ const m=entry.metadata; %>
<section class="panel"><h3>Production record</h3><dl class="profile-details"><% [
 ['Internal working title',m.working_title],['Format',m.format],['Production status',m.production_stage?.replaceAll('_',' ')],
 ['Genres',(m.genres||[]).join(', ')],['Languages',m.language],['Production year',m.year],['Release date',m.release_date]
].forEach(([label,value])=>{ %><div><dt><%= label %></dt><dd><%= value || 'Not supplied' %></dd></div><% }) %></dl><% [['Cast',m.cast_credits],['Crew',m.crew_credits],['Contributors',m.contributor_credits]].forEach(([label,credits])=>{ if(credits?.length){ %><h4><%= label %></h4><ul><% credits.forEach(credit=>{ %><li><strong><%= credit.name %></strong><% if(credit.role){ %> — <%= credit.role %><% } %></li><% }) %></ul><% } }) %><% if(m.gallery?.length){ %><h4>Gallery</h4><% m.gallery.forEach(item=>{ %><figure><img src="/media/<%= item.media_id %>" alt="<%= item.alt %>" width="240"><figcaption><%= item.kind==='behind_the_scenes'?'Behind the scenes':'Production still' %><%= item.caption?' — '+item.caption:'' %></figcaption></figure><% }) } %><% if(m.epk_url){ %><h4>Electronic press kit</h4><a href="<%= m.epk_url %>" target="_blank" rel="noopener">Preview press kit PDF</a><% } %><%- productionExtraHtml(m,{staff:true}) %><p class="form-help">Working titles are private to studio staff. This staff preview includes private planning fields.</p><% if(entry.status==='published' && entry.published_at && new Date(entry.published_at+'Z')<=new Date()){ %><a class="button" href="/productions/<%= entry.slug %>/" target="_blank" rel="noopener">View public production page</a><% } %></section>
<% } %>
