<label>Owner<select name="owner"><option value="">All owners</option><option value="me" <%= workflow.owner==='me'?'selected':'' %>>Assigned to me</option><option value="unassigned" <%= workflow.owner==='unassigned'?'selected':'' %>>Unassigned</option></select></label>
<label>Priority<select name="priority"><option value="">All priorities</option><% ['urgent','high','normal','low'].forEach(value=>{ %><option value="<%= value %>" <%= workflow.priority===value?'selected':'' %>><%= value %></option><% }); %></select></label>
<label>Follow-up<select name="due"><option value="">All dates</option><option value="overdue" <%= workflow.due==='overdue'?'selected':'' %>>Overdue</option><option value="upcoming" <%= workflow.due==='upcoming'?'selected':'' %>>Next 7 days</option><option value="unscheduled" <%= workflow.due==='unscheduled'?'selected':'' %>>Not scheduled</option></select></label>
