<%- include('head') %><h1>Casting application #<%= application.id %></h1><section class="panel"><h2><%= application.call_title %> — <%= application.role_name %></h2><p><%= application.role_eligibility %></p><h3><%= application.name %></h3><p><%= application.email %></p><h3>Profile at submission</h3><dl><% Object.entries(application.profile_snapshot).forEach(([key,value])=>{ %><dt><%= key %></dt><dd><%= value||'Not supplied' %></dd><% }) %></dl><h3>Application message</h3><p><%= application.message %></p><h3>Audition links</h3><ul><% application.audition_links.forEach(link=>{ %><li><a href="<%= link %>" target="_blank" rel="noopener noreferrer"><%= link %></a></li><% }) %></ul><p>Terms version <%= application.terms_version %> accepted <%= application.consent_at %> UTC.</p><details><summary>Accepted terms</summary><p><%= application.terms_snapshot %></p></details></section><form method="post" class="panel"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="expected_status" value="<%= application.status %>"><label>Application status<select name="status"><% states.forEach(state=>{ %><option <%= application.status===state?'selected':'' %>><%= state %></option><% }) %></select></label><label>Private reviewer note<textarea name="note" rows="5" maxlength="4000"><%= application.reviewer_note %></textarea><small>Only studio reviewers can see this note.</small></label><button class="admin-save">Save review</button></form><section class="panel"><h2>Review history</h2><ul><% events.forEach(event=>{ %><li><strong><%= event.status %></strong> · <%= event.created_at %> UTC · <%= event.name||'Applicant' %><p><%= event.note %></p></li><% }) %></ul></section><section class="panel"><h2>Casting email delivery</h2><p>Acknowledgements and shortlist/rejection decisions are queued automatically. Private reviewer notes are never included.</p><% (typeof emails==='undefined'?[]:emails).forEach(mail=>{ %><article><h3><%= mail.subject %></h3><p><%= mail.recipient %> · <%= mail.status %> · <%= mail.attempts %> attempts</p><% if(mail.last_error){ %><p><%= mail.last_error %></p><% } %><% if(mail.status==='failed'){ %><form method="post" action="/admin/casting-applications/<%= application.id %>/emails/<%= mail.id %>/retry"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Retry failed email</button></form><% } %></article><% }) %></section><a href="/admin/casting-applications">Back to applications</a><%- include('foot') %>
