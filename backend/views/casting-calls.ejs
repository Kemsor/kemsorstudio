<%- include('head') %><div class="heading-row"><h1>Casting calls</h1><a class="button" href="/admin/casting/new">Create casting call</a></div><form method="get" class="filters"><label>Publishing status<select name="status"><option value="">All</option><% ['draft','published','archived'].forEach(value=>{ %><option <%= status===value?'selected':'' %>><%= value %></option><% }) %></select></label><button>Filter</button></form><div class="table-wrap"><table><thead><tr><th>Title</th><th>Production</th><th>Location</th><th>Deadline (IST)</th><th>Availability</th><th>Publishing</th><th>Action</th></tr></thead><tbody><% calls.forEach(call=>{ %><tr><td><%= call.title %></td><td><%= call.production_title %></td><td><%= call.location %></td><td><%= call.deadline %></td><td><%= call.call_state==='closed'||call.deadline<today?'closed':'open' %></td><td><%= call.status %></td><td><a href="/admin/casting/<%= call.id %>">Edit</a></td></tr><% }) %></tbody></table></div><% if(!calls.length){ %><p>No casting calls yet. Create a draft to begin.</p><% } %><nav aria-label="Casting call pages"><% if(page>1){ %><a href="?status=<%= status %>&page=<%= page-1 %>">Previous</a><% } %> Page <%= page %> <% if(hasMore){ %><a href="?status=<%= status %>&page=<%= page+1 %>">Next</a><% } %></nav><%- include('foot') %>
