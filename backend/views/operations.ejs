<%- include('head') %>
<p class="eyebrow">SYSTEM OPERATIONS</p><h1>Housekeeping, retention & backups</h1>
<div class="dashboard-grid"><section class="panel"><h2>Personal-data retention</h2><p>Automatic deletion: <strong><%= policy.enabled?'Enabled':'Disabled' %></strong></p><p>Policy version: <%= policy.version || 'Awaiting approval' %></p><p>Closed/rejected/spam enquiries: <%= policy.enquiry?policy.enquiry+' days after last update':'Not configured' %> · <%= preview.enquiry %> eligible</p><p>Rejected career applications: <%= policy.application?policy.application+' days after last update':'Not configured' %> · <%= preview.application %> eligible</p><p>Active records and records on retention hold are excluded. Configure approved periods through protected hosting settings. No deletion is performed by opening this page.</p></section><section class="panel"><h2>Backup configuration</h2><p>Scheduled backups: <strong><%= backupEnabled?'Enabled':'Disabled' %></strong></p><p>Separate destination: <%= offsiteConfigured?'Configured; inspect successful backup results to confirm copying':'Not configured' %></p><p>Daily database and weekly application/content archives are encrypted. Keep the encryption key and session secret separately in KEMSOR-controlled secure storage. Run a recovery drill before relying on backups.</p><p>Private files waiting for deletion: <%= pendingFiles %></p></section></div>
<section class="panel"><h2>Recent jobs</h2><% if(!runs.length){ %><p>No operations have run yet.</p><% } %><% runs.forEach(run=>{ %><article class="note"><h3><%= run.job %> · <%= run.status %></h3><small><%= run.started_at %> UTC — <%= run.finished_at || 'Running' %></small><p class="pre-line"><%= typeof run.summary==='string'?run.summary:JSON.stringify(run.summary) %></p></article><% }) %></section>
<%- include('foot') %>
