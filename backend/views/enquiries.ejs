<%- include('head') %><p class="eyebrow">FOLLOW-UP / INBOX</p><nav class="filters" aria-label="Enquiry sections"><a class="button quiet" href="/admin/enquiries" <%- section==='contact'?'aria-current="page"':'' %>>Contact page enquiries</a><a class="button quiet" href="/admin/enquiries?section=other" <%- section==='other'?'aria-current="page"':'' %>>Other enquiries</a><a class="button quiet" href="/admin/applications">Career applications</a><% if(user.role==='admin'){ %><a class="button quiet" href="/admin/talent/enquiries">Talent enquiries</a><% } %></nav><p><a class="button quiet" href="/admin/enquiries/export.csv?section=<%= section %>&status=<%= encodeURIComponent(state) %>&category=<%= encodeURIComponent(category) %>&q=<%= encodeURIComponent(search) %>">Export filtered enquiries (CSV)</a></p><h1><%= section==='contact'?'Contact page enquiries.':'Other enquiries.' %></h1><p><%= section==='contact'?'All enquiry types submitted through the Contact page, including partner contact forms.':'Studio enquiries from other sources, including older records without a recorded Contact page source.' %></p><form class="filters" method="get"><input type="hidden" name="section" value="<%= section %>"><input type="hidden" name="sort" value="<%= table.sort %>"><input type="hidden" name="dir" value="<%= table.dir %>"><input type="hidden" name="per_page" value="<%= table.limit %>"><label>Search<input name="q" value="<%= search %>" maxlength="100" placeholder="Name, email, subject, tags or source"></label><label>Status<select name="status"><option value="">All</option><% statuses.forEach(item=>{ %><option value="<%= item %>" <%= state===item?'selected':'' %>><%= item.replace('_',' ') %></option><% }) %></select></label><label>Enquiry type<select name="category"><option value="">All enquiry types</option><% Object.entries(categories).forEach(([key,label])=>{ %><option value="<%= key %>" <%= category===key?'selected':'' %>><%= label %></option><% }) %></select></label><button>Filter</button></form><%- include('table-tools',{resource:'enquiries',actions:statuses.map(s=>[s,s.replace('_',' ')])}) %><div class="table-wrap"><table><thead><tr><th class="table-selection-cell"><input type="checkbox" data-select-page aria-label="Select all rows on this page"></th><%- include('table-heading',{label:'Reference / sender',column:'name'}) %><%- include('table-heading',{label:'Subject',column:'subject'}) %><%- include('table-heading',{label:'Category',column:'category'}) %><%- include('table-heading',{label:'Status',column:'status'}) %><%- include('table-heading',{label:'Received',column:'received'}) %><th>Action</th></tr></thead><tbody><% enquiries.forEach(e=>{ %><tr><td class="table-selection-cell"><input type="checkbox" name="ids" value="<%= e.id %>" form="table-bulk-form" data-row-select aria-label="Select record <%= e.id %>"></td><td><a href="/admin/enquiries/<%= e.id %>">KEM-<%= String(e.id).padStart(6,'0') %></a><small><%= e.name %><br><%= e.email %></small></td><td><%= e.subject %></td><td><%= categories[e.category] %></td><td><span class="badge"><%= e.status.replace('_',' ') %></span></td><td><%= e.created_at %> UTC</td><td><a class="button quiet" href="/admin/enquiries/<%= e.id %>" aria-label="View enquiry KEM-<%= String(e.id).padStart(6,'0') %>">View enquiry</a></td></tr><% }) %></tbody></table></div><% if(!enquiries.length){ %><p class="empty">No matching enquiries.</p><% } %><%- include('table-pagination') %><%- include('foot') %>