<%- include('head') %><p class="eyebrow">FOLLOW-UP / INBOX</p><h1>Enquiry workspace.</h1><form class="filters" method="get"><label>Search<input name="q" value="<%= search %>" maxlength="100" placeholder="Name, email or subject"></label><label>Status<select name="status"><option value="">All</option><% statuses.forEach(item=>{ %><option value="<%= item %>" <%= state===item?'selected':'' %>><%= item.replace('_',' ') %></option><% }) %></select></label><label>Category<select name="category"><option value="">All</option><% Object.entries(categories).forEach(([key,label])=>{ %><option value="<%= key %>" <%= category===key?'selected':'' %>><%= label %></option><% }) %></select></label><button>Filter</button></form><div class="table-wrap"><table><thead><tr><th>Reference / sender</th><th>Subject</th><th>Category</th><th>Status</th><th>Received</th></tr></thead><tbody><% enquiries.forEach(e=>{ %><tr><td><a href="/admin/enquiries/<%= e.id %>">KEM-<%= String(e.id).padStart(6,'0') %></a><small><%= e.name %><br><%= e.email %></small></td><td><%= e.subject %></td><td><%= categories[e.category] %></td><td><span class="badge"><%= e.status.replace('_',' ') %></span></td><td><%= e.created_at %></td></tr><% }) %></tbody></table></div><% if(!enquiries.length){ %><p class="empty">No matching enquiries.</p><% } %><%- include('foot') %>