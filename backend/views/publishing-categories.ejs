<%- include('head') %>
<div class="heading-row"><div><p class="eyebrow">Publishing</p><h1><%= categoryLabel %> categories</h1><p>Create reusable categories and delete unused ones.</p></div><a class="button quiet" href="/admin/content?type=<%= categoryType %>">Back to <%= categoryType==='blog'?'blogs':'news' %></a></div>
<form action="<%= categoryBase %>/manage" method="post" class="panel"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Add category</h2><label>Category name<input name="name" required maxlength="100" autocomplete="off"></label><button class="admin-save">Save category</button></form>
<form class="filters" method="get"><label>Search categories<input name="q" value="<%= search %>" maxlength="100" type="search"></label><button>Apply</button><a class="button quiet" href="<%= categoryBase %>/manage">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th scope="col">Category</th><th scope="col">Posts using category</th><th scope="col">Action</th></tr></thead><tbody><% categoryRows.forEach(category=>{ %><tr><td><%= category.name %></td><td><%= category.uses %></td><td><% if(Number(category.uses)){ %><span>In use</span><small>Remove this category from its posts before deleting.</small><% }else{ %><form action="<%= categoryBase %>/<%= category.id %>/delete" method="post" data-confirm="Delete category &quot;<%= category.name %>&quot;? It will no longer be available for new posts."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="delete-blog">Delete</button></form><% } %></td></tr><% }) %><% if(!categoryRows.length){ %><tr><td colspan="3"><%= search?'No categories match your search.':'No categories yet. Add your first category above or use quick add in the post editor.' %></td></tr><% } %></tbody></table></div>
<p class="muted">Categories used by draft, published or archived posts cannot be deleted. Saved revisions keep historical category names.</p>
<%- include('foot') %>
