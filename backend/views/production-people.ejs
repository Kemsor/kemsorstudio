<%- include('head') %><div class="heading-row"><h1>Production people</h1><a class="button" href="/admin/people/new">Add person</a></div><p>Reusable cast, crew and contributor biographies. Link these profiles from production credits.</p><div class="table-wrap"><table><thead><tr><th>Name</th><th>Profession</th><th>Status</th><th>Action</th></tr></thead><tbody><% people.forEach(person=>{ %><tr><td><%= person.name %></td><td><%= person.profession %></td><td><%= person.status %></td><td><a href="/admin/people/<%= person.id %>">Edit</a></td></tr><% }) %></tbody></table></div><nav aria-label="People pages"><% if(page>1){ %><a href="?page=<%= page-1 %>">Previous</a><% } %> Page <%= page %> <% if(hasMore){ %><a href="?page=<%= page+1 %>">Next</a><% } %></nav><%- include('foot') %>
