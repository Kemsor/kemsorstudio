<%- include('head') %>
<p><a class="button quiet" href="<%= back %>">Back to record</a></p>
<p class="eyebrow"><%= reference %> / EMAIL REPLY</p><h1>Reply by email</h1>
<% if(queued){ %><p class="notice" role="status">Your reply is queued. Check its delivery status below.</p><% } %>
<div class="dashboard-grid"><section class="panel"><h2>Original message</h2><p><strong><%= record.name %></strong><br><%= record.email %></p><h3><%= record.subject %></h3><p class="pre-line"><%= record.message %></p></section>
<form class="panel" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="reply_token" value="<%= replyToken %>"><h2>Write a reply</h2><p>To: <strong><%= record.email %></strong></p><p>Replies use the configured studio email account.</p><% if(!configuration.enabled){ %><p role="status"><%= configuration.message %></p><% } %><fieldset <%= !configuration.enabled?'disabled':'' %>><label>Subject<input name="subject" maxlength="200" required value="<%= ('Re: '+record.subject+' | '+reference).slice(0,200) %>"></label><label>Your reply<textarea name="message" rows="10" maxlength="8000" required placeholder="Write your response to the sender…"></textarea></label><p>This message will be emailed to the address above.</p><button type="submit">Send email reply</button></fieldset></form></div>
<section class="panel"><h2>Reply history</h2><p>Sent means the email service accepted the message; inbox delivery is not confirmed. Refresh to update statuses.</p><% if(!replies.length){ %><p>No replies yet.</p><% } %><% replies.forEach(reply=>{ %><article class="note"><h3><%= reply.subject %></h3><p>To: <%= reply.recipient %> · <span class="badge"><%= reply.status %></span></p><p class="pre-line"><%= reply.body %></p><small>Queued <%= reply.created_at %> UTC<% if(reply.sent_at){ %> · Sent <%= reply.sent_at %> UTC<% } %></small><% if(reply.last_error){ %><p role="status"><%= reply.last_error %></p><% } %></article><% }) %></section>
<%- include('foot') %>
