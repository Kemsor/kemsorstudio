<%- include('head') %>
<p class="eyebrow">News publishing</p><h1><%= entry.id?'Edit news post':'Create news post' %></h1>
<form action="/admin/news/save" method="post" enctype="multipart/form-data" class="panel editor news-editor">
<input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= entry.id || '' %>"><input type="hidden" name="type" value="news">
<%- include('publishing-toolbar') %><div class="field-grid">
<label>News title<input name="title" value="<%= entry.title || '' %>" required maxlength="200"></label>
<label>Slug (automatic)<input data-auto-slug data-existing-slug="<%= entry.slug || '' %>" value="<%= entry.slug || '' %>" readonly placeholder="Generated from the title"><small><%= entry.id?'Kept unchanged to preserve existing links.':'Generated on save; duplicate titles receive a number.' %></small></label>
<label class="wide">Summary<textarea name="summary" rows="3" maxlength="2000"><%= entry.summary || '' %></textarea></label>
<label class="wide">News content<textarea name="body" rows="16" maxlength="60000"><%= entry.body || '' %></textarea><small>Separate paragraphs with a blank line. Content is published as plain text.</small></label>
<div class="wide blog-banner-fields"><h2>News banner</h2>
<% if(entry.image_id){ %><img class="blog-banner-preview" src="/media/<%= entry.image_id %>" alt="Current news banner"><% } %>
<label>Upload banner<input type="file" name="image" accept="image/png,image/jpeg,image/webp" data-blog-banner><small>PNG, JPEG or WebP, up to 5 MB. A new upload replaces the selected banner.</small></label>
<label>Banner description<input name="banner_alt" maxlength="300" data-banner-alt><small>Describe the uploaded image for readers using assistive technology.</small></label>
<label>Or choose from the image library<select name="image_id" data-library-banner><option value="">No banner</option><% media.forEach(image=>{ %><option value="<%= image.id %>" <%= entry.image_id===image.id?'selected':'' %>><%= image.original_name %> · <%= image.alt %></option><% }) %></select></label><div class="library-banner-selection" hidden><img alt="Selected banner" data-selected-banner><button type="button" class="quiet" data-selected-preview>Preview banner</button></div></div>
<label>Publishing status<select name="status"><% ['draft','published','archived'].forEach(status=>{ %><option value="<%= status %>" <%= entry.status===status?'selected':'' %>><%= status %></option><% }) %></select></label>
</div><div class="form-actions"><button class="quiet" name="publish_action" value="draft">Save draft</button><button name="publish_action" value="published">Publish news post</button><% if(entry.id){ %><button class="quiet">Save selected status</button><% } %></div>
</form><p><a class="button quiet" href="/admin/content?type=news">Back to news</a></p>
<%- include('image-preview') %><%- include('foot') %>
