<%- include('head') %>
<div class="heading-row"><div><p class="eyebrow">REPORTING CENTRE</p><h1>Reports & downloads</h1><p>Choose a report to review records, apply filters and download a CSV. Each report has its own page.</p></div></div>
<% if(['admin','enquiry_manager'].includes(user.role)){ %><section class="panel"><h2>KPI & outcome reporting</h2><p>Weekly scorecards, monthly management reports and quarterly strategic reviews with targets, source evidence, corrective actions and approved snapshots.</p><a class="button" href="/admin/kpi">Open KPI dashboard</a></section><% } %><div class="admin-page-grid report-directory"><% reports.forEach(report=>{ %><a class="panel admin-page-card" href="/admin/reports/<%= report.key %>"><span class="admin-page-icon"><%- include('icon',{name:report.icon}) %></span><h2><%= report.label %></h2><p><%= report.description %></p><span>Open report</span></a><% }) %></div>
<p class="form-help">Only reports available to your role are shown. The record reports below are operational exports. Management scorecards are available separately in KPI & outcomes.</p>
<%- include('foot') %>
