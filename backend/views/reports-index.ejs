<%- include('head') %>
<div class="heading-row"><div><p class="eyebrow">REPORTING CENTRE</p><h1>Reports & downloads</h1><p>Choose a report to review records, apply filters and download a CSV. Each report has its own page.</p></div></div>
<div class="admin-page-grid report-directory"><% reports.forEach(report=>{ %><a class="panel admin-page-card" href="/admin/reports/<%= report.key %>"><span class="admin-page-icon"><%- include('icon',{name:report.icon}) %></span><h2><%= report.label %></h2><p><%= report.description %></p><span>Open report</span></a><% }) %></div>
<p class="form-help">Only reports available to your role are shown. These are operational records; they do not represent website analytics or weekly KPI reporting.</p>
<%- include('foot') %>
