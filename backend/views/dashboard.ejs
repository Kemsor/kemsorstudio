<%- include('head') %>
<div class="dashboard-heading"><div><p class="eyebrow">THE CONTROL ROOM / OVERVIEW</p><h1>Let’s make something great.</h1><p class="lead">Welcome back, <%= user.name.split(' ')[0] %>. Here’s what’s happening in your studio.</p></div><a class="preview-button" href="<%= websiteUrl %>" target="_blank" rel="noopener"><%- include('icon',{name:'external'}) %>Preview website</a></div>
<section class="studio-welcome"><div><span class="welcome-tag"><span class="status-dot"></span>YOUR NEXT CHAPTER</span><h2>Big ideas.<br>Beautifully managed.</h2><p>A home for your stories, your people<br>and the conversations that come next.</p><div class="welcome-actions"><% if(publishing){ %><a class="button" href="/admin/content/new?type=blog">Create a story <span aria-hidden="true">↗</span></a><a href="/admin/content?type=all&status=draft">Continue a draft →</a><% }else{ %><a class="button" href="/admin/enquiries">Open the inbox ↗</a><% } %></div></div><div class="welcome-art" aria-hidden="true"><svg viewBox="0 0 440 280" fill="none"><path d="m250 120 170-75v200l-170-75Z" fill="currentColor" opacity=".08"/><circle cx="150" cy="95" r="67" stroke="currentColor" stroke-width="1.5"/><circle cx="150" cy="95" r="49" stroke="currentColor" stroke-dasharray="3 8"/><circle cx="150" cy="95" r="10" fill="currentColor"/><circle cx="150" cy="64" r="15" stroke="currentColor"/><circle cx="121" cy="108" r="15" stroke="currentColor"/><circle cx="177" cy="110" r="15" stroke="currentColor"/><circle cx="265" cy="88" r="44" stroke="currentColor"/><circle cx="265" cy="88" r="29" stroke="currentColor" stroke-dasharray="3 6"/><circle cx="265" cy="88" r="8" fill="currentColor"/><path d="M104 162h181v58H104zm72 58-30 39m64-39 30 39M285 177l29-15v58l-29-15" stroke="currentColor" stroke-width="1.5"/><path d="M43 36h28M57 22v28m290 174h22m-11-11v22" stroke="currentColor"/><path d="M17 251h92m179 0h114" stroke="currentColor" opacity=".4"/></svg><span class="art-caption">IDEA → FRAME → AUDIENCE</span></div></section>
<div class="metric-grid"><% metrics.forEach(metric=>{ %><a href="<%= metric.href %>" class="metric-card tone-<%= metric.tone %>"><div><span class="metric-label"><%= metric.label %></span><span class="metric-icon" aria-hidden="true"><%= metric.icon %></span></div><strong><%= metric.value %></strong><span class="metric-hint"><%= metric.hint %><span aria-hidden="true">↗</span></span></a><% }) %></div>
<div class="dashboard-work-grid"><div>
<% if(user.role==='admin'){ %><section class="panel dashboard-panel"><div class="panel-heading"><div><p class="eyebrow">TALENT NETWORK</p><h2>Latest registrations</h2></div><a href="/admin/talent">Manage all ↗</a></div><% if(!recentRegistrations.length){ %><p class="empty">Artist, crew and hirer sign-ups will appear here automatically.</p><% } %><div class="recent-list"><% recentRegistrations.forEach(a=>{ %><a class="recent-item" href="/admin/talent?q=<%= encodeURIComponent(a.name) %>"><span class="sender-avatar"><%= a.name.slice(0,1) %></span><div><strong><%= a.name %></strong><small><%= a.role==='artist'?'Artist / crew':'Casting director / producer' %> · <%= a.created_at %> UTC</small></div><span class="badge badge-<%= a.status %>"><%= a.status %></span></a><% }) %></div></section><% } %>
<% if(publishing){ %><section class="panel dashboard-panel"><div class="panel-heading"><div><p class="eyebrow">THE EDITING ROOM</p><h2>Recent content</h2></div><a href="/admin/content?type=all">View all ↗</a></div><% if(!recentContent.length){ %><p class="empty">Your first story starts with a draft.</p><% } %><div class="recent-list"><% recentContent.forEach(entry=>{ %><a class="recent-item" href="/admin/content/<%= entry.id %>"><span class="content-symbol symbol-<%= entry.type %>"><%- include('icon',{name:entry.type}) %></span><div><strong><%= entry.title %></strong><small><%= types[entry.type] %> · <%= entry.editor || 'Studio team' %></small></div><span class="badge badge-<%= entry.status %>"><%= entry.status %></span><span class="item-arrow" aria-hidden="true">↗</span></a><% }) %></div></section><% } %>
<% if(inbox){ %><section class="panel dashboard-panel"><div class="panel-heading"><div><p class="eyebrow">LET’S TALK</p><h2>Latest conversations</h2></div><a href="/admin/enquiries">Open inbox ↗</a></div><% if(!recentEnquiries.length){ %><div class="inbox-empty"><span aria-hidden="true">✉</span><h3>Room for the next conversation.</h3><p>New studio enquiries will appear here.</p><% if(user.role==='admin'){ %><a href="/admin/settings">Manage enquiry settings →</a><% } %></div><% } %><div class="recent-list"><% recentEnquiries.forEach(e=>{ %><a class="recent-item" href="/admin/enquiries/<%= e.id %>"><span class="sender-avatar"><%= e.name.slice(0,1) %></span><div><strong><%= e.subject %></strong><small><%= e.name %> · <%= categories[e.category] %></small></div><span class="badge badge-<%= e.status %>"><%= e.status.replace('_',' ') %></span></a><% }) %></div></section><% } %>
<section class="panel dashboard-panel"><div class="panel-heading"><div><p class="eyebrow">MOMENTUM / LAST 7 DAYS</p><h2>Studio activity</h2></div><span class="activity-total"><%= weeklyTotal %><small>recorded actions</small></span></div><% const maximum=Math.max(1,...series.map(d=>d.total)); %><svg class="activity-chart" viewBox="0 0 560 180" role="img" aria-label="<%= series.map(d=>d.label+': '+d.total+' actions').join(', ') %>"><path d="M20 135h520M20 90h520M20 45h520" stroke="#eceaf1"/><% series.forEach((day,index)=>{ const height=day.total/maximum*100; %><rect x="<%= 32+index*76 %>" y="<%= 135-height %>" width="36" height="<%= height %>" rx="7" fill="<%= index===6?'#9c7bf5':'#ded4fa' %>"/><text x="<%= 50+index*76 %>" y="<%= 125-height %>" text-anchor="middle" fill="#5f5675" font-size="11"><%= day.total %></text><text x="<%= 50+index*76 %>" y="163" text-anchor="middle" fill="#847c91" font-size="11"><%= day.label %></text><% }) %></svg><p class="chart-caption"><%= user.role==='admin' ? 'Workspace' : 'Your' %> recorded actions, including sign-ins and content or enquiry updates. Daily totals use UTC.</p></section></div>
<aside class="dashboard-aside"><section class="panel dashboard-panel quick-create"><p class="eyebrow">MAKE YOUR NEXT MOVE</p><h2>Quick actions</h2><% const shortcuts=publishing?[['New blog story','blog','/admin/content/new?type=blog'],['Studio announcement','news','/admin/content/new?type=news'],['Add a team profile','team','/admin/content/new?type=team'],['Upload an image','media','/admin/media']]:[['Review new enquiries','enquiries','/admin/enquiries?status=new'],['Follow up','audit','/admin/enquiries?status=in_review']]; shortcuts.forEach(([label,icon,href])=>{ %><a href="<%= href %>"><span><%- include('icon',{name:icon}) %></span><%= label %><b aria-hidden="true">↗</b></a><% }) %></section>
<section class="panel dashboard-panel"><div class="panel-heading"><h2>Needs your attention</h2><span class="mini-count"><%= unreadCount %></span></div><%- include('notification-items',{limit:3,actions:false}) %><a class="attention-link" href="/admin/notifications">All notifications →</a></section>
<section class="panel dashboard-panel"><div class="panel-heading"><h2>On the record</h2><% if(user.role==='admin'){ %><a href="/admin/audit">All ↗</a><% } %></div><ol class="activity-feed"><% activity.forEach(event=>{ %><li><span class="timeline-dot"></span><strong><%= event.name || (event.target_type==='talent'?'Talent member':'Studio team') %></strong><p><%= event.action.replaceAll('_',' ') %> · <%= event.target_type %></p><small><%= event.created_at %> UTC</small></li><% }) %></ol><% if(!activity.length){ %><p>No recorded activity yet.</p><% } %></section>
<% if(publishing){ %><a class="library-card" href="/admin/media"><span aria-hidden="true">✦</span><h3>Your visual world.</h3><p><strong><%= media %></strong> images in the library.</p><span>Explore the library ↗</span></a><% } %></aside></div>
<%- include('foot') %>
