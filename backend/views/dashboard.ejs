<%- include('head') %>
<div class="dashboard-colour-theme">
<div class="dashboard-breadcrumb"><span>Workspace</span><span aria-hidden="true">/</span><strong>Overview</strong></div>
<div class="dashboard-heading"><div><p class="eyebrow">STUDIO OVERVIEW</p><h1>Studio dashboard</h1><p class="lead">Welcome back, <%= user.name.split(' ')[0] %>. Here’s what’s happening at the studio.</p></div><div class="dashboard-heading-actions"><span class="dashboard-period"><%- include('icon',{name:'calendar'}) %>Last 7 days</span><% if(publishing){ %><a class="button" href="/admin/content/new?type=blog"><%- include('icon',{name:'plus'}) %>New story</a><% }else if(inbox){ %><a class="button" href="/admin/enquiries?section=all"><%- include('icon',{name:'enquiries'}) %>Open inbox</a><% } %></div></div>
<div class="dashboard-primary-grid"><div class="dashboard-primary-overview">
<section class="studio-welcome"><div><span class="welcome-tag"><span class="status-dot"></span>STUDIO WORKSPACE</span><h2>Manage your studio</h2><p><%= attentionTotal?attentionTotal+' '+(attentionTotal===1?'record needs':'records need')+' review. Start with the queues below.':'Your review queues are clear. Keep the studio moving with your quick actions.' %></p></div><div class="welcome-actions"><% if(nextTask){ %><a href="<%= nextTask.href %>">Start next review<%- include('icon',{name:'external'}) %></a><% } %><a href="/admin/profile">My profile<%- include('icon',{name:'external'}) %></a></div></section>
<%- include('dashboard-attention') %>
</div><%- include('activity-chart') %></div>
<div class="dashboard-secondary-overview">
<div class="metric-grid dashboard-summary-metrics"><% metrics.filter(metric=>!attentionTasks.includes(metric)).forEach(metric=>{ %><a href="<%= metric.href %>" class="metric-card tone-<%= metric.tone %>"><div><span class="metric-label"><%= metric.label %></span><span class="metric-icon" aria-hidden="true"><%- include('icon',{name:metric.icon}) %></span></div><strong><%= metric.value %></strong><span class="metric-hint"><%= metric.hint %></span></a><% }) %></div>
<%- include('status-breakdown') %></div>
<div class="dashboard-work-grid"><div>
<% if(user.role==='admin'){ %><section class="panel dashboard-panel"><div class="panel-heading"><div><p class="eyebrow">TALENT NETWORK</p><h2>Latest registrations</h2></div><a href="/admin/talent">Manage all </a></div><% if(!recentRegistrations.length){ %><p class="empty">Artist, crew and professional sign-ups will appear here automatically.</p><% } %><div class="recent-list"><% recentRegistrations.forEach(a=>{ %><a class="recent-item" href="/admin/talent/<%= a.id %>"><span class="sender-avatar"><%= a.name.slice(0,1) %></span><div><strong><%= a.name %></strong><small><%= a.role==='artist'?'Artist / crew':(a.specialty||'Film professional') %> · <%= a.created_at %> UTC</small></div><span class="badge badge-<%= a.status %>"><%= a.status %></span></a><% }) %></div></section><% } %>
<% if(publishing){ %><section class="panel dashboard-panel"><div class="panel-heading"><div><p class="eyebrow">PUBLISHING</p><h2>Recent content</h2></div><a href="/admin/content?type=all">View all </a></div><% if(!recentContent.length){ %><div class="dashboard-empty"><strong>Your next story starts here.</strong><p>Create a draft and preview it before publishing.</p><a class="button quiet" href="/admin/content/new?type=blog">Create a draft</a></div><% } %><div class="recent-list"><% recentContent.forEach(entry=>{ %><a class="recent-item" href="/admin/content/<%= entry.id %>"><span class="content-symbol symbol-<%= entry.type %>"><%- include('icon',{name:entry.type}) %></span><div><strong><%= entry.title %></strong><small><%= types[entry.type] %> · <%= entry.editor || 'Studio team' %></small></div><span class="badge badge-<%= entry.status %>"><%= entry.status %></span></a><% }) %></div></section><% } %>
<% if(inbox){ %><section class="panel dashboard-panel"><div class="panel-heading"><div><p class="eyebrow">ENQUIRIES</p><h2>Latest conversations</h2></div><a href="/admin/enquiries?section=all">Open inbox </a></div><% if(!recentEnquiries.length){ %><div class="inbox-empty"><span aria-hidden="true"><%- include('icon',{name:'enquiries'}) %></span><h3>No new enquiries</h3><p>New studio enquiries will appear here.</p><% if(user.role==='admin'){ %><a href="/admin/settings">Manage enquiry settings </a><% } %></div><% } %><div class="recent-list"><% recentEnquiries.forEach(e=>{ %><a class="recent-item" href="/admin/enquiries/<%= e.id %>"><span class="sender-avatar"><%= e.name.slice(0,1) %></span><div><strong><%= e.subject %></strong><small><%= e.name %> · <%= categories[e.category] %></small></div><span class="badge badge-<%= e.status %>"><%= e.status.replace('_',' ') %></span></a><% }) %></div></section><% } %>
</div>
<aside class="dashboard-aside"><section class="panel dashboard-panel quick-create"><p class="eyebrow">SHORTCUTS</p><h2>Quick actions</h2><% shortcuts.forEach(([label,icon,href])=>{ %><a href="<%= href %>"><span><%- include('icon',{name:icon}) %></span><%= label %></a><% }) %></section>
<section class="panel dashboard-panel"><div class="panel-heading"><h2>Unread updates</h2><span class="mini-count"><%= unreadCount %></span></div><%- include('notification-items',{notifications:notifications.filter(item=>!item.read&&item.active),limit:3,actions:false}) %><a class="attention-link" href="/admin/notifications?view=unread">View unread updates </a></section>
<section class="panel dashboard-panel"><div class="panel-heading"><h2>Recent activity</h2><% if(user.role==='admin'){ %><a href="/admin/audit">All </a><% } %></div><ol class="activity-feed"><% activity.forEach(event=>{ %><li><span class="timeline-dot"></span><strong><%= event.actor %></strong><p><%= event.actionLabel %> · <% if(event.href){ %><a class="activity-record-link" href="<%= event.href %>"><%= event.recordTitle %></a><% }else{ %><%= event.recordTitle %><% } %></p><small><time datetime="<%= event.created_at.replace(' ','T') %>Z"><%= event.created_at %> UTC</time></small></li><% }) %></ol><% if(!activity.length){ %><p class="empty">Your admin actions will appear here as you work.</p><% } %></section>
<% if(publishing){ %><a class="library-card" href="/admin/media"><span aria-hidden="true"><%- include('icon',{name:'media'}) %></span><h3>Image library</h3><p><strong><%= media %></strong> images in the library.</p><span>Explore the library </span></a><% } %></aside></div>
</div>
<%- include('foot') %>
