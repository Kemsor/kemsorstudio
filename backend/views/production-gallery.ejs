<section class="wide" data-production-gallery>
<h2>Production gallery</h2><p>Upload an image for each gallery item. Alt text and captions are optional. Up to 24 images; use the arrows to change their order.</p>
<input type="hidden" name="gallery" value="<%= JSON.stringify(entry.metadata.gallery||[]) %>" data-gallery-value>
<div data-gallery-rows></div><button type="button" data-gallery-add>Add gallery image</button><p data-gallery-status role="status"></p>
<template data-gallery-row><fieldset><legend>Gallery image</legend><label>Image<select data-gallery-field="media_id" required><option value="">Choose an image</option><% media.forEach(image=>{ %><option value="<%= image.id %>"><%= image.original_name %> · <%= image.alt %></option><% }) %></select></label><img data-gallery-preview alt="" width="160" hidden><label>Image type<select data-gallery-field="kind"><option value="still">Production still</option><option value="behind_the_scenes">Behind the scenes</option></select></label><label>Alt text (optional)<input data-gallery-field="alt" maxlength="300"></label><label>Caption<input data-gallery-field="caption" maxlength="500"></label><div><button type="button" data-gallery-up aria-label="Move image up">↑ Move up</button> <button type="button" data-gallery-down aria-label="Move image down">↓ Move down</button> <button type="button" data-gallery-remove>Remove image</button></div></fieldset></template>
<noscript><p>Enable JavaScript to edit the gallery. Existing gallery images will be kept when saving.</p></noscript>
</section><script src="/production-gallery.js?v=3" defer></script>
