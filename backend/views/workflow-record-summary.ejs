<% const currentOwner=users.find(person=>Number(person.id)===Number(record.assigned_to)); %><div class="workflow-record-summary"><div><span>Owner</span><strong><%= currentOwner?currentOwner.name+(currentOwner.active===0?' (inactive)':''):'Unassigned' %></strong></div><div><span>Priority</span><strong class="workflow-priority priority-<%= record.priority||'normal' %>"><%= record.priority||'normal' %></strong></div><div><span>Follow-up · UTC</span><strong class="due-<%= followUp.key %>"><%= followUp.label %></strong><small><%= record.follow_up_at||'No date set' %></small></div><div><span>Next action</span><strong><%= record.next_action||'Add the next step in the review form' %></strong></div></div>
