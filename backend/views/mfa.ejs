<%- include('head') %><div class="login-panel"><p class="eyebrow">SECURE WORKSPACE</p><h1><%= secret ? 'Set up two-step sign-in' : 'Verify your sign-in' %></h1><% if(secret){ %><p>Add this account to an authenticator app using the setup key below. Keep the key private.</p><p>Account: <%= account %><br>Issuer: Kemsor Studios</p><code class="pre-line"><%= secret %></code><p>Time-based code · 6 digits · 30-second interval · SHA-1</p><% } else { %><p>Enter the code from your authenticator app, or one unused recovery code.</p><% } %><form method="post" action="/admin/mfa"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Verification code<input name="code" required maxlength="40" autocomplete="one-time-code" autofocus></label><button>Verify and continue</button></form><p><a href="/admin/login">Return to sign in</a></p></div><%- include('foot') %>
