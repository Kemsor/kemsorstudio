<%- include('head') %>
<p><a class="text-link" href="/admin/reports">All reports</a></p>
<div class="heading-row"><div><p class="eyebrow">STUDIO OPERATIONS</p><h1><%= report.label %> report</h1><p><%= report.description %> Dates and times are UTC.</p></div><a class="button" href="<%= downloadUrl %>" download>Download CSV</a></div>
<nav class="report-type-links" aria-label="Report types"><% reportOptions.forEach(option=>{ %><a href="/admin/reports/<%= option.value %>" <%- reportType===option.value?'aria-current="page"':'' %>><%= option.label %></a><% }) %></nav>
<form class="filters report-filters" method="get" action="<%= reportUrl %>"><label>From<input type="date" name="from" value="<%= filters.from %>" required></label><label>To<input type="date" name="to" value="<%= filters.to %>" required></label><% if(report.statuses.length){ %><label>Status<select name="status"><option value="">All statuses</option><% report.statuses.forEach(status=>{ %><option value="<%= status %>" <%= filters.status===status?'selected':'' %>><%= status.replaceAll('_',' ') %></option><% }) %></select></label><% } %><% if(reportType==='enquiries'){ %><label>Enquiry category<select name="category"><option value="">All categories</option><% Object.entries(categories).forEach(([value,label])=>{ %><option value="<%= value %>" <%= filters.category===value?'selected':'' %>><%= label %></option><% }) %></select></label><% } %><label>Search<input name="q" maxlength="100" value="<%= filters.q %>"></label><label>Rows per page<select name="per_page"><% [25,50,100].forEach(value=>{ %><option value="<%= value %>" <%= perPage===value?'selected':'' %>><%= value %></option><% }) %></select></label><button>Apply filters</button><a class="button quiet" href="<%= reportUrl %>">Reset</a></form>
<section class="report-summary" aria-label="Report totals"><article class="panel"><strong><%= total %></strong><span>Total matching records</span></article><% summary.forEach(item=>{ %><article class="panel"><strong><%= item.total %></strong><span><%= String(item.label||'Unspecified').replaceAll('_',' ') %></span></article><% }) %></section>
<section class="panel"><h2><%= report.label %></h2><p>Showing <%= records.length %> of <%= total %> matching records. Downloads include all matching rows, up to 50,000.</p><div class="report-table-scroll"><table><thead><tr><% report.columns.forEach(column=>{ %><th scope="col"><%= column.replaceAll('_',' ') %></th><% }) %></tr></thead><tbody><% records.forEach(record=>{ %><tr><% report.columns.forEach(column=>{ %><td><%= record[column] ?? '—' %></td><% }) %></tr><% }) %></tbody></table></div><% if(!records.length){ %><p>No records match these filters.</p><% } %><% if(pages>1){ %><nav class="table-pagination" aria-label="Report pages"><% if(page>1){ %><a class="button quiet" href="<%= pageUrl(page-1) %>">Previous</a><% } %><span>Page <%= page %> of <%= pages %></span><% if(page<pages){ %><a class="button quiet" href="<%= pageUrl(page+1) %>">Next</a><% } %></nav><% } %></section>
<%- include('foot') %>
