<%- include('head') %>
<div class="heading-row"><div><p class="eyebrow">STUDIO OPERATIONS</p><h1>Reports</h1><p>Filter CMS records and download a spreadsheet-ready CSV. Dates and times are UTC.</p></div><a class="button" href="<%= downloadUrl %>" download>Download CSV</a></div>
<form class="filters report-filters" method="get" action="/admin/reports"><label>Report<select name="type"><% reportOptions.forEach(option=>{ %><option value="<%= option.value %>" <%= reportType===option.value?'selected':'' %>><%= option.label %></option><% }) %></select></label><label>From<input type="date" name="from" value="<%= filters.from %>" required></label><label>To<input type="date" name="to" value="<%= filters.to %>" required></label><label>Status<select name="status"><option value="">All statuses</option><% report.statuses.forEach(status=>{ %><option value="<%= status %>" <%= filters.status===status?'selected':'' %>><%= status.replaceAll('_',' ') %></option><% }) %></select></label><label>Enquiry category<select name="category" <%= reportType!=='enquiries'?'disabled':'' %>><option value="">All categories</option><% Object.entries(categories).forEach(([value,label])=>{ %><option value="<%= value %>" <%= filters.category===value?'selected':'' %>><%= label %></option><% }) %></select></label><label>Search<input name="q" maxlength="100" value="<%= filters.q %>"></label><button>Apply filters</button><a class="button quiet" href="/admin/reports?type=<%= reportType %>">Reset</a></form>
<section class="report-summary" aria-label="Report totals"><article class="panel"><strong><%= total %></strong><span>Total matching records</span></article><% summary.forEach(item=>{ %><article class="panel"><strong><%= item.total %></strong><span><%= item.label.replaceAll('_',' ') %></span></article><% }) %></section>
<section class="panel"><h2><%= report.label %></h2><p>Showing <%= records.length %> of <%= total %> matching records. Downloads include all matching rows, up to 50,000.</p><div class="report-table-scroll"><table><thead><tr><% report.columns.forEach(column=>{ %><th scope="col"><%= column.replaceAll('_',' ') %></th><% }) %></tr></thead><tbody><% records.forEach(record=>{ %><tr><% report.columns.forEach(column=>{ %><td><%= record[column] ?? '—' %></td><% }) %></tr><% }) %></tbody></table></div><% if(!records.length){ %><p>No records match these filters.</p><% } %></section>
<%- include('foot') %>
