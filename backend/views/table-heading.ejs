<th scope="col" aria-sort="<%= table.sort===column?(table.dir==='asc'?'ascending':'descending'):'none' %>"><a class="table-sort-link" href="<%= table.link({sort:column,dir:table.sort===column&&table.dir==='asc'?'desc':'asc',p:1}) %>"><%= label %><% if(table.sort===column){ %><span class="table-sort-direction"><%= ['updated','received','registered'].includes(column)?(table.dir==='asc'?'Oldest first':'Newest first'):(table.dir==='asc'?'A–Z':'Z–A') %></span><% } %></a></th>
