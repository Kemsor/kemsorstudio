<%- include('head') %><h1>EPK access — <%= entry.title %></h1><p>Current access: <strong><%= mode %></strong>. <a href="/admin/content/<%= entry.id %>">Edit the press kit and access mode</a>.</p><p><a href="/admin/production-epks/<%= entry.id %>/preview" target="_blank" rel="noopener">Preview structured kit</a></p><% if(newLink){ %><section class="panel"><h2>New private link</h2><p>Copy this link now. It is shown once; only its hash is stored.</p><a href="<%= newLink %>" target="_blank" rel="noopener noreferrer"><%= newLink %></a></section><% } %><% if(mode==='link_only'){ %><form method="post" action="/admin/production-epks/<%= entry.id %>/grants" class="panel"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Create private share link</h2><label>Internal label<input name="label" required maxlength="200" placeholder="Festival press team"></label><label>Expiry (days)<input name="days" type="number" min="1" max="30" value="7" required></label><label>Total file downloads<input name="max_downloads" type="number" min="1" max="100" value="10" required></label><p>The production must be published for this link to work. HTML and PDF downloads share the limit. Viewing the kit does not use a download. HEAD requests do not use downloads.</p><button>Create link</button></form><% } %><section class="panel"><h2>Share links</h2><% grants.forEach(grant=>{ %><article><h3><%= grant.label %></h3><p>Expires <%= grant.expires_at %> UTC · <%= grant.downloads %>/<%= grant.max_downloads %> downloads · <%= grant.revoked_at?'revoked':'not revoked' %></p><% if(!grant.revoked_at){ %><form method="post" action="/admin/production-epks/<%= entry.id %>/grants/<%= grant.id %>/revoke"><input type="hidden" name="_csrf" value="<%= csrf %>"><button>Revoke link</button></form><% } %></article><% }) %></section><%- include('foot') %>
