<% const shown=compact?actions.slice(0,3):actions; %>
<% if(!actions.length){ %><p>No corrective initiatives recorded.</p><% } %>
<% if(compact&&actions.length>3){ %><p>Showing 3 of <%= actions.length %> initiatives; see the full scorecard for all actions.</p><% } %>
<div class="kpi-actions"><% shown.forEach(a=>{ %><article class="kpi-action"><h3><%= compact?clip(a.title,100):a.title %></h3><p><strong><%= compact?clip(a.owner,40):a.owner %></strong> · Due <%= a.due_date %> · <%= a.status.replaceAll('_',' ') %><% if(['open','in_progress'].includes(a.status)&&String(a.due_date).slice(0,10)<card.generatedAt.slice(0,10)){ %> · <strong class="kpi-overdue">Overdue at report generation</strong><% } %></p><p class="form-help"><%= a.cadence %> · <%= a.period_start %> · <%= a.metric_key.replaceAll('_',' ') %></p><p class="kpi-prose">Expected: <%= compact?clip(a.expected_outcome,120):a.expected_outcome %></p><p class="kpi-prose">Progress / evidence: <%= compact?clip(a.evidence||'Not recorded.',100):a.evidence||'Not recorded.' %></p><% if(!readonly&&!compact){ %><details class="no-print"><summary>Update progress</summary><form action="/admin/kpi/actions/<%= a.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= a.version %>"><label>Status<select name="status"><% ['open','in_progress','done','cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= a.status===s?'selected':'' %>><%= s.replaceAll('_',' ') %></option><% }) %></select></label><label>Progress, achieved outcome or cancellation reason<textarea name="evidence" maxlength="4000"><%= a.evidence %></textarea></label><button>Save progress</button></form></details><% } %></article><% }) %></div>
