<%- include('head') %><p class="eyebrow"><%= module.area %></p><h1><%= module.label %></h1><p>These controls update existing website content. Save a draft to review it later, or publish to apply changes. Reset returns this area to its supplied defaults. Public pages refresh CMS content within 30 seconds.</p><p><a href="/admin/site-content">All website areas</a> · <span class="badge"><%= live?'Published overrides':'Supplied defaults are live' %></span></p>
<label>Find a field<input type="search" data-site-search placeholder="Search existing copy or field labels…"></label>
<form method="post" action="/admin/site-content/save" class="panel editor"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="module_key" value="<%= key %>"><input type="hidden" name="revision" value="<%= revision %>"><div class="field-grid">
<% module.fields.forEach(field=>{const value=Object.hasOwn(draft,field.key)?draft[field.key]:field.default; %><div class="wide site-content-field" data-site-search-item><label><%= field.label %>
<% if(field.type==='boolean'){ %><input type="checkbox" name="value:<%= field.key %>" <%= value?'checked':'' %>>
<% }else if(field.type==='number'){ %><input type="number" name="value:<%= field.key %>" min="1" max="1000" value="<%= value %>">
<% }else if(field.type==='text'){ %><textarea name="value:<%= field.key %>" maxlength="12000" rows="<%= value.length>160?4:2 %>"><%= value %></textarea>
<% }else{ %><input name="value:<%= field.key %>" value="<%= value %>" maxlength="1500" <%- field.type==='image'?'data-image-url':field.type==='video'?'data-content-video':field.type==='captions'?'data-caption-upload':'' %>>
<% } %></label><% if(field.type==='image'&&value){ %><img class="media-upload-preview" src="<%= value %>" alt="Current image"><% } %></div><% }); %></div>
<div class="button-row"><button name="action" value="draft">Save draft</button><button name="action" value="publish">Publish changes</button><button class="quiet" name="action" value="reset">Reset to supplied defaults</button></div>
<% if(history.length){ %><hr><label>Restore earlier draft<select name="restore_revision"><% history.forEach(item=>{ %><option value="<%= item.revision %>">Revision <%= item.revision %> · <%= item.action %> · <%= item.created_at %></option><% }); %></select></label><button class="quiet" name="action" value="restore">Restore as draft</button><% } %></form><script src="/site-editor.js?v=1" defer></script><%- include('foot') %>
