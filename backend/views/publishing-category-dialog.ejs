<dialog class="blog-category-dialog" data-blog-category-dialog aria-labelledby="blog-category-dialog-title"><form action="/admin/<%= categoryType %>-categories" method="post" data-blog-category-form><input type="hidden" name="_csrf" value="<%= csrf %>"><h2 id="blog-category-dialog-title">Create <%= categoryType %> category</h2><p>Save a reusable category, then select it for this post.</p><label>Category name<input name="name" required maxlength="100" autocomplete="off" data-blog-category-name></label><p role="alert" data-blog-category-error hidden></p><div class="button-row"><button type="button" class="quiet" data-blog-category-cancel>Cancel</button><button class="admin-save">Save category</button></div></form></dialog>
