<section class="wide"><h2>Rights information</h2><label>Rights holder<input name="rights_holder" maxlength="300" value="<%= entry.metadata.rights_holder||'' %>"></label><label>Public rights statement<textarea name="rights_summary" rows="3" maxlength="2000"><%= entry.metadata.rights_summary||'' %></textarea></label><label>Rights availability<select name="rights_status"><% [['','Not specified'],['not_announced','Not announced'],['available','Available'],['partially_available','Partially available'],['unavailable','Unavailable']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= entry.metadata.rights_status===value?'selected':'' %>><%= label %></option><% }) %></select></label><label>Rights territories<input name="rights_territories" maxlength="500" value="<%= entry.metadata.rights_territories||'' %>"></label><label>Private rights notes<textarea name="rights_notes" rows="4" maxlength="5000"><%= entry.metadata.rights_notes||'' %></textarea><small>Studio staff only. These notes never appear on public pages or in the public content API.</small></label></section>
<%
 const people=typeof productionPeople==='undefined'?[]:productionPeople;
 const assets=[...media,...(typeof productionAssets==='undefined'?[]:productionAssets)];
 const field=(key,label,type='text',required=false,options=[])=>({key,label,type,required,options});
 const creditFields=[field('name','Credited name','text',true),field('role','Character / job title'),field('person_id','Linked biography','person')];
 const collections=[
 {key:'epk_people',title:'EPK biographies',limit:30,fields:[field('person_id','Biography','person',true)]},
 {key:'epk_statements',title:'EPK statements',limit:12,fields:[field('title','Statement title','text',true),field('author','Author'),field('body','Statement','textarea',true)]},
 {key:'cast_credits',input:'cast_credits_rows',title:'Cast credits',limit:100,fields:creditFields},
 {key:'crew_credits',input:'crew_credits_rows',title:'Crew credits',limit:100,fields:[creditFields[0],field('role','Job title','text',true),creditFields[2]]},
 {key:'contributor_credits',input:'contributor_credits_rows',title:'Contributor credits',limit:100,fields:[creditFields[0],field('role','Contribution','text',true),creditFields[2]]},
 {key:'platform_links',title:'Platform links',limit:20,fields:[field('kind','Link type','select',true,[['watch','Watch'],['tickets','Tickets'],['official','Official'],['music','Music']]),field('label','Platform / link label','text',true),field('url','HTTPS URL','url',true),field('territories','Available territories')]},
 {key:'production_media',title:'Posters, trailers, teasers, songs and BTS',limit:40,fields:[field('type','Media type','select',true,[['poster','Poster'],['trailer','Trailer'],['teaser','Teaser'],['song','Song'],['behind_the_scenes','Behind the scenes']]),field('title','Title','text',true),field('url','Uploaded media / direct HTTPS MP4 or MP3 URL','media',true),field('alt','Poster alt text (required for posters)'),field('captions_url','Uploaded subtitle URL (optional)'),field('language','Subtitle language (e.g. en)')]},
 {key:'awards',title:'Awards, nominations and festival selections',limit:60,fields:[field('event','Award / festival','text',true),field('outcome','Outcome','select',true,[['winner','Winner'],['nominee','Nominee'],['official_selection','Official selection']]),field('category','Category'),field('year','Year','text',true),field('recipient','Recipient'),field('source_url','HTTPS source (optional)','url')]},
 {key:'screenings',title:'Premieres and screening history',limit:60,fields:[field('type','Event type','select',true,[['premiere','Premiere'],['festival','Festival screening'],['screening','Screening']]),field('event','Event name','text',true),field('date','Date','date',true),field('venue','Venue'),field('city','City'),field('country','Country'),field('notes','Notes'),field('source_url','HTTPS source (optional)','url')]}
 ];
 collections.forEach(collection=>{ %>
<section class="wide" data-production-collection data-limit="<%= collection.limit %>"><h2><%= collection.title %></h2><p>Add approved records and use the arrows to change their order. Empty sections stay hidden publicly.</p><% if(collection.key.endsWith('_credits')){ %><p><a href="/admin/people" target="_blank" rel="noopener">Manage people and biographies</a>. Draft biographies stay private; the credited name can still appear.</p><% } %><% if(collection.key==='production_media'){ %><p>Upload images or MP4s using the upload controls below. Songs support MP4 music videos and direct HTTPS MP3 audio. Enter alt text for every poster.</p><% } %>
<input type="hidden" name="<%= collection.input||collection.key %>" value="<%= JSON.stringify(entry.metadata[collection.key]||[]) %>" data-collection-value><div data-collection-rows></div><button type="button" data-collection-add>Add record</button><p role="status" data-collection-status></p>
<template data-collection-template><fieldset><legend>Record</legend><% collection.fields.forEach(f=>{ %><label><%= f.label %><% if(f.type==='textarea'){ %><textarea data-record-field="<%= f.key %>" rows="8" maxlength="12000" <%= f.required?'required':'' %>></textarea><% }else if(f.type==='select'||f.type==='person'){ %><select data-record-field="<%= f.key %>" <%= f.required?'required':'' %>><% if(f.type==='person'){ %><option value="">No linked biography</option><% people.forEach(person=>{ %><option value="<%= person.id %>" data-person-name="<%= person.name %>"><%= person.name %> · <%= person.status %></option><% }) %><% }else{f.options.forEach(([value,label])=>{ %><option value="<%= value %>"><%= label %></option><% })} %></select><% }else{ %><input type="<%= f.type==='media'?'text':f.type %>" data-record-field="<%= f.key %>" <%- f.type==='media'?'data-image-url data-content-video':f.key==='captions_url'?'data-caption-upload':'' %> maxlength="1500" <%= f.required?'required':'' %>><% if(f.type==='media'){ %><% } %><% } %></label><% }) %><div><button type="button" data-record-up aria-label="Move record up">↑ Move up</button> <button type="button" data-record-down aria-label="Move record down">↓ Move down</button> <button type="button" data-record-remove>Remove record</button></div></fieldset></template><noscript>Enable JavaScript to edit these records. Existing records are preserved.</noscript></section>
<% }) %><script src="/production-collections.js?v=2" defer></script>
