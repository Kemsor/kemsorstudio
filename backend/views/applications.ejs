<%- include('head') %><p class="eyebrow">Recruitment</p><h1>Career applications</h1><form class="filters"><input type="hidden" name="sort" value="<%= table.sort %>"><input type="hidden" name="dir" value="<%= table.dir %>"><input type="hidden" name="per_page" value="<%= table.limit %>"><label>Search<input name="q" value="<%= search %>" maxlength="100" placeholder="Applicant or opportunity"></label><label>Status<select name="status"><option value="">All statuses</option><% states.forEach(s=>{ %><option value="<%= s %>" <%= state===s?'selected':'' %>><%= s %></option><% }); %></select></label><button>Filter</button></form><p><%= total %> applications · Page <%= page %></p><%- include('table-tools',{resource:'applications',actions:states.map(s=>[s,s])}) %><div class="table-wrap"><table><thead><tr><th class="table-selection-cell"><input type="checkbox" data-select-page aria-label="Select all rows on this page"></th><%- include('table-heading',{label:'Applicant',column:'name'}) %><%- include('table-heading',{label:'Opportunity',column:'opportunity'}) %><%- include('table-heading',{label:'Status',column:'status'}) %><%- include('table-heading',{label:'Received',column:'received'}) %><th>Action</th></tr></thead><tbody><% applications.forEach(a=>{ %><tr><td class="table-selection-cell"><input type="checkbox" name="ids" value="<%= a.id %>" form="table-bulk-form" data-row-select aria-label="Select record <%= a.id %>"></td><td><%= a.name %><small><%= a.email %></small></td><td><%= a.career_title %></td><td><span class="badge"><%= a.status %></span></td><td><%= a.created_at %> UTC</td><td><a href="/admin/applications/<%= a.id %>">View application</a></td></tr><% }); %></tbody></table></div><% if(!applications.length){ %><p class="empty">No matching applications.</p><% } %><%- include('table-pagination') %><%- include('foot') %>
