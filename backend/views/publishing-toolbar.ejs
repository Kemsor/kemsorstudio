<input type="hidden" name="revision" value="<%= entry.id?(entry.revision||1):0 %>">
<div class="publishing-toolbar"><div><span class="badge badge-<%= entry.status || 'draft' %>" data-publishing-status><%= entry.status || 'draft' %></span><span class="publishing-state-copy" data-publishing-help><%= entry.status==='published'?'Published on the website':entry.status==='archived'?'Archived; hidden from the website':'Draft; visible only to publishing staff' %></span><span class="editor-change-state" data-change-state role="status">No unsaved changes</span></div><div class="publishing-toolbar-actions"><% if(entry.id){ %><a class="button quiet" href="/admin/content/<%= entry.id %>/revisions">Saved revisions</a><% } %><button type="button" class="quiet" data-preview-content>Preview changes</button></div></div>
<p class="publishing-edit-info"><% if(entry.id){ %>Saved version <%= entry.revision||1 %><% if(entry.updated_at){ %> · Last edited <%= entry.updated_at %> UTC · <%= entry.last_editor||'Editor not recorded' %><% } %><% }else{ %>New draft · Not saved yet<% } %></p>
