<div class="publishing-toolbar"><div><span class="badge badge-<%= entry.status || 'draft' %>" data-publishing-status><%= entry.status || 'draft' %></span><span class="publishing-state-copy" data-publishing-help><%= entry.status==='published'?'Published on the website':entry.status==='archived'?'Archived — hidden from the website':'Draft — visible only to publishing staff' %></span><span class="editor-change-state" data-change-state role="status">No unsaved changes</span></div><button type="button" class="quiet" data-preview-content>Preview changes</button></div>
