<%- include('head') %><h1><%= person.id?'Edit person':'Add person' %></h1><form method="post" action="/admin/people/save" class="panel editor"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= person.id||'' %>"><label>Name<input name="name" maxlength="160" required value="<%= person.name||'' %>"></label><label>Profession<input name="profession" maxlength="200" value="<%= person.profession||'' %>"></label><label>Biography<textarea name="biography" rows="10" maxlength="15000" required><%= person.biography||'' %></textarea></label><label>Portrait<select name="image_id"><option value="">No portrait</option><% media.forEach(image=>{ %><option value="<%= image.id %>" <%= image.id===person.image_id?'selected':'' %>><%= image.original_name %></option><% }) %></select></label><label>Official website<input name="website" type="url" maxlength="1500" value="<%= person.website||'' %>" placeholder="https://…"></label><label>Publishing status<select name="status"><% ['draft','published','archived'].forEach(value=>{ %><option <%= person.status===value?'selected':'' %>><%= value %></option><% }) %></select></label><button>Save profile</button></form><% if(person.slug){ %><p>Public URL: /people/<%= person.slug %>/ (available when published)</p><% } %><a href="/admin/people">Back to people</a><%- include('foot') %>
