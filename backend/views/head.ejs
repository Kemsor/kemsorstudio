<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><title><%= title %></title><link rel="stylesheet" href="/admin.css?v=2"><link rel="stylesheet" href="/dashboard.css?v=3"><script src="/admin.js?v=2" defer></script></head><body class="<%= user ? 'cms-authenticated' : 'cms-login' %>">
<header class="cms-header"><a class="cms-brand" href="/admin" aria-label="Kemsor Studios admin dashboard"><img class="cms-brand-logo" src="/admin-brand.webp" alt="" width="64" height="58"><span class="cms-brand-copy"><strong>KEMSOR<span class="cms-brand-studios">STUDIOS</span></strong><small>ADMIN WORKSPACE</small></span></a>
<% if(user){ %><div class="workspace-label"><span class="status-dot"></span>Studio workspace</div><div class="account">
<details class="notification-dropdown"><summary aria-label="Notifications"><%- include('icon',{name:'bell'}) %><span class="notification-count" data-notification-count <%= unreadCount ? '' : 'hidden' %>><%= unreadCount %></span></summary><div class="notification-popover"><div class="panel-heading"><strong>Notifications</strong><a href="/admin/notifications">View all ↗</a></div><%- include('notification-items',{limit:5,actions:false}) %></div></details>
<span class="account-avatar" aria-hidden="true"><%= user.name.split(' ').map(n=>n[0]).slice(0,2).join('') %></span><div class="account-copy"><strong><%= user.name %></strong><small><%= user.role.replace('_',' ') %></small></div><form action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="quiet sign-out" aria-label="Sign out"><%- include('icon',{name:'logout'}) %></button></form></div><% } %></header>
<div class="cms-shell"><% if(user){ const isCurrent=(url,type='')=>currentPath===url && (!type || currentType===type); %><nav class="cms-nav" aria-label="CMS navigation"><p class="nav-label">WORKSPACE</p><a href="/admin" <%- isCurrent('/admin')?'aria-current="page"':'' %>><%- include('icon',{name:'overview'}) %>Overview</a><a href="/admin/notifications" <%- isCurrent('/admin/notifications')?'aria-current="page"':'' %>><%- include('icon',{name:'bell'}) %>Notifications<span class="nav-count" data-notification-count <%= unreadCount ? '' : 'hidden' %>><%= unreadCount %></span></a>
<% if(['admin','editor'].includes(user.role)){ %><p class="nav-label">CREATE & PUBLISH</p><% Object.entries(types).forEach(([key,label])=>{ %><a href="/admin/content?type=<%= key %>" <%- isCurrent('/admin/content',key)?'aria-current="page"':'' %>><%- include('icon',{name:key}) %><%= label %></a><% }); %><a href="/admin/media" <%- isCurrent('/admin/media')?'aria-current="page"':'' %>><%- include('icon',{name:'media'}) %>Image library</a><% } %>
<% if(['admin','enquiry_manager'].includes(user.role)){ %><p class="nav-label">CONVERSATIONS</p><a href="/admin/enquiries" <%- currentPath.startsWith('/admin/enquiries')?'aria-current="page"':'' %>><%- include('icon',{name:'enquiries'}) %>Enquiry workspace</a><% } %>
<% if(user.role==='admin'){ %><p class="nav-label">STUDIO CONTROLS</p><a href="/admin/talent" <%- isCurrent('/admin/talent')?'aria-current="page"':'' %>><%- include('icon',{name:'team'}) %>Registrations</a><a href="/admin/talent/enquiries" <%- isCurrent('/admin/talent/enquiries')?'aria-current="page"':'' %>><%- include('icon',{name:'enquiries'}) %>Talent enquiries</a><a href="/admin/talent/projects" <%- isCurrent('/admin/talent/projects')?'aria-current="page"':'' %>><%- include('icon',{name:'page'}) %>Production projects</a><a href="/admin/settings" <%- isCurrent('/admin/settings')?'aria-current="page"':'' %>><%- include('icon',{name:'settings'}) %>Site settings</a><a href="/admin/users" <%- isCurrent('/admin/users')?'aria-current="page"':'' %>><%- include('icon',{name:'team'}) %>Users & roles</a><a href="/admin/audit" <%- isCurrent('/admin/audit')?'aria-current="page"':'' %>><%- include('icon',{name:'audit'}) %>Activity log</a><% } %>
<a href="/admin/password" <%- isCurrent('/admin/password')?'aria-current="page"':'' %>><%- include('icon',{name:'password'}) %>Change password</a><a class="nav-website" href="<%= websiteUrl %>" target="_blank" rel="noopener"><%- include('icon',{name:'external'}) %>View website</a><div class="sidebar-note"><span>✦</span><strong>Good stories start here.</strong><small>A little clarity.<br>A lot of possibility.</small></div></nav><% } %>
<main id="main"><% if(saved){ %><p class="notice" role="status">Saved successfully.</p><% } %>
