<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="theme-color" content="#181818"><title><%= title %></title><script src="/admin-theme.js?v=9"></script><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"><link rel="stylesheet" href="/admin.css?v=5"><link rel="stylesheet" href="/dashboard.css?v=20"><link rel="stylesheet" href="/admin-ui.css?v=11"><link rel="stylesheet" href="/neutral-palette.css?v=1"><link rel="stylesheet" href="/admin-premium.css?v=6"><link rel="stylesheet" href="/form-controls.css?v=1"><link rel="stylesheet" href="/rich-editor.css?v=1"><script type="module" src="/rich-editor.js?v=3"></script><script src="/media-upload.js?v=8" defer></script><script src="/admin.js?v=25" defer></script><link rel="stylesheet" href="/media-upload.css?v=4"><link rel="stylesheet" href="/admin-flat.css?v=6"><link rel="stylesheet" href="/admin-brand.css?v=26"><link rel="stylesheet" href="/admin-experience.css?v=3"><link rel="stylesheet" href="/publishing-tools.css?v=2"><script type="module" src="/publishing-preview.js?v=2"></script><script type="module" src="/media-library.js?v=2"></script><link rel="stylesheet" href="/follow-up.css?v=2"><link rel="stylesheet" href="/publishing-safety.css?v=1"><script type="module" src="/publishing-safety.js?v=1"></script><link rel="stylesheet" href="/staff-access.css?v=1"><link rel="stylesheet" href="/audit-log.css?v=1"><link rel="stylesheet" href="/admin-accessibility.css?v=2"><script src="/admin-accessibility.js?v=1" defer></script><link rel="stylesheet" href="/admin-header.css?v=3"><link rel="stylesheet" href="/dashboard-palette.css?v=3"><link rel="stylesheet" href="/admin-palette.css?v=2"><link rel="stylesheet" href="/admin-reference-layout.css?v=3"><link rel="stylesheet" href="/notification-compact.css?v=1"></head><body class="<%= user ? 'cms-authenticated' : 'cms-login' %>">
<a class="admin-skip-link" href="#main">Skip to main content</a>
<header class="cms-header"><% if(user){ %><button type="button" class="admin-menu-toggle" aria-label="Open navigation" aria-controls="cms-navigation" aria-expanded="false"><%- include('icon',{name:'menu'}) %></button><% } %><a class="cms-brand" href="/admin" aria-label="Kemsor Studios admin dashboard"><img class="cms-brand-logo" src="/admin-brand.webp" alt="" width="64" height="58"><span class="cms-brand-copy"><strong>KEMSOR<span class="cms-brand-studios">STUDIOS</span></strong><small>ADMIN WORKSPACE</small></span></a>
<% if(user){ %><div class="workspace-label"><span class="status-dot"></span>Studio workspace</div><div class="account"><a class="admin-website-link" aria-label="View website (opens in a new tab)" title="View website" href="<%= websiteUrl %>" target="_blank" rel="noopener"><%- include('icon',{name:'external'}) %><span>View website</span></a>
<details class="notification-dropdown"><summary aria-label="Notifications" aria-controls="notification-popover" aria-expanded="false"><%- include('icon',{name:'bell'}) %><span class="notification-count" data-notification-count <%= unreadCount ? '' : 'hidden' %>><%= unreadCount %></span></summary>
<div class="notification-popover" id="notification-popover" role="region" aria-label="Recent notifications">
<div class="notification-dropdown-heading"><div><strong>Notifications</strong><small data-notification-label role="status"><%= unreadCount %> unread</small></div><form method="post" action="/admin/notifications/read" data-notification-read-all><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="key" value="all"><button class="notification-mark-all" <%= !unreadCount?'disabled':'' %>>Mark all as read</button></form></div>
<div class="notification-dropdown-list"><%- include('notification-items',{limit:4,actions:false}) %></div>
<div class="notification-dropdown-footer"><a class="button notification-view" href="/admin/notifications">View all notifications <span aria-hidden="true">→</span></a></div>
<p class="notification-dropdown-error" role="alert" hidden></p></div></details>
<a class="header-profile-link profile-account-link" href="/admin/profile" aria-label="My profile"><span class="account-avatar" aria-hidden="true"><%= user.name.split(' ').map(n=>n[0]).slice(0,2).join('') %></span><span class="account-copy"><strong><%= user.name %></strong><small><%= {admin:'Administrator',editor:'Editor',enquiry_manager:'Enquiry manager'}[user.role] %></small></span></a><form action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="quiet sign-out" aria-label="Sign out"><%- include('icon',{name:'logout'}) %></button></form></div><% }else{ %><% } %></header>
<div class="cms-shell"><% if(user){ const isCurrent=(url,type='')=>currentPath===url && (!type || currentType===type); %><button class="admin-nav-backdrop" type="button" aria-label="Close navigation" hidden></button><nav id="cms-navigation" class="cms-nav" aria-label="CMS navigation" tabindex="-1"><p class="nav-label">General</p><a href="/admin" <%- isCurrent('/admin')?'aria-current="page"':'' %>><%- include('icon',{name:'overview'}) %>Overview</a><a href="/admin/notifications" <%- isCurrent('/admin/notifications')?'aria-current="page"':'' %>><%- include('icon',{name:'bell'}) %>Notifications<span class="nav-count" data-notification-count <%= unreadCount ? '' : 'hidden' %>><%= unreadCount %></span></a>
<% if(['admin','editor'].includes(user.role)){ %>
<p class="nav-label">Publishing</p><% [['blog','Blog posts'],['news','News posts'],['career','Career opportunities']].forEach(([key,label])=>{ %><a href="/admin/content?type=<%= key %>" <%- isCurrent('/admin/content',key)?'aria-current="page"':'' %>><%- include('icon',{name:key}) %><%= label %></a><% }); %>
<p class="nav-label">Website pages</p><a href="/admin/site-content">Existing page content</a><a href="/admin/pages" <%- isCurrent('/admin/pages')?'aria-current="page"':'' %>><%- include('icon',{name:'page'}) %>Manage pages</a><% [['home','Homepage'],['production','Productions'],['press_asset','Press resources'],['team','Team profiles'],['media_partner','Media partners']].forEach(([key,label])=>{ %><a href="/admin/content?type=<%= key %>" <%- isCurrent('/admin/content',key)?'aria-current="page"':'' %>><%- include('icon',{name:key}) %><%= label %></a><% }); %><a href="/admin/casting" <%- currentPath.startsWith('/admin/casting')?'aria-current="page"':'' %>><%- include('icon',{name:'team'}) %>Casting calls</a><a href="/admin/people">Production people</a><a href="/admin/casting-applications">Casting applications</a><a href="/admin/media" <%- isCurrent('/admin/media')?'aria-current="page"':'' %>><%- include('icon',{name:'media'}) %>Media library</a><% } %>
<% if(['admin','enquiry_manager'].includes(user.role)){ %><p class="nav-label">Enquiries & applications</p><a href="/admin/applications" <%- currentPath.startsWith('/admin/applications')?'aria-current="page"':'' %>><%- include('icon',{name:'career'}) %>Career applications</a><a href="/admin/enquiries" <%- currentPath.startsWith('/admin/enquiries')?'aria-current="page"':'' %>><%- include('icon',{name:'enquiries'}) %>Contact page enquiries</a><% if(user.role==='admin'){ %><a href="/admin/talent/enquiries" <%- isCurrent('/admin/talent/enquiries')?'aria-current="page"':'' %>><%- include('icon',{name:'enquiries'}) %>Talent enquiries</a><% } %><% } %>
<% if(user.role==='admin'){ %><p class="nav-label">Users & members</p><a href="/admin/talent" <%- isCurrent('/admin/talent')?'aria-current="page"':'' %>><%- include('icon',{name:'team'}) %>All members</a><a href="/admin/talent?role=artist"><%- include('icon',{name:'team'}) %>Artists & crew</a><a href="/admin/talent?role=hirer"><%- include('icon',{name:'career'}) %>Directors & producers</a><a href="/admin/users" <%- isCurrent('/admin/users')?'aria-current="page"':'' %>><%- include('icon',{name:'password'}) %>Admin users & roles</a>
<p class="nav-label">Production</p><a href="/admin/talent/projects" <%- isCurrent('/admin/talent/projects')?'aria-current="page"':'' %>><%- include('icon',{name:'career'}) %>Production projects</a>
<p class="nav-label">Settings & activity</p><a href="/admin/casting-application-settings">Casting application settings</a><a href="/admin/settings" <%- isCurrent('/admin/settings')?'aria-current="page"':'' %>><%- include('icon',{name:'settings'}) %>Site settings</a><a href="/admin/news-campaigns">News campaigns</a><a href="/admin/newsletter" <%- isCurrent('/admin/newsletter')?'aria-current="page"':'' %>>News alert subscribers</a><a href="/admin/manage/legal" <%- currentPath.startsWith('/admin/manage/legal')?'aria-current="page"':'' %>>Legal documents</a><a href="/admin/manage/hero" <%- currentPath.startsWith('/admin/manage/hero')?'aria-current="page"':'' %>>Homepage hero slides</a><a href="/admin/operations" <%- currentPath.startsWith('/admin/operations')?'aria-current="page"':'' %>>Operations & backups</a><a href="/admin/email" <%- isCurrent('/admin/email')?'aria-current="page"':'' %>><%- include('icon',{name:'enquiries'}) %>Email delivery</a><a href="/admin/audit" <%- isCurrent('/admin/audit')?'aria-current="page"':'' %>><%- include('icon',{name:'audit'}) %>Activity log</a><% } %>
<p class="nav-label">Reporting</p><% if(['admin','enquiry_manager'].includes(user.role)){ %><a href="/admin/kpi" <%- currentPath.startsWith('/admin/kpi')?'aria-current="page"':'' %>><%- include('icon',{name:'audit'}) %>KPI & outcomes</a><% } %><a href="/admin/reports" <%- isCurrent('/admin/reports')?'aria-current="page"':'' %>><%- include('icon',{name:'audit'}) %>Reports & downloads</a><% const reportLinks=[...(['admin','enquiry_manager'].includes(user.role)?[['enquiries','Enquiry reports'],['applications','Career reports']]:[]),...(['admin','editor'].includes(user.role)?[['content','Publishing reports']]:[]),...(user.role==='admin'?[['registrations','Registration reports'],['talent','Talent enquiry reports'],['projects','Production reports'],['activity','Activity reports']]:[])];reportLinks.forEach(([key,label])=>{ %><a class="cms-report-link" href="/admin/reports/<%= key %>" <%- currentPath==='/admin/reports/'+key?'aria-current="page"':'' %>><%- include('icon',{name:'audit'}) %><%= label %></a><% }) %><p class="nav-label">My account</p>
<a href="/admin/profile" <%- isCurrent('/admin/profile')?'aria-current="page"':'' %>><%- include('icon',{name:'team'}) %>My profile</a>
<a href="/admin/permissions" <%- isCurrent('/admin/permissions')?'aria-current="page"':'' %>>Roles & permissions</a>
<a href="/admin/password" <%- isCurrent('/admin/password')?'aria-current="page"':'' %>><%- include('icon',{name:'password'}) %>Change password</a><div class="sidebar-note"><span><%- include('icon',{name:'career'}) %></span><strong>Kemsor studio desk</strong><small>Content and operations</small></div></nav><script src="/admin-nav-state.js?v=4"></script><% } %>
<main id="main" tabindex="-1"><% if(saved){ %><div class="notice admin-saved-notice" role="status"><span><strong>Saved successfully.</strong> Your changes are up to date.</span><button type="button" class="quiet" data-dismiss-notice aria-label="Dismiss save confirmation">×</button></div><% } %>

<% for (const iconName of ['enquiries','page','team','career','settings','eye','eye-off']) { %><template data-admin-icon="<%= iconName %>"><%- adminIcon(iconName) %></template><% } %>
