<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="robots" content="noindex,nofollow"><meta name="theme-color" content="#181818"><title><%= title %></title><script src="/admin-theme.js?v=3"></script><link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"><link rel="stylesheet" href="/admin.css?v=4"><link rel="stylesheet" href="/dashboard.css?v=19"><link rel="stylesheet" href="/admin-ui.css?v=9"><link rel="stylesheet" href="/neutral-palette.css?v=1"><link rel="stylesheet" href="/admin-premium.css?v=5"><script src="/admin.js?v=14" defer></script></head><body class="<%= user ? 'cms-authenticated' : 'cms-login' %>">
<header class="cms-header"><% if(user){ %><button type="button" class="admin-menu-toggle" aria-label="Open navigation" aria-controls="cms-navigation" aria-expanded="false"><%- include('icon',{name:'menu'}) %></button><% } %><a class="cms-brand" href="/admin" aria-label="Kemsor Studios admin dashboard"><img class="cms-brand-logo" src="/admin-brand.webp" alt="" width="64" height="58"><span class="cms-brand-copy"><strong>KEMSOR<span class="cms-brand-studios">STUDIOS</span></strong><small>ADMIN WORKSPACE</small></span></a>
<% if(user){ %><div class="workspace-label"><span class="status-dot"></span>Studio workspace</div><div class="account"><a class="admin-website-link" href="/" target="_blank" rel="noopener"><%- include('icon',{name:'external'}) %><span>View website</span></a><button type="button" class="admin-theme-toggle" aria-label="Switch to dark theme" aria-pressed="false"><span class="theme-icon-light"><%- include('icon',{name:'sun'}) %></span><span class="theme-icon-dark"><%- include('icon',{name:'moon'}) %></span><span class="theme-toggle-label">Light</span></button>
<details class="notification-dropdown"><summary aria-label="Notifications" aria-controls="notification-popover"><%- include('icon',{name:'bell'}) %><span class="notification-count" data-notification-count <%= unreadCount ? '' : 'hidden' %>><%= unreadCount %></span></summary><div class="notification-popover" id="notification-popover"><div class="notification-dropdown-heading"><div><strong>Notifications</strong><small data-notification-label><%= unreadCount %> unread updates</small></div><button type="button" class="notification-unread-toggle" data-unread-only aria-pressed="false">Unread only</button></div><div class="notification-dropdown-list"><%- include('notification-items',{limit:5,actions:true}) %></div><div class="notification-dropdown-footer"><form method="post" action="/admin/notifications/read" data-notification-read-all><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="key" value="all"><button class="notification-mark-all" <%= !unreadCount?'disabled':'' %>>Mark all as read</button></form><a href="/admin/notifications">View all notifications</a></div><p class="notification-dropdown-error" role="alert" hidden></p></div></details>
<span class="account-avatar" aria-hidden="true"><%= user.name.split(' ').map(n=>n[0]).slice(0,2).join('') %></span><a class="account-copy profile-account-link" href="/admin/profile" aria-label="My profile"><strong><%= user.name %></strong><small><%= user.role.replace('_',' ') %></small></a><form action="/admin/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="quiet sign-out" aria-label="Sign out"><%- include('icon',{name:'logout'}) %></button></form></div><% }else{ %><button type="button" class="admin-theme-toggle" aria-label="Switch to dark theme" aria-pressed="false"><span class="theme-icon-light"><%- include('icon',{name:'sun'}) %></span><span class="theme-icon-dark"><%- include('icon',{name:'moon'}) %></span><span class="theme-toggle-label">Light</span></button><% } %></header>
<div class="cms-shell"><% if(user){ const isCurrent=(url,type='')=>currentPath===url && (!type || currentType===type); %><button class="admin-nav-backdrop" type="button" aria-label="Close navigation" hidden></button><nav id="cms-navigation" class="cms-nav" aria-label="CMS navigation" tabindex="-1"><p class="nav-label">GENERAL</p><a href="/admin" <%- isCurrent('/admin')?'aria-current="page"':'' %>><%- include('icon',{name:'overview'}) %>Overview</a><a href="/admin/notifications" <%- isCurrent('/admin/notifications')?'aria-current="page"':'' %>><%- include('icon',{name:'bell'}) %>Notifications<span class="nav-count" data-notification-count <%= unreadCount ? '' : 'hidden' %>><%= unreadCount %></span></a>
<% if(['admin','editor'].includes(user.role)){ %>
<p class="nav-label">PUBLISHING</p><% [['blog','Blog posts'],['news','News posts'],['career','Career opportunities']].forEach(([key,label])=>{ %><a href="/admin/content?type=<%= key %>" <%- isCurrent('/admin/content',key)?'aria-current="page"':'' %>><%- include('icon',{name:key}) %><%= label %></a><% }); %>
<p class="nav-label">WEBSITE PAGES</p><a href="/admin/pages" <%- isCurrent('/admin/pages')?'aria-current="page"':'' %>><%- include('icon',{name:'page'}) %>Manage pages</a><% [['home','Homepage'],['team','Team profiles'],['media_partner','Media partners'],['legal','Legal centre']].forEach(([key,label])=>{ %><a href="/admin/content?type=<%= key %>" <%- isCurrent('/admin/content',key)?'aria-current="page"':'' %>><%- include('icon',{name:key}) %><%= label %></a><% }); %><a href="/admin/media" <%- isCurrent('/admin/media')?'aria-current="page"':'' %>><%- include('icon',{name:'media'}) %>Image library</a><% } %>
<% if(['admin','enquiry_manager'].includes(user.role)){ %><p class="nav-label">ENQUIRIES & APPLICATIONS</p><a href="/admin/applications" <%- currentPath.startsWith('/admin/applications')?'aria-current="page"':'' %>><%- include('icon',{name:'career'}) %>Career applications</a><a href="/admin/enquiries" <%- currentPath.startsWith('/admin/enquiries')?'aria-current="page"':'' %>><%- include('icon',{name:'enquiries'}) %>Studio enquiries</a><% if(user.role==='admin'){ %><a href="/admin/talent/enquiries" <%- isCurrent('/admin/talent/enquiries')?'aria-current="page"':'' %>><%- include('icon',{name:'enquiries'}) %>Talent enquiries</a><% } %><% } %>
<% if(user.role==='admin'){ %><p class="nav-label">USERS & MEMBERS</p><a href="/admin/talent" <%- isCurrent('/admin/talent')?'aria-current="page"':'' %>><%- include('icon',{name:'team'}) %>All members</a><a href="/admin/talent?role=artist"><%- include('icon',{name:'team'}) %>Artists & crew</a><a href="/admin/talent?role=hirer"><%- include('icon',{name:'career'}) %>Directors & producers</a><a href="/admin/users" <%- isCurrent('/admin/users')?'aria-current="page"':'' %>><%- include('icon',{name:'password'}) %>Admin users & roles</a>
<p class="nav-label">PRODUCTION</p><a href="/admin/talent/projects" <%- isCurrent('/admin/talent/projects')?'aria-current="page"':'' %>><%- include('icon',{name:'career'}) %>Production projects</a>
<p class="nav-label">SETTINGS & ACTIVITY</p><a href="/admin/settings" <%- isCurrent('/admin/settings')?'aria-current="page"':'' %>><%- include('icon',{name:'settings'}) %>Site settings</a><a href="/admin/email" <%- isCurrent('/admin/email')?'aria-current="page"':'' %>><%- include('icon',{name:'enquiries'}) %>Email delivery</a><a href="/admin/audit" <%- isCurrent('/admin/audit')?'aria-current="page"':'' %>><%- include('icon',{name:'audit'}) %>Activity log</a><% } %>
<p class="nav-label">MY ACCOUNT</p>
<a href="/admin/profile" <%- isCurrent('/admin/profile')?'aria-current="page"':'' %>><%- include('icon',{name:'team'}) %>My profile</a>
<a href="/admin/password" <%- isCurrent('/admin/password')?'aria-current="page"':'' %>><%- include('icon',{name:'password'}) %>Change password</a><div class="sidebar-note"><span><%- include('icon',{name:'career'}) %></span><strong>Kemsor studio desk</strong><small>Content and operations</small></div></nav><% } %>
<main id="main"><% if(saved){ %><p class="notice" role="status">Saved successfully.</p><% } %>

<% for (const iconName of ['enquiries','page','team','career','settings','eye','eye-off']) { %><template data-admin-icon="<%= iconName %>"><%- adminIcon(iconName) %></template><% } %>
