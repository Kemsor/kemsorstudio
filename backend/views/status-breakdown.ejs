<% const groups=publishing?[
  {label:'Published',status:'published',tone:'blue'},
  {label:'Drafts',status:'draft',tone:'violet'},
  {label:'Archived',status:'archived',tone:'slate'}
]:[
  {label:'New',status:'new',tone:'blue'},
  {label:'In review',status:'in_review',tone:'violet'},
  {label:'Contacted',status:'contacted',tone:'mint'},
  {label:'Closed',status:'closed',tone:'slate'},
  {label:'Spam',status:'spam',tone:'rose'}
];
const source=publishing?counts:enquiryCounts;
groups.forEach(group=>group.value=source.filter(item=>item.status===group.status).reduce((total,item)=>total+Number(item.total),0));
const total=groups.reduce((sum,group)=>sum+group.value,0);let offset=0; %>
<section class="panel dashboard-panel breakdown-panel" aria-labelledby="breakdown-title">
  <div class="panel-heading"><div><p class="eyebrow">AT A GLANCE</p><h2 id="breakdown-title"><%= publishing?'Publishing overview':'Enquiry overview' %></h2></div><%- include('icon',{name:publishing?'page':'enquiries'}) %></div>
  <div class="breakdown-visual"><svg viewBox="0 0 160 160" role="img" aria-label="<%= groups.map(group=>group.label+': '+group.value).join(', ') %>"><circle class="donut-track" cx="80" cy="80" r="60" pathLength="100"/>
    <% groups.filter(group=>group.value).forEach(group=>{const share=group.value/total*100; %><circle class="donut-segment tone-<%= group.tone %>" cx="80" cy="80" r="60" pathLength="100" stroke-dasharray="<%= share %> <%= 100-share %>" stroke-dashoffset="<%= -offset %>" transform="rotate(-90 80 80)"/><% offset+=share; }) %>
    </svg><div><strong><%= total.toLocaleString('en-IN') %></strong><span><%= publishing?'content items':'enquiries' %></span></div></div>
  <ul class="breakdown-legend"><% groups.forEach(group=>{ %><li><span><i class="legend-dot tone-<%= group.tone %>" aria-hidden="true"></i><%= group.label %></span><strong><%= group.value %></strong></li><% }) %></ul>
  <a class="breakdown-link" href="<%= publishing?'/admin/content?type=all':'/admin/enquiries' %>">View <%= publishing?'all content':'enquiries' %><%- include('icon',{name:'external'}) %></a>
</section>
