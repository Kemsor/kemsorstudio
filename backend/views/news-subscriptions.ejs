<%- include('head') %><div class="heading-row"><div><p class="eyebrow">NEWSROOM</p><h1>News alert subscribers</h1><p>Only confirmed, active addresses are included in the mailing export. This screen does not send campaigns.</p></div><a class="button" href="/admin/newsletter/download.csv?status=active" download>Export active subscribers</a></div><form class="filters"><label>Status<select name="status"><option value="">All statuses</option><% ['pending','active','unsubscribed'].forEach(value=>{ %><option <%= state===value?'selected':'' %>><%= value %></option><% }) %></select></label><button>Filter</button></form><p>Showing the latest <%= subscriptions.length %> records, up to 1,000. Downloads use the same limit.</p><div class="table-wrap"><table><thead><tr><th>Email</th><th>Status</th><th>Topics</th><th>Consent</th></tr></thead><tbody><% subscriptions.forEach(record=>{ %><tr><td><%= record.email %></td><td><%= record.status %></td><td><%= (typeof record.topics==='string'?JSON.parse(record.topics):record.topics).join(', ') %></td><td><%= record.consent_at||'Awaiting confirmation' %></td></tr><% }) %></tbody></table></div><%- include('foot') %>
