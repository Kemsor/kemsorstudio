<%- include('head') %><div class="heading-row"><div><p class="eyebrow">WEBSITE ASSETS</p><h1>Media library</h1><p>Find reusable images, videos, documents and subtitles. Files used in content or saved history are protected from deletion.</p></div></div>
<details class="panel media-upload"><summary>Upload an image</summary><form action="/admin/media" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field-grid"><label>Image<input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/avif" required><small>Original photos are resized and compressed automatically.</small></label><label>Alternative text (optional)<input name="alt" maxlength="300"></label></div><button>Upload image</button></form></details>
<nav class="library-type-filters" aria-label="Media type"><% [['','All media'],['image','Images'],['video','Videos'],['document','Documents'],['captions','Subtitles']].forEach(([value,label])=>{ const query=new URLSearchParams({q:search,usage,kind:value}); %><a class="button quiet" href="/admin/media?<%= query %>" <%- kind===value?'aria-current="page"':'' %>><%= label %></a><% }); %></nav>
<form class="filters" method="get"><input type="hidden" name="kind" value="<%= kind %>"><label>Search<input name="q" value="<%= search %>" placeholder="File name or description" maxlength="100"></label><label>Format<select name="format"><option value="">All formats</option><% [['image/jpeg','JPEG'],['image/png','PNG'],['image/webp','WebP'],['image/avif','AVIF'],['video/mp4','MP4 video'],['application/pdf','PDF document'],['text/vtt','WebVTT subtitles']].filter(([value])=>!kind||(kind==='image'?value.startsWith('image/'):value===({video:'video/mp4',document:'application/pdf',captions:'text/vtt'})[kind])||value===format).forEach(([value,label])=>{ %><option value="<%= value %>" <%= format===value?'selected':'' %>><%= label %></option><% }); %></select></label><label>Usage<select name="usage"><option value="">All files</option><option value="used" <%= usage==='used'?'selected':'' %>>In use / preserved in history</option><option value="unused" <%= usage==='unused'?'selected':'' %>>Unused</option></select></label><button>Search</button><a class="button quiet" href="/admin/media">Reset</a></form>
<p><strong><%= media.length %></strong> matching <%= media.length===1?'file':'files' %></p>
<div class="library-grid"><% media.forEach(file=>{ %><article class="library-card" data-media-id="<%= file.id %>"><% if(file.mime.startsWith('image/')){ %><button type="button" class="library-thumbnail" data-image-preview="<%= file.url %>" data-image-title="<%= file.original_name %>" aria-label="Preview <%= file.original_name %>"><img src="<%= file.url %>" alt="<%= file.alt %>" loading="lazy" data-image-dimensions></button><% }else if(file.mime==='video/mp4'){ %><video class="library-video" controls playsinline preload="none" src="<%= file.url %>" aria-label="<%= file.alt||file.original_name %>"></video><% }else{ %><a class="library-file-link" href="<%= file.url %>" target="_blank" rel="noopener"><strong><%= file.mime==='application/pdf'?'PDF':'VTT' %></strong><span>Open file →</span></a><% } %>
<div class="library-card-copy"><h2><%= file.original_name %></h2><p><%= file.alt||'Description missing — add one below.' %></p><small><%= file.size>=1048576?(file.size/1048576).toFixed(1)+' MB':(file.size/1024).toFixed(1)+' KB' %> · <%= file.mime %><% if(file.mime.startsWith('image/')){ %> · <span data-dimensions>Dimensions loading</span><% } %></small>
<label>Reusable media URL<input readonly value="<%= file.url %>" aria-label="URL for <%= file.original_name %>"></label><button type="button" class="quiet" data-copy-media>Copy URL</button><span class="media-copy-feedback" role="status" data-copy-feedback></span>
<details class="media-usage-details"><summary><%= file.uses?'Where this file is used':'No references found' %></summary><% if(file.uses){ %><ul><% if(file.content_uses){ %><li><%= file.content_uses %> content <%= Number(file.content_uses)===1?'record':'records' %>, including banners and galleries</li><% } %><% if(file.people_uses){ %><li><%= file.people_uses %> person <%= Number(file.people_uses)===1?'profile':'profiles' %></li><% } %><% if(file.website_uses){ %><li>Website content, including drafts and published sections</li><% } %><% if(file.revision_uses){ %><li>Saved revision history</li><% } %></ul><p>Remove current references before deleting. Files retained in revision history stay protected.</p><% }else{ %><p>No current references were found. Deletion checks run again before a file is removed.</p><% } %></details>
<details class="media-description-editor"><summary>Edit description</summary><form method="post" action="/admin/media/<%= file.id %>/description"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><%= file.mime.startsWith('image/')?'Image description (optional)':'File description' %><input name="alt" value="<%= file.alt %>" <%= file.mime.startsWith('image/')?'':'required' %> maxlength="300"></label><p>Used wherever this file is reused.</p><button class="admin-save">Save description</button></form></details>
<div class="library-card-actions"><span class="badge"><%= file.uses?'In use / kept in history':'Unused' %></span><% if(!file.uses){ %><form action="/admin/media/<%= file.id %>/delete" method="post" data-confirm="Permanently delete this unused file?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="delete-blog">Delete</button></form><% } %></div></div></article><% }); %></div>
<% if(!media.length){ %><div class="dashboard-empty"><strong>No files match these filters.</strong><p>Try another search, choose a different file type, or reset the filters.</p><a class="button quiet" href="/admin/media">Reset media filters</a></div><% } %><%- include('image-preview') %><%- include('foot') %>
