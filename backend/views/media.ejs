<%- include('head') %>
<div class="heading-row"><div><p class="eyebrow">Website assets</p><h1>Image library</h1><p>Upload once, reuse across your posts.</p></div></div>
<details class="panel media-upload"><summary>Upload an image</summary><form action="/admin/media" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field-grid"><label>Image<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required><small>PNG, JPEG or WebP. Maximum 5 MB.</small></label><label>Alternative text<input name="alt" required maxlength="300" placeholder="Describe the image"></label></div><button>Upload image</button></form></details>
<form class="filters" method="get"><label>Search<input name="q" value="<%= search %>" placeholder="Filename or description" maxlength="100"></label><label>Format<select name="format"><option value="">All formats</option><% [['image/jpeg','JPEG'],['image/png','PNG'],['image/webp','WebP']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= format===value?'selected':'' %>><%= label %></option><% }); %></select></label><label>Usage<select name="usage"><option value="">All images</option><option value="used" <%= usage==='used'?'selected':'' %>>In use</option><option value="unused" <%= usage==='unused'?'selected':'' %>>Unused</option></select></label><button>Search</button><a class="button quiet" href="/admin/media">Reset</a></form>
<p class="muted"><%= media.length %> images</p><div class="library-grid"><% media.forEach(image=>{ %><article class="library-card"><button type="button" class="library-thumbnail" data-image-preview="/media/<%= image.id %>" data-image-title="<%= image.original_name %>" aria-label="Preview <%= image.original_name %>"><img src="/media/<%= image.id %>" alt="<%= image.alt %>" loading="lazy" data-image-dimensions></button><div class="library-card-copy"><h2><%= image.original_name %></h2><p><%= image.alt %></p><small><%= (image.size/1024).toFixed(1) %> KB · <%= image.mime.replace('image/','').toUpperCase() %> · <span data-dimensions>Dimensions loading</span></small><div class="library-card-actions"><span class="badge"><%= image.uses?'In use · '+image.uses:'Unused' %></span><% if(!image.uses){ %><form action="/admin/media/<%= image.id %>/delete" method="post" data-confirm="Permanently delete this unused image?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="delete-blog">Delete</button></form><% } %></div></div></article><% }); %></div><% if(!media.length){ %><p class="empty">No images match your search.</p><% } %>
<%- include('image-preview') %><%- include('foot') %>
