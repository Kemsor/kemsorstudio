<%- include('head') %><p class="eyebrow">ASSETS / STILL IMAGES</p><h1>Image library.</h1><form class="panel" action="/admin/media" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field-grid"><label>Image<input type="file" name="image" accept="image/jpeg,image/png,image/webp" required><small>PNG, JPEG or WebP. Maximum 5 MB. SVG and executable files are not accepted.</small></label><label>Alternative text<input name="alt" required maxlength="300"></label></div><button>Upload image ↑</button></form><div class="media-grid"><% media.forEach(image=>{ %><figure class="panel"><img src="/media/<%= image.id %>" alt="<%= image.alt %>" loading="lazy"><figcaption><strong><%= image.original_name %></strong><p><%= image.alt %></p><small><%= Math.round(image.size/1024) %> KB · Image #<%= image.id %></small></figcaption></figure><% }) %></div><%- include('foot') %>