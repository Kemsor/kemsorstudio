<%- include('head') %><div class="heading-row"><div><p class="eyebrow">WEBSITE ASSETS</p><h1>Media library</h1><p>Images, videos, PDF resources and subtitle files uploaded through the CMS. Upload videos and documents from their page editors, then reuse their URLs here.</p></div></div>
<details class="panel media-upload"><summary>Upload an image</summary><form action="/admin/media" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="field-grid"><label>Image<input type="file" name="image" accept="image/jpeg,image/png,image/webp,image/avif" required><small>Original photos are resized and compressed automatically.</small></label><label>Alternative text<input name="alt" required maxlength="300"></label></div><button>Upload image</button></form></details>
<form class="filters" method="get"><label>Search<input name="q" value="<%= search %>" maxlength="100"></label><label>Format<select name="format"><option value="">All media</option><% [['image/jpeg','JPEG'],['image/png','PNG'],['image/webp','WebP'],['video/mp4','MP4 video'],['application/pdf','PDF document'],['text/vtt','WebVTT subtitles']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= format===value?'selected':'' %>><%= label %></option><% }); %></select></label><label>Usage<select name="usage"><option value="">All files</option><option value="used" <%= usage==='used'?'selected':'' %>>In use / preserved in history</option><option value="unused" <%= usage==='unused'?'selected':'' %>>Unused</option></select></label><button>Search</button><a class="button quiet" href="/admin/media">Reset</a></form>
<p><%= media.length %> files</p><div class="library-grid"><% media.forEach(file=>{ %><article class="library-card"><% if(file.mime.startsWith('image/')){ %><button type="button" class="library-thumbnail" data-image-preview="<%= file.url %>" data-image-title="<%= file.original_name %>" aria-label="Preview <%= file.original_name %>"><img src="<%= file.url %>" alt="<%= file.alt %>" loading="lazy" data-image-dimensions></button><% }else if(file.mime==='video/mp4'){ %><video class="library-video" controls playsinline preload="none" src="<%= file.url %>" aria-label="<%= file.alt %>"></video><% }else{ %><a class="library-file-link" href="<%= file.url %>" target="_blank" rel="noopener"><strong><%= file.mime==='application/pdf'?'PDF':'VTT' %></strong><span>Open file ↗</span></a><% } %><div class="library-card-copy"><h2><%= file.original_name %></h2><p><%= file.alt %></p><small><%= (file.size/1024).toFixed(1) %> KB · <%= file.mime %><% if(file.mime.startsWith('image/')){ %> · <span data-dimensions>Dimensions loading</span><% } %></small><label>Reusable media URL<input readonly value="<%= file.url %>" aria-label="URL for <%= file.original_name %>"></label><div class="library-card-actions"><span class="badge"><%= file.uses?'In use / kept in history':'Unused' %></span><% if(!file.uses){ %><form action="/admin/media/<%= file.id %>/delete" method="post" data-confirm="Permanently delete this unused file?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="delete-blog">Delete</button></form><% } %></div></div></article><% }); %></div><% if(!media.length){ %><p class="empty">No files match these filters.</p><% } %><%- include('image-preview') %><%- include('foot') %>
