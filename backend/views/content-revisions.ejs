<%- include('head') %>
<div class="heading-row"><div><p class="eyebrow">PUBLISHING / RECOVERY</p><h1>Saved revisions</h1><p><%= entry.title %></p></div><a class="button quiet" href="/admin/content/<%= entry.id %>">Back to editor</a></div>
<p>Choose a saved version to compare with the latest. Restoring creates a new draft revision and keeps the current URL. History begins with the initial saved state captured when revision tracking was enabled.</p>
<% if(!selected){ %><p class="empty">No earlier saved versions are available yet. The next save will record a revision.</p><% }else{ %>
<form class="filters" method="get"><label>Saved version<select name="revision"><% revisions.forEach(item=>{ %><option value="<%= item.id %>" <%= selected.id===item.id?'selected':'' %>>Version <%= item.revision %> · <%= item.action.replaceAll('-',' ') %> · <%= item.editor||'Editor not recorded' %> · <%= item.created_at %> UTC</option><% }); %></select></label><button>Compare</button></form>
<div class="revision-compare-heading"><p><strong><%= comparison.filter(field=>field.changed).length %></strong> changed <%= comparison.filter(field=>field.changed).length===1?'field':'fields' %> between version <%= selected.revision %> and latest version <%= entry.revision %>.</p><label class="check"><input type="checkbox" data-revision-changes-only checked>Show changed fields only</label></div>
<div class="revision-comparison"><div class="revision-column-heading"><strong>Selected version <%= selected.revision %></strong><strong>Latest saved version <%= entry.revision %></strong></div>
<% comparison.forEach(field=>{ %><section class="revision-field <%= field.changed?'is-changed':'is-unchanged' %>" data-revision-field data-changed="<%= field.changed %>"><h2><%= field.label %><% if(field.changed){ %><span>Changed</span><% } %></h2><div class="revision-field-values"><div><span class="revision-mobile-label">Selected version</span><% if(field.key==='body'){ %><div class="preview-body"><%- revisionBody(previous) %></div><% }else if(field.key==='image_id'&&previous.image_id){ %><img src="/media/<%= previous.image_id %>" alt="Selected revision image"><p>Image #<%= previous.image_id %></p><% }else{ %><p class="pre-line"><%= field.before %></p><% } %></div><div><span class="revision-mobile-label">Latest saved version</span><% if(field.key==='body'){ %><div class="preview-body"><%- revisionBody(current) %></div><% }else if(field.key==='image_id'&&current.image_id){ %><img src="/media/<%= current.image_id %>" alt="Latest saved image"><p>Image #<%= current.image_id %></p><% }else{ %><p class="pre-line"><%= field.after %></p><% } %></div></div></section><% }); %></div>
<% if(!comparison.some(field=>field.changed)){ %><p class="empty">These versions have the same saved fields.</p><% } %>
<% if(Number(selected.revision)<Number(entry.revision)){ %><form class="panel revision-restore" method="post" action="/admin/content/<%= entry.id %>/revisions/restore"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="revision" value="<%= entry.revision %>"><input type="hidden" name="snapshot_id" value="<%= selected.id %>"><h2>Restore version <%= selected.revision %> as a draft</h2><p>This replaces the saved title, content, image and publishing details with the selected version. The current saved version stays in history.</p><label class="check"><input type="checkbox" name="confirm_restore" value="draft" required><%= entry.status==='published'?'I understand that restoring as a draft will hide this currently published item until I publish it again.':'Restore the selected saved fields as a draft for review.' %></label><button class="quiet">Restore as draft</button></form><% }else{ %><p class="form-help">Select an earlier saved version to restore it.</p><% } %>
<% } %>
<%- include('foot') %>
