<%- include('head') %><h1>Casting applications</h1><form method="get" class="filters"><label>Status<select name="status"><option value="">All</option><% states.forEach(state=>{ %><option <%= status===state?'selected':'' %>><%= state %></option><% }) %></select></label><label>Call ID<input name="call" type="number" min="1" value="<%= callId %>"></label><button>Filter</button></form><div class="table-wrap"><table><thead><tr><th>Applicant</th><th>Call / role</th><th>Status</th><th>Received</th><th>Review</th></tr></thead><tbody><% applications.forEach(application=>{ %><tr><td><%= application.name %><br><%= application.email %></td><td><%= application.call_title %><br><%= application.role_name %></td><td><%= application.status %></td><td><%= application.created_at %></td><td><a href="/admin/casting-applications/<%= application.id %>">Review application</a></td></tr><% }) %></tbody></table></div><% if(!applications.length){ %><p>No applications match these filters.</p><% } %><nav aria-label="Application pages"><% if(page>1){ %><a href="?status=<%= status %>&call=<%= callId %>&page=<%= page-1 %>">Previous</a><% } %> Page <%= page %> <% if(hasMore){ %><a href="?status=<%= status %>&call=<%= callId %>&page=<%= page+1 %>">Next</a><% } %></nav><%- include('foot') %>
