<div class="admin-filter-summary"><p><strong><%= table.total %></strong> <%= table.total===1?'matching record':'matching records' %></p><% if(table.activeFilters.length){ %><nav class="admin-active-filters" aria-label="Active filters"><% table.activeFilters.forEach(filter=>{ %><a href="<%= filter.removeLink %>" aria-label="Remove <%= filter.label.toLowerCase() %> filter: <%= filter.value %>"><span><%= filter.label %>: <%= filter.value %></span><span aria-hidden="true">×</span></a><% }); %><a class="admin-reset-filters" href="<%= table.resetLink %>">Clear filters</a></nav><% } %></div>
<div class="admin-table-tools" data-table-key="<%= table.key %>" data-table-user="<%= user.id %>">
<form class="table-view-controls" method="get"><% Object.entries(table.filters).forEach(([key,value])=>{if(value!==''){ %><input type="hidden" name="<%= key %>" value="<%= value %>"><% }}); %><input type="hidden" name="sort" value="<%= table.sort %>"><input type="hidden" name="dir" value="<%= table.dir %>"><label>Rows per page<select name="per_page"><% [25,50,100].forEach(size=>{ %><option value="<%= size %>" <%= table.limit===size?'selected':'' %>><%= size %></option><% }); %></select></label><button class="admin-standard-action quiet">Apply</button></form>
<div class="table-view-actions"><button type="button" class="admin-save quiet" data-save-table-view>Save view</button><button type="button" class="quiet" data-load-table-view disabled>Load saved view</button><span role="status" data-table-view-status></span></div>
</div>
<form id="table-bulk-form" class="table-bulk-form" action="/admin/tables/<%= resource %>/bulk" method="post" data-confirm="Apply this change to selected records?">
<input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="return_to" value="<%= table.link() %>"><span data-selection-count role="status">0 selected</span><label>Bulk action<select name="status" required><option value="">Choose an action</option><% actions.forEach(([value,label])=>{ %><option value="<%= value %>"><%= label %></option><% }); %></select></label><button class="admin-standard-action" data-bulk-submit disabled>Apply to selected</button><button type="button" class="admin-standard-action quiet" data-clear-selection disabled>Clear selection</button><small class="admin-selection-help" data-selection-help>Select records and choose an action to continue.</small>
</form>
