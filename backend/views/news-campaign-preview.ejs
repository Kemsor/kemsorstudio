<%- include('head') %><p class="eyebrow">CAMPAIGN REVIEW</p><h1><%= campaign.subject %></h1><p>Status: <strong><%= campaign.status %></strong> · <%= count %> currently eligible confirmed subscribers</p><section class="panel"><h2>Email preview</h2><p class="campaign-message"><%= campaign.message %></p><p><a href="<%= url %>" target="_blank" rel="noopener"><%= campaign.news_title %></a></p><p>Every delivery includes a personal unsubscribe link. Delivery eligibility is checked again before sending.</p></section><% if(campaign.status==='draft'){ %><form method="post" action="/admin/news-campaigns/<%= campaign.id %>/queue" class="panel"><input type="hidden" name="_csrf" value="<%= csrf %>"><label><input type="checkbox" name="confirm" value="queue" required>I have reviewed this campaign and its recipient topics. Queue it for delivery.</label><button>Queue reviewed campaign</button></form><% } %><% if(campaign.status!=='cancelled'){ %><form method="post" action="/admin/news-campaigns/<%= campaign.id %>/cancel" data-confirm="Stop pending deliveries? Messages already accepted by the email service cannot be recalled."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="quiet">Cancel pending deliveries</button></form><% } %><section class="panel"><h2>Delivery progress</h2><% results.forEach(result=>{ %><p><%= result.status %>: <%= result.total %></p><% }); %></section><a href="/admin/news-campaigns">All campaigns</a><%- include('foot') %>
