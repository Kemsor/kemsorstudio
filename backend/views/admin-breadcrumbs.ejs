<% const breadcrumbItems=user&&typeof adminBreadcrumbs==='function'?adminBreadcrumbs(locals):[]; if(breadcrumbItems.length){ %><nav class="admin-breadcrumbs" aria-label="Breadcrumb"><ol><% breadcrumbItems.forEach(item=>{ %><li><% if(item.href){ %><a href="<%= item.href %>"><%= item.label %></a><% }else{ %><span aria-current="page"><%= item.label %></span><% } %></li><% }); %></ol></nav><% } %>
