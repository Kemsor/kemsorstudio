<%- include('head') %><div class="heading-row"><div><p class="eyebrow">PUBLISHING</p><h1><%= types[type] || 'All content' %></h1></div><a class="button" href="/admin/content/new?type=<%= type==='all'?'news':type %>">Add content +</a></div><form class="filters" method="get"><input type="hidden" name="type" value="<%= type %>"><label>Search<input name="q" value="<%= search %>" maxlength="100"></label><label>Status<select name="status"><option value="">All</option><% ['draft','published','archived'].forEach(item=>{ %><option value="<%= item %>" <%= state===item?'selected':'' %>><%= item %></option><% }) %></select></label><button>Filter</button></form><div class="table-wrap"><table><thead><tr><th>Title</th><th>Status</th><th>Updated</th><th>Edit</th></tr></thead><tbody><% entries.forEach(entry=>{ %><tr><td><strong><%= entry.title %></strong><small><%= entry.slug %></small></td><td><span class="badge"><%= entry.status %></span></td><td><%= entry.updated_at %></td><td><a href="/admin/content/<%= entry.id %>">Open →</a></td></tr><% }) %></tbody></table></div><% if(!entries.length){ %><p class="empty">No matching content. Add a draft to begin.</p><% } %><%- include('foot') %>