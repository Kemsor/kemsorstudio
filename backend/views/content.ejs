<%- include('head') %><div class="heading-row"><div><p class="eyebrow">PUBLISHING</p><h1><%= types[type] || 'All content' %><% if(pageFilter){ %> / <%= pageFilter %><% } %></h1></div><a class="button" href="/admin/content/new?type=<%= type==='all'?'news':type %><%= pageFilter?'&page='+pageFilter:'' %>">Add content +</a></div><form class="filters" method="get"><input type="hidden" name="sort" value="<%= table.sort %>"><input type="hidden" name="dir" value="<%= table.dir %>"><input type="hidden" name="per_page" value="<%= table.limit %>"><input type="hidden" name="type" value="<%= type %>"><% if(pageFilter){ %><input type="hidden" name="page" value="<%= pageFilter %>"><% } %><label>Search<input name="q" value="<%= search %>" maxlength="100"></label><label>Status<select name="status"><option value="">All</option><% ['draft','published','archived'].forEach(item=>{ %><option value="<%= item %>" <%= state===item?'selected':'' %>><%= item %></option><% }) %></select></label><button>Filter</button></form><%- include('table-tools',{resource:'content',actions:[['draft','Move to draft'],['archived','Archive']]}) %><div class="table-wrap"><table><thead><tr><th class="table-selection-cell"><input type="checkbox" data-select-page aria-label="Select all rows on this page"></th><%- include('table-heading',{label:'Title',column:'title'}) %><%- include('table-heading',{label:'Status',column:'status'}) %><%- include('table-heading',{label:'Updated',column:'updated'}) %><th>Actions</th></tr></thead><tbody><% entries.forEach(entry=>{ %><tr><td class="table-selection-cell"><input type="checkbox" name="ids" value="<%= entry.id %>" form="table-bulk-form" data-row-select aria-label="Select record <%= entry.id %>"></td><td><strong><%= entry.title %></strong><small><%= entry.slug %></small></td><td><span class="badge badge-<%= entry.status %>"><%= entry.status %></span></td><td><%= entry.updated_at %></td><td><div class="content-row-actions"><a class="button quiet" href="/admin/content/<%= entry.id %>">Edit</a><a class="button quiet" href="/admin/content/<%= entry.id %>/preview">Preview</a><% if(entry.type==='blog'){ %><form action="/admin/content/<%= entry.id %>/delete" method="post" data-confirm="Delete this blog post permanently?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="delete-blog">Delete</button></form><% } %></div></td></tr><% }) %></tbody></table></div><% if(!entries.length){ %><p class="empty">No matching content. Add a draft to begin.</p><% } %><%- include('table-pagination') %><%- include('foot') %>