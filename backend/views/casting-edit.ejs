<%- include('head') %><p class="eyebrow">CASTING</p><h1><%= call.id?'Edit casting call':'Create casting call' %></h1><p>Link this call to a production and describe the roles clearly. Calls appear on the talent page after publishing. Talent can apply when casting application settings are enabled.</p>
<form action="/admin/casting/save" method="post" class="panel editor"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= call.id||'' %>"><div class="field-grid">
<label>Title<input name="title" maxlength="200" required value="<%= call.title||'' %>"></label><label>Production<select name="production_id" required><option value="">Choose production</option><% productions.forEach(p=>{ %><option value="<%= p.id %>" <%= p.id===call.production_id?'selected':'' %>><%= p.title %> · <%= p.status %></option><% }) %></select><small>The linked production must be published before this call can be published.</small></label>
<label class="wide">Summary<textarea name="summary" maxlength="2000" rows="3" required><%= call.summary||'' %></textarea></label><label>Location<input name="location" maxlength="200" required value="<%= call.location||'' %>"></label><label>Deadline<input name="deadline" type="date" required value="<%= call.deadline||'' %>"><small>Open through this date in India Standard Time. Calls close automatically after the deadline.</small></label>
<label class="wide">Roles and eligibility<textarea name="roles" rows="6" maxlength="35000" required placeholder="Lead performer | Hindi speaking; relevant screen experience"><%= call.roles.map(role=>role.name+' | '+role.eligibility).join('\n') %></textarea><small>One role per line: Role | Eligibility. Up to 50 roles. Include relevant skills and experience.</small></label>
<label class="wide">Requirements and audition details<textarea name="requirements" maxlength="10000" rows="7" required><%= call.requirements||'' %></textarea><small>Include project dates, preparation, compensation and other relevant requirements. Application settings require client-approved terms before public activation.</small></label>
<label>Call availability<select name="call_state"><% ['open','closed'].forEach(value=>{ %><option <%= call.call_state===value?'selected':'' %>><%= value %></option><% }) %></select><small>Close a call early without removing its published details.</small></label><label>Publishing status<select name="status"><% ['draft','published','archived'].forEach(value=>{ %><option <%= call.status===value?'selected':'' %>><%= value %></option><% }) %></select></label></div><button class="admin-save">Save casting call</button></form><p><% if(call.id){ %><a href="/admin/casting-applications?call=<%= call.id %>">Review applications for this call</a> · <% } %><a href="/admin/casting">Back to casting calls</a> · <a href="/find-talent/#casting-calls">View public casting board</a></p><%- include('foot') %>
