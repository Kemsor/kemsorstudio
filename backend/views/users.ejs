<%- include('head') %><p class="eyebrow">ACCESS CONTROL</p><h1>Users & roles.</h1>
<p>Assign access for each team member. Role or access changes sign that account out immediately. <a class="text-link" href="/admin/permissions">Review role permissions</a>.</p>
<p>Public artist, crew and hirer accounts are managed in <a class="text-link" href="/admin/talent">Registrations</a>.</p>
<div class="table-wrap"><table><thead><tr><th scope="col">User</th><th scope="col">Current role</th><th scope="col">Access</th><th scope="col">Manage access</th></tr></thead><tbody><% users.forEach(item=>{ %><tr><td><%= item.name %><small><%= item.email %></small></td><td><%= staffRoles[item.role] %></td><td><%= item.active?'Active':'Disabled' %></td><td><% if(item.id!==user.id){ %>
<form action="/admin/users/<%= item.id %>/access" method="post" class="staff-access-form">
<input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="previous_role" value="<%= item.role %>"><input type="hidden" name="previous_active" value="<%= item.active %>">
<label>Role for <%= item.name %><select name="role"><% Object.entries(staffRoles).forEach(([key,label])=>{ %><option value="<%= key %>" <%= item.role===key?'selected':'' %>><%= label %></option><% }) %></select></label>
<label>Account access for <%= item.name %><select name="active"><option value="1" <%= item.active?'selected':'' %>>Active</option><option value="0" <%= !item.active?'selected':'' %>>Disabled</option></select></label>
<button class="admin-save">Save access</button></form><% }else{ %><span>Your account</span><small>You cannot change your own role or disable your own access.</small><% } %></td></tr><% }) %></tbody></table></div>
<form action="/admin/users" method="post" class="panel"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Add a team member</h2><div class="field-grid"><label>Name<input name="name" required maxlength="100" autocomplete="name"></label><label>Email<input name="email" type="email" required maxlength="254" autocomplete="email"></label><label>Role<select name="role"><% ['editor','enquiry_manager','admin'].forEach(key=>{ %><option value="<%= key %>"><%= staffRoles[key] %></option><% }) %></select></label><label>Temporary password<input name="password" type="password" required minlength="12" maxlength="200" autocomplete="new-password"></label></div><button>Create user</button></form><%- include('foot') %>
