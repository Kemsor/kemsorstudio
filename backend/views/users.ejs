<%- include('head') %><p class="eyebrow">ACCESS CONTROL</p><h1>Users & roles.</h1><p>Admins manage all modules. Editors publish content and images. Enquiry managers handle the inbox and follow-up. Public artist, crew and hirer accounts are managed in <a class="text-link" href="/admin/talent">Registrations</a>.</p><div class="table-wrap"><table><thead><tr><th>User</th><th>Role</th><th>Access</th><th>Action</th></tr></thead><tbody><% users.forEach(item=>{ %><tr><td><%= item.name %><small><%= item.email %></small></td><td><%= item.role %></td><td><%= item.active?'Active':'Disabled' %></td><td><% if(item.id!==user.id){ %><form action="/admin/users/<%= item.id %>/toggle" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="quiet"><%= item.active?'Disable':'Enable' %></button></form><% } %></td></tr><% }) %></tbody></table></div><form action="/admin/users" method="post" class="panel"><input type="hidden" name="_csrf" value="<%= csrf %>"><h2>Add a team member</h2><div class="field-grid"><label>Name<input name="name" required maxlength="100" autocomplete="name"></label><label>Email<input name="email" type="email" required maxlength="254" autocomplete="email"></label><label>Role<select name="role"><option value="editor">Editor</option><option value="enquiry_manager">Enquiry manager</option><option value="admin">Administrator</option></select></label><label>Temporary password<input name="password" type="password" required minlength="12" maxlength="200" autocomplete="new-password"></label></div><button>Create user</button></form><%- include('foot') %>