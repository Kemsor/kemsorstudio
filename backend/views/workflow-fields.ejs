<input type="hidden" name="return_to" value="<%= returnTo %>">
<label>Assigned to<select name="assigned_to"><option value="">Unassigned</option><% users.forEach(person=>{ %><option value="<%= person.id %>" <%= Number(record.assigned_to)===Number(person.id)?'selected':'' %>><%= person.name %><%= person.active===0?' (inactive)':'' %></option><% }); %></select></label>
<label>Priority<select name="priority"><% ['low','normal','high','urgent'].forEach(value=>{ %><option value="<%= value %>" <%= record.priority===value?'selected':'' %>><%= value %></option><% }); %></select></label>
<label>Next action<input name="next_action" maxlength="500" value="<%= record.next_action||'' %>" placeholder="For example: arrange a call or review the portfolio"></label>
<label>Follow-up (UTC)<input type="datetime-local" name="follow_up_at" value="<%= record.follow_up_at?String(record.follow_up_at).replace(' ','T').slice(0,16):'' %>"></label>
