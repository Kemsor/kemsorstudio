<div class="table-pagination"><p>Showing <%= table.from %>–<%= table.to %> of <%= table.total %> · Page <%= table.page %> of <%= table.pages %></p><nav aria-label="Table pages"><% if(table.page>1){ %><a class="button quiet" href="<%= table.link({p:1}) %>">First</a><a class="button quiet" href="<%= table.link({p:table.page-1}) %>">Previous</a><% } %><% if(table.page<table.pages){ %><a class="button quiet" href="<%= table.link({p:table.page+1}) %>">Next</a><a class="button quiet" href="<%= table.link({p:table.pages}) %>">Last</a><% } %></nav></div>
