<div class="table-pagination"><p>Showing <%= table.from %>–<%= table.to %> of <%= table.total %> · Page <%= table.page %> of <%= table.pages %></p><nav aria-label="Table pages"><% if(table.page>1){ %><a class="button quiet" href="<%= table.link({p:table.page-1}) %>" rel="prev">Previous</a><% } %><% const pageNumbers=[...new Set([1,table.page-1,table.page,table.page+1,table.pages])].filter(page=>page>=1&&page<=table.pages).sort((a,b)=>a-b);pageNumbers.forEach((page,index)=>{ %><% if(index&&page-pageNumbers[index-1]>1){ %><span class="admin-pagination-gap" aria-hidden="true">…</span><% } %><a class="button quiet" href="<%= table.link({p:page}) %>" aria-label="Page <%= page %>" <%- page===table.page?'aria-current="page"':'' %>><%= page %></a><% }); %><% if(table.page<table.pages){ %><a class="button quiet" href="<%= table.link({p:table.page+1}) %>" rel="next">Next</a><% } %></nav></div>
