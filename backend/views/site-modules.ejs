<%- include('head') %><p class="eyebrow">WEBSITE CONTENT</p><h1>Existing page content</h1><p>Edit the copy, image placements, videos and navigation already used by the website. Supplied defaults remain in place until you publish changes. Layouts and form identifiers are preserved.</p><label>Find an area<input type="search" data-site-search placeholder="Search page names…"></label><div class="admin-page-grid"><% modules.forEach(([key,module])=>{const record=records.find(row=>row.module_key===key); %><a class="panel admin-page-card" data-site-search-item href="/admin/site-content/edit?key=<%= encodeURIComponent(key) %>"><small><%= module.area %></small><h2><%= module.label %></h2><p><%= module.fields.length %> controls · <%= record?.published?'Published overrides':record?'Draft / supplied defaults':'Supplied defaults' %></p><span>Edit existing content</span></a><% }); %></div><script src="/site-editor.js?v=1" defer></script><%- include('foot') %>
