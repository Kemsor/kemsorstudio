<div class="notification-items"><% if(!notifications.length){ %><div class="notification-empty"><span aria-hidden="true">✓</span><strong>You’re all caught up.</strong><p>New drafts and enquiries will appear here.</p></div><% } notifications.slice(0,limit).forEach(item=>{ %><article class="notification-item <%= item.read?'is-read':'is-unread' %>"><span class="notification-indicator tone-<%= item.tone %>" aria-hidden="true"><%- include('icon',{name:({enquiry:'enquiries',draft:'blog',talent:'team',application:'career',setup:'settings'})[item.key.split(':')[0]] || 'bell'}) %></span><div><a href="<%= item.href %>"><strong><%= item.title %></strong><span><%= item.text %></span></a><% if(item.date){ %><small><%= item.date %> UTC</small><% } %><% if(actions && !item.read){ %><form method="post" action="/admin/notifications/read"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="key" value="<%= item.key %>"><button class="notification-read">Mark as read</button></form><% } %></div><% if(!item.read){ %><span class="unread-dot" aria-label="Unread"></span><% } %></article><% }) %></div>
