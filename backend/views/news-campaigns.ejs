<%- include('head') %><p class="eyebrow">NEWSROOM DISTRIBUTION</p><h1>News campaigns</h1><p>Create a draft, preview it and review the confirmed subscriber count before queuing delivery. Saving a draft does not send emails.</p><form method="post" action="/admin/news-campaigns" class="panel"><input type="hidden" name="_csrf" value="<%= csrf %>"><label>Published story<select name="news_id" required><option value="">Choose a story</option><% news.forEach(item=>{ %><option value="<%= item.id %>"><%= item.title %></option><% }); %></select></label><label>Email subject<input name="subject" maxlength="200" required></label><label>Email message<textarea name="message" maxlength="10000" rows="8" required></textarea></label><fieldset><legend>Send to confirmed subscribers interested in</legend><% topics.forEach(topic=>{ %><label><input type="checkbox" name="topics" value="<%= topic %>"><%= topic %></label><% }); %></fieldset><button>Create draft and preview</button></form><section class="panel"><h2>Campaign history</h2><% campaigns.forEach(item=>{ %><p><a href="/admin/news-campaigns/<%= item.id %>"><%= item.subject %></a> · <%= item.status %> · <%= item.sent %> / <%= item.recipients %> accepted by email service</p><% }); %></section><%- include('foot') %>
