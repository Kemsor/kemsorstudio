NODE_ENV=development
HOST=127.0.0.1
PORT=8100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kemsor
DB_USER=root
DB_PASSWORD=
DB_MIGRATION_USER=root
DB_MIGRATION_PASSWORD=
DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
SESSION_SECRET=replace-with-at-least-32-random-characters
WEBSITE_URL=http://127.0.0.1:3007
TRUST_PROXY=false

# GoDaddy Node hosting uses EMAIL_TRANSPORT=godaddy and does not use SMTP.
# Local development can use smtp; email delivery stays disabled until configured.
EMAIL_TRANSPORT=smtp
EMAIL_ENABLED=true
# Optional local SMTP credentials; keep these in local .env only.
SMTP_ENABLED=false
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=info@kemsorstudio.com
SMTP_PASSWORD=

# Housekeeping runs hourly in the server; use cron/operations commands if the host sleeps.
OPERATIONS_ENABLED=true
# Keep disabled until KEMSOR approves both the retention period(s) and the policy version.
RETENTION_ENABLED=false
RETENTION_POLICY_VERSION=
RETENTION_ENQUIRY_DAYS=0
RETENTION_APPLICATION_DAYS=0

# Encrypted daily DB + weekly application/content backups. Enable only after setup and a recovery drill.
BACKUP_ENABLED=false
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=
BACKUP_RETENTION_DAYS=30
# Optional dedicated read-only dump account (otherwise uses DB_USER/DB_PASSWORD).
DB_BACKUP_USER=
DB_BACKUP_PASSWORD=
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql
TAR_BIN=tar
# Separate SSH storage; pin the host in known_hosts and use a restricted key.
BACKUP_REMOTE_HOST=
BACKUP_REMOTE_PORT=22
BACKUP_REMOTE_DIR=
BACKUP_SSH_KEY=
