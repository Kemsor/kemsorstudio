{
  "name": "kemsor-phase-one-cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "build": "echo \"No build step required\"",
    "start": "node --env-file-if-exists=.env src/server.js",
    "setup": "node --env-file=.env src/setup.js",
    "test": "node --env-file=.env --test tests/*.test.js",
    "export": "node --env-file=.env src/export.js",
    "operations": "node --env-file-if-exists=.env src/operations-cli.js",
    "check:browser": "node --env-file=.env scripts/browser-cms-check.mjs",
    "check:admin-ui": "node scripts/check-admin-experience.mjs",
    "check:publishing": "node scripts/check-publishing-tools.mjs",
    "check:workflow": "node scripts/check-follow-up-workflow.mjs",
    "check:publishing-safety": "node scripts/check-publishing-safety.mjs",
    "check:staff-access": "node scripts/check-staff-access.mjs",
    "check:audit-log": "node scripts/check-audit-log.mjs",
    "check:accessibility": "node scripts/check-admin-accessibility.mjs",
    "check:header": "node scripts/check-admin-header.mjs",
    "check:blog-categories": "node scripts/check-blog-categories.mjs",
    "check:filmdesk": "node scripts/check-filmdesk.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "lucide-static": "^1.62.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.2.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "supertest": "^7.3.1"
  }
}
